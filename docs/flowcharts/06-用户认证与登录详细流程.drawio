        <mxCell id="a10-new" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: users&lt;/b&gt;&#xa;插入新用户文档&#xa;返回 _id" vertex="1">
