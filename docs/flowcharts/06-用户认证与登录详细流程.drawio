        <mxCell id="a8" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: users&lt;/b&gt;&#xa;查询条件:&#xa;{openid: OPENID}" vertex="1">
          <mxGeometry height="70" width="130" x="630" y="1110" as="geometry" />
