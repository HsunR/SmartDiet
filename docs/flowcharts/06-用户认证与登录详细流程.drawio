        <mxCell id="a4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;wx.getUserProfile()&lt;/b&gt;&#xa;获取用户微信信息&#xa;(昵称、头像、性别)" vertex="1">
