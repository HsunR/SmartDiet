        <!-- 流程结束 -->
        <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontColor=#1565C0;fontStyle=1" value="结束&#xa;进入主界面" vertex="1">
