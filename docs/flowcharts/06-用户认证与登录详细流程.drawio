        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;读取本地缓存&lt;/b&gt;&#xa;wx.getStorageSync()&#xa;获取 userInfo" vertex="1">
          <mxGeometry height="60" width="140" x="580" y="670" as="geometry" />
