<mxfile host="app.diagrams.net" agent="SmartDiet">
  <diagram id="UserAuthFlow" name="用户认证与登录详细流程">
    <mxGraphModel dx="2000" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 图例 -->
        <mxCell id="legend-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#FFFFFF" value="图例说明" vertex="1">
          <mxGeometry height="30" width="140" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0" value="开始/结束" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-process" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="处理过程" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="135" as="geometry" />
        </mxCell>
        <mxCell id="legend-data" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="数据/输入" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="185" as="geometry" />
        </mxCell>
        <mxCell id="legend-decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="条件判断" vertex="1">
          <mxGeometry height="45" width="100" x="40" y="235" as="geometry" />
        </mxCell>
        <mxCell id="legend-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;fontColor=#6A1B9A" value="数据库" vertex="1">
          <mxGeometry height="40" width="100" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="legend-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="云函数/API" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="legend-dataflow" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2196F3;strokeWidth=2;startArrow=none;endArrow=block;endFill=1;fontColor=#2196F3" value="数据流">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="102" as="sourcePoint" />
            <mxPoint x="280" y="102" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-controlflow" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1;startArrow=none;endArrow=block;endFill=1;fontColor=#666666" value="控制流">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="152" as="sourcePoint" />
            <mxPoint x="280" y="152" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 流程标题 -->
        <mxCell id="flow-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#1976D2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1;fontColor=#FFFFFF" value="用户认证与登录详细流程" vertex="1">
          <mxGeometry height="50" width="400" x="400" y="40" as="geometry" />
        </mxCell>
        
        <!-- 数据体定义区域 -->
        <mxCell id="data-def-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#2E7D32" value="【关键数据结构定义】" vertex="1">
          <mxGeometry height="30" width="500" x="900" y="40" as="geometry" />
        </mxCell>
        
        <mxCell id="data-user" parent="1" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E7D32;spacingLeft=10;spacingTop=5" value="&lt;b&gt;User 用户数据结构 (users 集合)&lt;/b&gt;&#xa;{&#xa;  _id: string,              // 文档唯一ID&#xa;  openid: string,           // 微信用户唯一标识&#xa;  nickname: string,         // 用户昵称&#xa;  avatar: string,           // 头像URL&#xa;  gender: number (0/1/2),   // 性别: 0-未知, 1-男, 2-女&#xa;  age: number,              // 年龄 (默认25)&#xa;  height: number,           // 身高cm (默认170)&#xa;  weight: number,           // 体重kg (默认65)&#xa;  activityLevel: number,    // 活动水平 1-5 (默认3)&#xa;  goal: string,             // 目标: lose_weight/maintain/gain_muscle&#xa;  preferences: array,       // 饮食偏好[]&#xa;  allergies: array,         // 过敏食物[]&#xa;  createdAt: timestamp,     // 创建时间&#xa;  updatedAt: timestamp      // 更新时间&#xa;}" vertex="1">
          <mxGeometry height="280" width="320" x="900" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-login-req" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=10;spacingTop=5" value="&lt;b&gt;LoginRequest 登录请求数据&lt;/b&gt;&#xa;{&#xa;  action: 'login',&#xa;  userInfo: {&#xa;    nickName: string,&#xa;    avatarUrl: string,&#xa;    gender: number&#xa;  }&#xa;}&#xa;&#xa;&lt;b&gt;LoginResponse 登录响应数据&lt;/b&gt;&#xa;{&#xa;  success: boolean,&#xa;  data: User,&#xa;  isNewUser: boolean,&#xa;  message: string&#xa;}" vertex="1">
          <mxGeometry height="200" width="240" x="1250" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-storage" parent="1" style="text;html=1;strokeColor=#6A1B9A;fillColor=#E1BEE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#6A1B9A;spacingLeft=10;spacingTop=5" value="&lt;b&gt;LocalStorage 本地存储键&lt;/b&gt;&#xa;{&#xa;  'userInfo': User,                    // 用户信息缓存&#xa;  'hasLogin': boolean,                 // 登录状态标记&#xa;  'hasCompletedOnboarding': boolean,   // 引导完成标记&#xa;  'chat_messages': array,              // 聊天消息历史&#xa;  'settings': object                   // 用户设置&#xa;}&#xa;&#xa;&lt;b&gt;GlobalData 全局数据&lt;/b&gt;&#xa;{&#xa;  hasLogin: boolean,&#xa;  userInfo: User,&#xa;  pendingRecord: object | null&#xa;}" vertex="1">
          <mxGeometry height="200" width="280" x="900" y="390" as="geometry" />
        </mxCell>
        
        <!-- 流程开始 -->
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontColor=#1565C0;fontStyle=1" value="开始&#xa;用户打开小程序" vertex="1">
          <mxGeometry height="50" width="120" x="400" y="120" as="geometry" />
        </mxCell>
        
        <!-- 步骤1: 小程序初始化 -->
        <mxCell id="step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;app.onLaunch()&lt;/b&gt;&#xa;小程序生命周期初始化" vertex="1">
          <mxGeometry height="50" width="160" x="380" y="210" as="geometry" />
        </mxCell>
        
        <!-- 步骤2: 云环境初始化 -->
        <mxCell id="step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;wx.cloud.init()&lt;/b&gt;&#xa;初始化微信云开发环境&#xa;env: cloud1-5g94ikff8709bdba" vertex="1">
          <mxGeometry height="60" width="180" x="370" y="300" as="geometry" />
        </mxCell>
        
        <!-- 步骤3: 检查登录状态 -->
        <mxCell id="step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;checkLoginStatus()&lt;/b&gt;&#xa;读取本地存储检查登录状态&#xa;wx.getStorageSync('hasLogin')" vertex="1">
          <mxGeometry height="60" width="180" x="370" y="400" as="geometry" />
        </mxCell>
        
        <!-- 判断1: 是否已登录 -->
        <mxCell id="decision1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="本地存储中&#xa;存在登录标记?" vertex="1">
          <mxGeometry height="70" width="130" x="395" y="500" as="geometry" />
        </mxCell>
        
        <!-- 分支A: 未登录流程 -->
        <mxCell id="branch-a-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFEBEE;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#C62828" value="【分支A: 未登录/首次使用流程】" vertex="1">
