        <!-- 判断2: 是否新用户 -->
        <mxCell id="decision2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="用户&#xa;是否存在?" vertex="1">
