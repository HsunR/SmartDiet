        <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;恢复全局状态&lt;/b&gt;&#xa;app.globalData = {&#xa;  hasLogin: true,&#xa;  userInfo: cachedUser&#xa;}" vertex="1">
          <mxGeometry height="70" width="140" x="580" y="760" as="geometry" />
        </mxCell>
        
        <!-- 判断3: 资料完整性检查 -->
        <mxCell id="decision3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="用户资料&#xa;是否完整?&#xa;(age/height/weight)" vertex="1">
