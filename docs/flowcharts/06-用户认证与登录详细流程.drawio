        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="&lt;b&gt;页面跳转&lt;/b&gt;&#xa;wx.redirectTo()&#xa;/pages/login/index" vertex="1">
