        <mxCell id="a13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;设置全局状态&lt;/b&gt;&#xa;app.globalData = {&#xa;  hasLogin: true,&#xa;  userInfo: User&#xa;}" vertex="1">
