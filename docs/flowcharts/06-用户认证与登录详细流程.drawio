        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;login.onLoad()&lt;/b&gt;&#xa;登录页初始化&#xa;显示授权按钮" vertex="1">
          <mxGeometry height="60" width="140" x="255" y="760" as="geometry" />
