        <mxCell id="a6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;云函数调用&lt;/b&gt;&#xa;cloudFunction: user&#xa;action: login&#xa;data: {userInfo}" vertex="1">
          <mxGeometry height="70" width="140" x="255" y="1110" as="geometry" />
        </mxCell>
        
        <mxCell id="a7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;云函数: user/login&lt;/b&gt;&#xa;1. 获取 OPENID&#xa;2. 查询 users 集合&#xa;3. 判断用户是否存在" vertex="1">
          <mxGeometry height="70" width="160" x="430" y="1110" as="geometry" />
