        <mxCell id="a3" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户交互&lt;/b&gt;&#xa;点击微信授权按钮&#xa;触发登录流程" vertex="1">
