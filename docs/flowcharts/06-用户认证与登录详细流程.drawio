        <mxCell id="a12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;保存登录状态&lt;/b&gt;&#xa;wx.setStorageSync()&#xa;hasLogin: true&#xa;userInfo: User" vertex="1">
