        <!-- 调用更新API -->
        <mxCell id="callUpdate" value="调用更新API&lt;br/&gt;api.user.updateProfile(profile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="820" width="160" height="60" as="geometry" />
        </mxCell>
        
        <!-- 云函数更新 -->
        <mxCell id="cloudUpdate" value="云函数：user.updateProfile&lt;br/&gt;db.collection('users')&lt;br/&gt;.where({openid})&lt;br/&gt;.update({data: profile})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="810" width="180" height="80" as="geometry" />
        </mxCell>
        
        <!-- 更新全局状态 -->
        <mxCell id="updateGlobal" value="更新全局状态&lt;br/&gt;app.globalData.userInfo&lt;br/&gt;本地存储缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="920" width="160" height="60" as="geometry" />
        </mxCell>
        
        <!-- 判断是否引导流程 -->
        <mxCell id="isOnboarding" value="是否引导流程?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="700" y="1010" width="120" height="80" as="geometry" />
        </mxCell>
        
        <!-- 跳转聊天页 -->
        <mxCell id="gotoChat" value="跳转至聊天页&lt;br/&gt;wx.switchTab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="550" y="1020" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- 显示成功提示 -->
        <mxCell id="showSuccess" value="显示保存成功&lt;br/&gt;Toast提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="900" y="1020" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- 结束节点 -->
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="720" y="1130" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- 数据结构 -->
        <mxCell id="dataTitle" value="Profile 数据结构" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="dataBox" value="&lt;b&gt;Profile 对象&lt;/b&gt;&lt;br/&gt;{&lt;br/&gt;  gender: Number (1=男, 2=女),&lt;br/&gt;  age: Number (10-100),&lt;br/&gt;  height: Number (cm),&lt;br/&gt;  weight: Number (kg),&lt;br/&gt;  activityLevel: Number (1-5),&lt;br/&gt;  goal: String ('lose_weight'|'maintain'|'gain_muscle')&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Targets 对象(计算结果)&lt;/b&gt;&lt;br/&gt;{&lt;br/&gt;  calories: Number (目标热量kcal),&lt;br/&gt;  protein: Number (蛋白质g),&lt;br/&gt;  fat: Number (脂肪g),&lt;br/&gt;  carbohydrate: Number (碳水g)&lt;br/&gt;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="320" height="280" as="geometry" />
        </mxCell>
        
        <!-- 活动水平选项 -->
        <mxCell id="activityTitle" value="活动水平选项" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="activityBox" value="1. 久坐 (1.2) - 几乎不运动&lt;br/&gt;2. 轻度活动 (1.375) - 每周1-2次&lt;br/&gt;3. 中度活动 (1.55) - 每周3-4次&lt;br/&gt;4. 活跃 (1.725) - 每周5-6次&lt;br/&gt;5. 非常活跃 (1.9) - 每天运动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="460" width="280" height="100" as="geometry" />
        </mxCell>
        
        <!-- 健康目标选项 -->
        <mxCell id="goalTitle" value="健康目标选项" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="goalBox" value="• lose_weight: 减脂 (TDEE * 0.8)&lt;br/&gt;• maintain: 维持 (TDEE)&lt;br/&gt;• gain_muscle: 增肌 (TDEE * 1.15)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="620" width="280" height="80" as="geometry" />
        </mxCell>
        
        <!-- 计算公式 -->
        <mxCell id="formulaTitle" value="营养计算公式" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="720" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="formulaBox" value="&lt;b&gt;BMR (基础代谢率)&lt;/b&gt;&lt;br/&gt;男: 10*weight + 6.25*height - 5*age + 5&lt;br/&gt;女: 10*weight + 6.25*height - 5*age - 161&lt;br/&gt;&lt;br/&gt;&lt;b&gt;TDEE (每日总消耗)&lt;/b&gt;&lt;br/&gt;TDEE = BMR * activityLevel&lt;br/&gt;&lt;br/&gt;&lt;b&gt;目标热量&lt;/b&gt;&lt;br/&gt;减脂: TDEE * 0.8&lt;br/&gt;维持: TDEE&lt;br/&gt;增肌: TDEE * 1.15&lt;br/&gt;&lt;br/&gt;&lt;b&gt;三大营养素分配&lt;/b&gt;&lt;br/&gt;减脂: 蛋白质30% 脂肪25% 碳水45%&lt;br/&gt;维持: 蛋白质25% 脂肪25% 碳水50%&lt;br/&gt;增肌: 蛋白质30% 脂肪20% 碳水50%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="760" width="320" height="280" as="geometry" />
        </mxCell>
        
        <!-- 示例数据交互 -->
        <mxCell id="exampleTitle" value="示例数据交互" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="1060" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="exampleBox" value="&lt;b&gt;【场景】用户在个人中心更新档案&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. 用户输入数据&lt;/b&gt;&lt;br/&gt;{&lt;br/&gt;  gender: 1（男）,&lt;br/&gt;  age: 28,&lt;br/&gt;  height: 175,&lt;br/&gt;  weight: 70,&lt;br/&gt;  activityLevel: 3（中度活动）,&lt;br/&gt;  goal: 'lose_weight'（减脂）&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. 数据验证过程&lt;/b&gt;&lt;br/&gt;• 必填检查: 全部通过&lt;br/&gt;• 范围检查: age(28)∈[10,100] ✓, height(175)∈[100,250] ✓, weight(70)∈[30,200] ✓&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. 营养目标计算过程&lt;/b&gt;&lt;br/&gt;• BMR = 10×70 + 6.25×175 - 5×28 + 5 = 1,668.75 kcal&lt;br/&gt;• TDEE = 1,668.75 × 1.55 = 2,586.56 kcal&lt;br/&gt;• 目标热量 = 2,586.56 × 0.8 = 2,069.25 kcal（减脂）&lt;br/&gt;• 蛋白质 = 2,069.25 × 0.30 ÷ 4 = 155.2g&lt;br/&gt;• 脂肪 = 2,069.25 × 0.25 ÷ 9 = 57.5g&lt;br/&gt;• 碳水 = 2,069.25 × 0.45 ÷ 4 = 232.8g&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4. 调用更新API&lt;/b&gt;&lt;br/&gt;请求: cloud.callFunction('user', {&lt;br/&gt;  action: 'updateProfile',&lt;br/&gt;  data: {profile: {...}, targets: {calories:2069, protein:155, fat:58, carb:233}}&lt;br/&gt;})&lt;br/&gt;&lt;br/&gt;&lt;b&gt;5. 云函数响应&lt;/b&gt;&lt;br/&gt;{success: true, message: '更新成功'}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;6. 前端处理结果&lt;/b&gt;&lt;br/&gt;• app.globalData.userInfo 更新&lt;br/&gt;• 本地缓存写入&lt;br/&gt;• 显示Toast: '保存成功'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4f8;strokeColor=#4a90e2;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="1100" width="420" height="420" as="geometry" />
        </mxCell>
        
