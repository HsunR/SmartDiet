        <!-- 显示引导步骤 -->
        <mxCell id="showSteps" value="显示分步引导界面&lt;br/&gt;- 性别选择&lt;br/&gt;- 年龄输入(10-100岁)&lt;br/&gt;- 身高输入(100-250cm)&lt;br/&gt;- 体重输入(30-200kg)&lt;br/&gt;- 活动水平选择(1-5)&lt;br/&gt;- 健康目标选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="160" height="140" as="geometry" />
        </mxCell>
        
        <!-- 显示编辑界面 -->
        <mxCell id="showEdit" value="显示档案编辑界面&lt;br/&gt;- 显示当前所有字段值&lt;br/&gt;- 支持单项编辑&lt;br/&gt;- 实时计算营养目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="930" y="280" width="160" height="100" as="geometry" />
