        <!-- 计算营养目标 -->
        <mxCell id="calcTargets" value="计算营养目标&lt;br/&gt;calculateNutrientTargets()&lt;br/&gt;&lt;br/&gt;1. 计算BMR(基础代谢)&lt;br/&gt;2. 计算TDEE(每日消耗)&lt;br/&gt;3. 根据目标调整热量&lt;br/&gt;4. 计算三大营养素分配" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="660" y="650" width="200" height="140" as="geometry" />
