        <!-- 保存记录流程节点 -->
        <mxCell id="f3-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0;fontStyle=1" value="开始&#xa;用户确认保存" vertex="1">
