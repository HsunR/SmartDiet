        <!-- 数据体: 进度更新 -->
        <mxCell id="f3-data-progress" parent="1" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;数据体: 进度更新&lt;/b&gt;&#xa;今日累计:&#xa;{&#xa;  totalCalories: 1850,&#xa;  targetCalories: 2000,&#xa;  progress: 92.5%,&#xa;  remaining: 150&#xa;}&#xa;&#xa;UI显示: 进度条更新" vertex="1">
