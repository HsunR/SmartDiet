        <!-- 数据体: 数据库写入 -->
        <mxCell id="f3-data-db" parent="1" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;数据体: 数据库写入&lt;/b&gt;&#xa;db.collection('food_records')&#xa;  .add({&#xa;    data: {&#xa;      _openid: 'oABC123...',&#xa;      date: '2026-04-26',&#xa;      mealType: 'lunch',&#xa;      foods: [...],&#xa;      totalCalories: 650,&#xa;      rating: 4,&#xa;      createdAt: Date.now()&#xa;    }&#xa;  })&#xa;→ _id: 'record_abc123'" vertex="1">
          <mxGeometry x="1000" y="870" width="180" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="f3-success" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;返回成功&lt;/b&gt;&#xa;{success: true,&#xa; data: {_id, ...}}" vertex="1">
          <mxGeometry x="840" y="1020" width="140" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="f3-updateui" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;updateDailyProgress()&lt;/b&gt;&#xa;更新今日卡路里进度" vertex="1">
          <mxGeometry x="840" y="1110" width="140" height="50" as="geometry" />
