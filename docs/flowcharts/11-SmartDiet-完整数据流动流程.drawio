        <mxCell id="f3-cache" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;清除相关缓存&lt;/b&gt;&#xa;report_cache, history_cache" vertex="1">
          <mxGeometry x="840" y="1270" width="140" height="50" as="geometry" />
