        </mxCell>
        <mxCell id="f3-e11" edge="1" parent="1" source="f3-refresh" target="f3-cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3-e12" edge="1" parent="1" source="f3-cache" target="f3-end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- ==================== 接口定义区域 ==================== -->
        <mxCell id="api-section-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#F57F17;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#FFFFFF" value="【核心接口定义】" vertex="1">
          <mxGeometry x="1100" y="750" width="600" height="35" as="geometry" />
        </mxCell>
        
        <!-- 云函数接口 -->
        <mxCell id="api-cloud" parent="1" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E7D32;spacingLeft=10;spacingTop=5" value="&lt;b&gt;云函数: user&lt;/b&gt;&#xa;├── action: 'login'&#xa;│   └── 输入: {nickname, avatar, gender}&#xa;│   └── 输出: {success, data: {openid, ...userData, isNewUser}}&#xa;├── action: 'getProfile'&#xa;│   └── 输入: {}&#xa;│   └── 输出: {success, data: userProfile}&#xa;└── action: 'updateProfile'&#xa;    └── 输入: {age, height, weight, activityLevel, goal}&#xa;    └── 输出: {success, message}&#xa;&#xa;&lt;b&gt;云函数: foodRecord&lt;/b&gt;&#xa;├── action: 'add'&#xa;│   └── 输入: {date, mealType, foods[], rating, imageUrl, totalCalories}&#xa;│   └── 输出: {success, data: {_id, ...record}}&#xa;├── action: 'getByDate'&#xa;│   └── 输入: {date}&#xa;│   └── 输出: {success, data: records[]}&#xa;├── action: 'getHistory'&#xa;│   └── 输入: {startDate, endDate}&#xa;│   └── 输出: {success, data: records[]}&#xa;├── action: 'update'&#xa;│   └── 输入: {recordId, ...updates}&#xa;│   └── 输出: {success, message}&#xa;└── action: 'delete'&#xa;    └── 输入: {recordId}&#xa;    └── 输出: {success, message}" vertex="1">
          <mxGeometry x="1100" y="800" width="280" height="320" as="geometry" />
        </mxCell>
        
        <!-- AI网关接口 -->
        <mxCell id="api-ai" parent="1" style="text;html=1;strokeColor=#1976D2;fillColor=#BBDEFB;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1976D2;spacingLeft=10;spacingTop=5" value="&lt;b&gt;云函数: aiGateway&lt;/b&gt;&#xa;&#xa;&lt;b&gt;action: 'foodRecognition'&lt;/b&gt;&#xa;输入:&#xa;{&#xa;  imageUrl: string,          // 图片URL&#xa;  userProfile: {              // 用户档案&#xa;    age, weight, goal&#xa;  },&#xa;  userFeedback: string | null // 用户反馈&#xa;}&#xa;&#xa;输出:&#xa;{&#xa;  success: boolean,&#xa;  summary: {&#xa;    calories: number,&#xa;    score: number (0-100),&#xa;    tags: {good: [], warn: []}&#xa;  },&#xa;  items: [{&#xa;    name, category, calories,&#xa;    weight: {val, conf},&#xa;    tags, advice&#xa;  }]&#xa;}&#xa;&#xa;&lt;b&gt;action: 'chat'&lt;/b&gt;&#xa;输入:&#xa;{&#xa;  message: string,            // 用户消息&#xa;  context: {&#xa;    messages: Message[]       // 历史消息&#xa;  }&#xa;}&#xa;&#xa;输出:&#xa;{&#xa;  success: boolean,&#xa;  data: {&#xa;    reply: string             // AI回复&#xa;  }&#xa;}" vertex="1">
          <mxGeometry x="1400" y="800" width="280" height="320" as="geometry" />
        </mxCell>
        
        <!-- 前端API封装 -->
        <mxCell id="api-frontend" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=10;spacingTop=5" value="&lt;b&gt;前端API封装 (utils/api.js)&lt;/b&gt;&#xa;&#xa;&lt;b&gt;api.user&lt;/b&gt;&#xa;├── login(userInfo)&#xa;├── getProfile()&#xa;└── updateProfile(profile)&#xa;&#xa;&lt;b&gt;api.food&lt;/b&gt;&#xa;├── recognize(imageUrl, userFeedback?)&#xa;├── recognizeWithFeedback(imageUrl, feedback)&#xa;├── addRecord(record)&#xa;├── getRecords(date)&#xa;├── getHistory(startDate, endDate)&#xa;├── updateRecord(recordId, data)&#xa;└── deleteRecord(recordId)&#xa;&#xa;&lt;b&gt;api.chat&lt;/b&gt;&#xa;└── send(message, context)&#xa;&#xa;&lt;b&gt;工具函数 (utils/helpers.js)&lt;/b&gt;&#xa;├── calculateTotalCalories(foods[])&#xa;├── groupByDate(records[])&#xa;├── filterByMealType(records[], type)&#xa;├── formatDate(date)&#xa;└── generateId()" vertex="1">
          <mxGeometry x="1700" y="800" width="280" height="320" as="geometry" />
        </mxCell>
        
        <!-- ==================== 异常处理区域 ==================== -->
        <mxCell id="exception-section-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#C62828;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#FFFFFF" value="【异常处理路径】" vertex="1">
          <mxGeometry x="1100" y="1150" width="600" height="35" as="geometry" />
        </mxCell>
        
        <!-- 登录异常 -->
        <mxCell id="exc-login" parent="1" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#C62828;spacingLeft=5;spacingTop=3" value="&lt;b&gt;登录异常处理&lt;/b&gt;&#xa;&#xa;&lt;b&gt;1. 云环境初始化失败&lt;/b&gt;&#xa;   - 检测: !wx.cloud&#xa;   - 处理: 显示错误提示&#xa;   - 提示: '请更新微信版本'&#xa;&#xa;&lt;b&gt;2. 用户拒绝授权&lt;/b&gt;&#xa;   - 检测: err.errMsg.includes('auth deny')&#xa;   - 处理: 静默处理，允许重试&#xa;   - 提示: 无强制提示&#xa;&#xa;&lt;b&gt;3. 云函数调用失败&lt;/b&gt;&#xa;   - 检测: result.errCode !== 0&#xa;   - 处理: 显示错误信息&#xa;   - 提示: '登录失败，请重试'&#xa;&#xa;&lt;b&gt;4. 数据库操作失败&lt;/b&gt;&#xa;   - 检测: catch error&#xa;   - 处理: 记录日志，返回错误&#xa;   - 提示: '系统错误，请稍后重试'" vertex="1">
          <mxGeometry x="1100" y="1200" width="280" height="250" as="geometry" />
        </mxCell>
        
        <!-- 食物识别异常 -->
        <mxCell id="exc-food" parent="1" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#C62828;spacingLeft=5;spacingTop=3" value="&lt;b&gt;食物识别异常处理&lt;/b&gt;&#xa;&#xa;&lt;b&gt;1. 图片选择取消&lt;/b&gt;&#xa;   - 检测: err.errMsg.includes('cancel')&#xa;   - 处理: 静默处理&#xa;   - 提示: 无&#xa;&#xa;&lt;b&gt;2. 图片上传失败&lt;/b&gt;&#xa;   - 检测: uploadFile返回错误&#xa;   - 处理: 提示网络错误&#xa;   - 提示: '图片上传失败，请检查网络'&#xa;&#xa;&lt;b&gt;3. AI识别超时&lt;/b&gt;&#xa;   - 检测: timeout (30s)&#xa;   - 处理: 显示超时提示&#xa;   - 提示: '识别超时，请重试'&#xa;&#xa;&lt;b&gt;4. AI响应解析失败&lt;/b&gt;&#xa;   - 检测: JSON.parse失败&#xa;   - 处理: 返回原始内容&#xa;   - 提示: '识别结果格式错误'&#xa;&#xa;&lt;b&gt;5. 识别结果为空&lt;/b&gt;&#xa;   - 检测: !result.items || items.length === 0&#xa;   - 处理: 提示重新拍照&#xa;   - 提示: '未识别到食物，请重新拍照'" vertex="1">
          <mxGeometry x="1400" y="1200" width="280" height="280" as="geometry" />
        </mxCell>
        
        <!-- 记录操作异常 -->
        <mxCell id="exc-record" parent="1" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#C62828;spacingLeft=5;spacingTop=3" value="&lt;b&gt;记录操作异常处理&lt;/b&gt;&#xa;&#xa;&lt;b&gt;1. 数据验证失败&lt;/b&gt;&#xa;   - 检测: !date || !mealType || !foods&#xa;   - 处理: 返回具体错误字段&#xa;   - 提示: '请完善记录信息'&#xa;&#xa;&lt;b&gt;2. 数据库写入失败&lt;/b&gt;&#xa;   - 检测: db.add()抛出异常&#xa;   - 处理: 记录错误日志&#xa;   - 提示: '保存失败，请重试'&#xa;&#xa;&lt;b&gt;3. 权限验证失败&lt;/b&gt;&#xa;   - 检测: _openid不匹配&#xa;   - 处理: 返回403错误&#xa;   - 提示: '无权操作此记录'&#xa;&#xa;&lt;b&gt;4. 记录不存在&lt;/b&gt;&#xa;   - 检测: update/delete时记录不存在&#xa;   - 处理: 返回404错误&#xa;   - 提示: '记录不存在或已删除'&#xa;&#xa;&lt;b&gt;5. 缓存操作异常&lt;/b&gt;&#xa;   - 检测: Storage操作失败&#xa;   - 处理: 不影响主流程&#xa;   - 提示: 无" vertex="1">
          <mxGeometry x="1700" y="1200" width="280" height="280" as="geometry" />
        </mxCell>
        
        <!-- ==================== 常量定义区域 ==================== -->
        <mxCell id="const-section-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E65100;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#FFFFFF" value="【系统常量定义】" vertex="1">
          <mxGeometry x="2000" y="450" width="600" height="35" as="geometry" />
        </mxCell>
        
        <!-- 消息类型常量 -->
        <mxCell id="const-msg" parent="1" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#E65100;spacingLeft=5;spacingTop=3" value="&lt;b&gt;MESSAGE_TYPES 消息类型&lt;/b&gt;&#xa;{&#xa;  TEXT: 'text',                  // 文本消息&#xa;  IMAGE: 'image',                // 图片消息&#xa;  FOOD_CARD: 'food_card',        // 食物卡片&#xa;  USER_INFO_FORM: 'user_info_form',&#xa;  FEEDBACK_INPUT: 'feedback_input',&#xa;  QUICK_ACTIONS: 'quick_actions',&#xa;  DATE_SELECT: 'date_select',&#xa;  MEAL_TYPE_SELECT: 'meal_type_select',&#xa;  RATING_SELECT: 'rating_select'&#xa;}&#xa;&#xa;&lt;b&gt;MESSAGE_ROLES 消息角色&lt;/b&gt;&#xa;{&#xa;  USER: 'user',                  // 用户&#xa;  ASSISTANT: 'assistant'         // AI助手&#xa;}" vertex="1">
          <mxGeometry x="2000" y="500" width="280" height="220" as="geometry" />
        </mxCell>
        
        <!-- 餐次类型常量 -->
        <mxCell id="const-meal" parent="1" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#E65100;spacingLeft=5;spacingTop=3" value="&lt;b&gt;MEAL_TYPES 餐次类型&lt;/b&gt;&#xa;{&#xa;  BREAKFAST: 'breakfast',        // 早餐&#xa;  LUNCH: 'lunch',                // 午餐&#xa;  DINNER: 'dinner',              // 晚餐&#xa;  OTHER: 'other'                 // 其他&#xa;}&#xa;&#xa;&lt;b&gt;MEAL_TYPE_LABELS 中文标签&lt;/b&gt;&#xa;{&#xa;  breakfast: '早餐',&#xa;  lunch: '午餐',&#xa;  dinner: '晚餐',&#xa;  other: '其他'&#xa;}&#xa;&#xa;&lt;b&gt;GOAL_TYPES 健康目标&lt;/b&gt;&#xa;{&#xa;  LOSE: 'lose',                  // 减重&#xa;  MAINTAIN: 'maintain',          // 维持&#xa;  GAIN: 'gain'                   // 增重&#xa;}" vertex="1">
          <mxGeometry x="2300" y="500" width="280" height="220" as="geometry" />
        </mxCell>
        
        <!-- 配置常量 -->
        <mxCell id="const-config" parent="1" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#E65100;spacingLeft=5;spacingTop=3" value="&lt;b&gt;IMAGE_CONFIG 图片配置&lt;/b&gt;&#xa;{&#xa;  MAX_WIDTH: 1280,&#xa;  MAX_HEIGHT: 1280,&#xa;  QUALITY: 0.8,&#xa;  MAX_SIZE: 5 * 1024 * 1024      // 5MB&#xa;}&#xa;&#xa;&lt;b&gt;CHAT_CONFIG 聊天配置&lt;/b&gt;&#xa;{&#xa;  MAX_INPUT_LENGTH: 500,&#xa;  MAX_HISTORY: 10,&#xa;  MAX_STORAGE: 100,&#xa;  STORAGE_EXPIRE_DAYS: 7,&#xa;  AI_TIMEOUT: 30000              // 30秒&#xa;}&#xa;&#xa;&lt;b&gt;CACHE_CONFIG 缓存配置&lt;/b&gt;&#xa;{&#xa;  REPORT_CACHE_KEY: 'report_cache',&#xa;  HISTORY_CACHE_KEY: 'history_cache',&#xa;  CACHE_EXPIRE_MS: 86400000,     // 1天&#xa;  MAX_HISTORY_DAYS: 30&#xa;}&#xa;&#xa;&lt;b&gt;VALIDATION_RULES 验证规则&lt;/b&gt;&#xa;{&#xa;  date: {required: true},&#xa;  mealType: {required: true},&#xa;  foods: {required: true, type: 'array'},&#xa;  rating: {min: 1, max: 5}&#xa;}" vertex="1">
          <mxGeometry x="2000" y="750" width="280" height="280" as="geometry" />
        </mxCell>
        
        <!-- 存储键常量 -->
        <mxCell id="const-storage" parent="1" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#E65100;spacingLeft=5;spacingTop=3" value="&lt;b&gt;STORAGE_KEYS 本地存储键&lt;/b&gt;&#xa;{&#xa;  USER_INFO: 'userInfo',&#xa;  CHAT_MESSAGES: 'chat_messages',&#xa;  REPORT_CACHE: 'report_cache',&#xa;  HISTORY_CACHE: 'history_cache',&#xa;  SETTINGS: 'settings'&#xa;}&#xa;&#xa;&lt;b&gt;CLOUD_ENV 云环境配置&lt;/b&gt;&#xa;{&#xa;  ENV_ID: 'cloud1-5g94ikff8709bdba',&#xa;  DATABASE: 'smartdiet-db'&#xa;}&#xa;&#xa;&lt;b&gt;API_TIMEOUTS API超时配置&lt;/b&gt;&#xa;{&#xa;  LOGIN: 10000,                  // 10秒&#xa;  FOOD_RECOGNITION: 30000,       // 30秒&#xa;  CHAT: 30000,                   // 30秒&#xa;  RECORD_OPERATION: 10000        // 10秒&#xa;}&#xa;&#xa;&lt;b&gt;QUERY_LIMITS 查询限制&lt;/b&gt;&#xa;{&#xa;  DEFAULT_LIMIT: 20,&#xa;  MAX_LIMIT: 100,&#xa;  HISTORY_MAX_LIMIT: 100&#xa;}" vertex="1">
          <mxGeometry x="2300" y="750" width="280" height="280" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
