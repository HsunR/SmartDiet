        <mxCell id="f3-e7" edge="1" parent="1" source="f3-db" target="f3-success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3-e8" edge="1" parent="1" source="f3-success" target="f3-updateui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
          <mxGeometry relative="1" as="geometry" />
