        <mxCell id="f3-e10" edge="1" parent="1" source="f3-updateui" target="f3-refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
