        <mxCell id="f3-e4" edge="1" parent="1" source="f3-api" target="f3-cloud" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3-e5" edge="1" parent="1" source="f3-cloud" target="f3-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
          <mxGeometry relative="1" as="geometry" />
