        <mxCell id="f3-end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0;fontStyle=1" value="结束&#xa;记录保存成功" vertex="1">
          <mxGeometry x="840" y="1350" width="120" height="50" as="geometry" />
        </mxCell>
        
