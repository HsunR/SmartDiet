<mxfile host="app.diagrams.net" agent="SmartDiet" version="24.0.0">
  <diagram id="SmartDiet-Complete-Data-Flow" name="SmartDiet 完整数据流动流程">
    <mxGraphModel dx="2400" dy="2800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5000" pageHeight="4000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 图例说明 -->
        <mxCell id="legend-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#FFFFFF" value="图例说明" vertex="1">
          <mxGeometry x="40" y="40" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0" value="开始/结束" vertex="1">
          <mxGeometry x="40" y="85" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend-process" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="处理过程" vertex="1">
          <mxGeometry x="40" y="135" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend-data" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="数据/输入" vertex="1">
          <mxGeometry x="40" y="185" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend-decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="条件判断" vertex="1">
          <mxGeometry x="40" y="235" width="100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="legend-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;fontColor=#6A1B9A" value="数据库" vertex="1">
          <mxGeometry x="40" y="300" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="云函数/API" vertex="1">
          <mxGeometry x="40" y="360" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend-ai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="AI处理" vertex="1">
          <mxGeometry x="40" y="415" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend-dataflow" parent="1" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0" value="数据体流动" vertex="1">
          <mxGeometry x="40" y="470" width="100" height="30" as="geometry" />
        </mxCell>
        
        <!-- 主标题 -->
        <mxCell id="main-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#1976D2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=24;fontStyle=1;fontColor=#FFFFFF" value="SmartDiet 完整数据流动流程图" vertex="1">
          <mxGeometry x="400" y="40" width="600" height="50" as="geometry" />
        </mxCell>
        
        <!-- ==================== 数据结构定义区域 ==================== -->
        <mxCell id="data-section-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#2E7D32;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#FFFFFF" value="【核心数据结构定义】" vertex="1">
          <mxGeometry x="1100" y="40" width="600" height="35" as="geometry" />
        </mxCell>
        
        <!-- User 用户数据结构 -->
        <mxCell id="data-user" parent="1" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E7D32;spacingLeft=10;spacingTop=5" value="&lt;b&gt;User 用户数据结构&lt;/b&gt;&#xa;{&#xa;  _id: string,&#xa;  _openid: string,          // 微信用户唯一标识&#xa;  nickname: string,         // 昵称&#xa;  avatar: string,           // 头像URL&#xa;  gender: number,           // 性别 (1男/2女)&#xa;  age: number,              // 年龄&#xa;  height: number,           // 身高(cm)&#xa;  weight: number,           // 体重(kg)&#xa;  activityLevel: number,    // 活动水平(1-5)&#xa;  goal: string,             // 健康目标&#xa;    ├─ 'lose' 减重&#xa;    ├─ 'maintain' 维持&#xa;    └─ 'gain' 增重&#xa;  createdAt: timestamp,&#xa;  updatedAt: timestamp&#xa;}&#xa;&#xa;&lt;b&gt;示例数据:&lt;/b&gt;&#xa;{&#xa;  _openid: 'oABC123...',&#xa;  nickname: '张三',&#xa;  age: 28,&#xa;  height: 175,&#xa;  weight: 70,&#xa;  activityLevel: 3,&#xa;  goal: 'maintain'&#xa;}" vertex="1">
          <mxGeometry x="1100" y="90" width="280" height="340" as="geometry" />
        </mxCell>
        
        <!-- FoodRecord 饮食记录数据结构 -->
        <mxCell id="data-record" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=10;spacingTop=5" value="&lt;b&gt;FoodRecord 饮食记录结构&lt;/b&gt;&#xa;{&#xa;  _id: string,              // 记录唯一ID&#xa;  _openid: string,          // 用户OpenID&#xa;  date: string,             // 日期 YYYY-MM-DD&#xa;  mealType: string,         // 餐次类型&#xa;    ├─ 'breakfast' 早餐&#xa;    ├─ 'lunch' 午餐&#xa;    ├─ 'dinner' 晚餐&#xa;    └─ 'other' 其他&#xa;  foods: Food[],            // 食物列表&#xa;  totalCalories: number,    // 总卡路里&#xa;  rating: number (1-5),     // 评分&#xa;  imageUrl: string,         // 图片URL&#xa;  cloudFileId: string,      // 云文件ID&#xa;  mealOverview: MealOverview,&#xa;  createdAt: timestamp,&#xa;  updatedAt: timestamp&#xa;}&#xa;&#xa;&lt;b&gt;示例数据:&lt;/b&gt;&#xa;{&#xa;  date: '2026-04-26',&#xa;  mealType: 'lunch',&#xa;  totalCalories: 650,&#xa;  rating: 4&#xa;}" vertex="1">
          <mxGeometry x="1400" y="90" width="280" height="340" as="geometry" />
        </mxCell>
        
        <!-- Food 食物数据结构 -->
        <mxCell id="data-food" parent="1" style="text;html=1;strokeColor=#1976D2;fillColor=#BBDEFB;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1976D2;spacingLeft=10;spacingTop=5" value="&lt;b&gt;Food 食物数据结构&lt;/b&gt;&#xa;{&#xa;  id: string,               // 食物ID&#xa;  name: string,             // 食物名称&#xa;  category: string,         // 分类&#xa;    ├─ '主食' '蔬菜' '肉类'&#xa;    ├─ '水果' '饮品' '零食'&#xa;  totalCalories: number,    // 卡路里&#xa;  estimatedWeight: number,  // 估计重量(g)&#xa;  confidence: number (0-1), // 置信度&#xa;  portionEstimation: {&#xa;    estimatedWeight: number,&#xa;    confidence: number&#xa;  },&#xa;  tags: {&#xa;    positive: string[],     // 正面标签&#xa;      └─ ['高蛋白', '高纤维']&#xa;    warning: string[]       // 警告标签&#xa;      └─ ['高钠', '高糖']&#xa;  },&#xa;  tagReasons: object,&#xa;  advice: string,           // 饮食建议&#xa;  imageUrl: string&#xa;}&#xa;&#xa;&lt;b&gt;示例数据:&lt;/b&gt;&#xa;{&#xa;  name: '红烧肉',&#xa;  category: '肉类',&#xa;  totalCalories: 350,&#xa;  estimatedWeight: 150,&#xa;  confidence: 0.85&#xa;}" vertex="1">
          <mxGeometry x="1700" y="90" width="280" height="340" as="geometry" />
        </mxCell>
        
        <!-- Message 消息数据结构 -->
        <mxCell id="data-message" parent="1" style="text;html=1;strokeColor=#6A1B9A;fillColor=#E1BEE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#6A1B9A;spacingLeft=10;spacingTop=5" value="&lt;b&gt;Message 消息结构&lt;/b&gt;&#xa;{&#xa;  id: string,               // 消息唯一ID&#xa;  role: string,             // 角色&#xa;    ├─ 'user' 用户&#xa;    └─ 'assistant' AI助手&#xa;  type: string,             // 消息类型&#xa;    ├─ 'text' 文本&#xa;    ├─ 'image' 图片&#xa;    ├─ 'food_card' 食物卡片&#xa;    ├─ 'date_select' 日期选择&#xa;    ├─ 'meal_type_select' 餐次选择&#xa;    ├─ 'rating_select' 评分选择&#xa;    └─ 'feedback_input' 反馈输入&#xa;  content: string,          // 文本内容&#xa;  data: object,             // 附加数据&#xa;  timestamp: number         // 时间戳&#xa;}&#xa;&#xa;&lt;b&gt;示例数据:&lt;/b&gt;&#xa;{&#xa;  role: 'user',&#xa;  type: 'text',&#xa;  content: '今天吃了什么?',&#xa;  timestamp: 1714089600000&#xa;}" vertex="1">
          <mxGeometry x="2000" y="90" width="280" height="340" as="geometry" />
        </mxCell>
        
        <!-- AI Response AI响应结构 -->
        <mxCell id="data-ai-response" parent="1" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#E65100;spacingLeft=10;spacingTop=5" value="&lt;b&gt;AI Response AI响应结构&lt;/b&gt;&#xa;{&#xa;  success: boolean,&#xa;  summary: {&#xa;    calories: number,&#xa;    score: number (0-100),&#xa;    tags: {&#xa;      good: string[],&#xa;      warn: string[]&#xa;    },&#xa;    tagReasons: object&#xa;  },&#xa;  items: [{                 // 食物项列表&#xa;    id: string,&#xa;    name: string,&#xa;    category: string,&#xa;    calories: number,&#xa;    weight: {&#xa;      val: number,&#xa;      conf: number&#xa;    },&#xa;    tags: { good: [], warn: [] },&#xa;    tagReasons: {},&#xa;    advice: string&#xa;  }],&#xa;  reply: string             // AI回复文本&#xa;}&#xa;&#xa;&lt;b&gt;示例数据:&lt;/b&gt;&#xa;{&#xa;  success: true,&#xa;  summary: {&#xa;    calories: 650,&#xa;    score: 75&#xa;  },&#xa;  items: [{&#xa;    name: '米饭',&#xa;    calories: 200&#xa;  }]&#xa;}" vertex="1">
          <mxGeometry x="2300" y="90" width="280" height="340" as="geometry" />
        </mxCell>
        
        <!-- ==================== 数据存储位置 ==================== -->
        <mxCell id="storage-section-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#6A1B9A;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#FFFFFF" value="【数据存储位置】" vertex="1">
          <mxGeometry x="1100" y="450" width="600" height="35" as="geometry" />
        </mxCell>
        
        <!-- 云数据库 -->
        <mxCell id="storage-cloud-db" parent="1" style="text;html=1;strokeColor=#6A1B9A;fillColor=#E1BEE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#6A1B9A;spacingLeft=10;spacingTop=5" value="&lt;b&gt;云数据库 (Cloud Database)&lt;/b&gt;&#xa;&#xa;&lt;b&gt;users 集合&lt;/b&gt;&#xa;• 存储用户档案信息&#xa;• 索引: _openid (唯一)&#xa;• 权限: 仅创建者可读写&#xa;&#xa;&lt;b&gt;food_records 集合&lt;/b&gt;&#xa;• 存储饮食记录&#xa;• 索引: _openid, date, mealType&#xa;• 权限: 仅创建者可读写&#xa;• 过期策略: 无&#xa;&#xa;&lt;b&gt;数据量估算:&lt;/b&gt;&#xa;• 用户数: 10,000&#xa;• 每用户每天3条记录&#xa;• 月增长: ~900,000条" vertex="1">
          <mxGeometry x="1100" y="500" width="280" height="220" as="geometry" />
        </mxCell>
        
        <!-- 云存储 -->
        <mxCell id="storage-cloud-file" parent="1" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E7D32;spacingLeft=10;spacingTop=5" value="&lt;b&gt;云存储 (Cloud Storage)&lt;/b&gt;&#xa;&#xa;&lt;b&gt;food_images/ 目录&lt;/b&gt;&#xa;• 存储食物图片&#xa;• 命名: {recordId}_{timestamp}.jpg&#xa;• 格式: JPEG (压缩后)&#xa;• 最大尺寸: 1280x1280&#xa;• 质量: 80%&#xa;&#xa;&lt;b&gt;存储限制:&lt;/b&gt;&#xa;• 单文件: &lt;5MB&#xa;• 总容量: 5GB/环境&#xa;&#xa;&lt;b&gt;访问方式:&lt;/b&gt;&#xa;• cloudFileId → getTempFileURL&#xa;• 有效期: 2小时" vertex="1">
          <mxGeometry x="1400" y="500" width="280" height="220" as="geometry" />
        </mxCell>
        
        <!-- 本地存储 -->
        <mxCell id="storage-local" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=10;spacingTop=5" value="&lt;b&gt;本地存储 (LocalStorage)&lt;/b&gt;&#xa;&#xa;&lt;b&gt;userInfo&lt;/b&gt;&#xa;• 用户基本信息缓存&#xa;• 过期: 7天&#xa;&#xa;&lt;b&gt;chat_messages&lt;/b&gt;&#xa;• 聊天消息历史&#xa;• 最大: 100条&#xa;• 过期: 7天&#xa;&#xa;&lt;b&gt;report_cache&lt;/b&gt;&#xa;• 报告页数据缓存&#xa;• 过期: 1天&#xa;&#xa;&lt;b&gt;history_cache&lt;/b&gt;&#xa;• 历史记录缓存&#xa;• 过期: 1天&#xa;&#xa;&lt;b&gt;settings&lt;/b&gt;&#xa;• 用户设置项&#xa;• 永久存储" vertex="1">
          <mxGeometry x="1700" y="500" width="280" height="220" as="geometry" />
        </mxCell>
        
        <!-- 全局状态 -->
        <mxCell id="storage-global" parent="1" style="text;html=1;strokeColor=#F57F17;fillColor=#FFF9C4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#F57F17;spacingLeft=10;spacingTop=5" value="&lt;b&gt;全局状态 (app.globalData)&lt;/b&gt;&#xa;&#xa;&lt;b&gt;hasLogin&lt;/b&gt;&#xa;• 类型: boolean&#xa;• 登录状态标识&#xa;&#xa;&lt;b&gt;openid&lt;/b&gt;&#xa;• 类型: string&#xa;• 用户唯一标识&#xa;&#xa;&lt;b&gt;userInfo&lt;/b&gt;&#xa;• 类型: object&#xa;• 用户基本信息&#xa;&#xa;&lt;b&gt;needRefreshReport&lt;/b&gt;&#xa;• 类型: boolean&#xa;• 报告页刷新标记&#xa;&#xa;&lt;b&gt;pendingRecord&lt;/b&gt;&#xa;• 类型: object&#xa;• 待处理的记录参数" vertex="1">
          <mxGeometry x="2000" y="500" width="280" height="220" as="geometry" />
        </mxCell>
        
        <!-- ==================== 流程1: 用户登录数据流 ==================== -->
        <mxCell id="flow1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#1976D2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#FFFFFF" value="流程1: 用户登录 - 数据流动" vertex="1">
          <mxGeometry x="40" y="550" width="1000" height="35" as="geometry" />
        </mxCell>
        
        <!-- 登录流程节点 -->
        <mxCell id="f1-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0;fontStyle=1" value="开始&#xa;用户打开小程序" vertex="1">
          <mxGeometry x="60" y="610" width="120" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="f1-init" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;wx.cloud.init()&lt;/b&gt;&#xa;初始化云环境&#xa;env: cloud1-xxx" vertex="1">
          <mxGeometry x="60" y="690" width="140" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="f1-check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="检查&#xa;登录状态?" vertex="1">
          <mxGeometry x="80" y="780" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- 数据体: 登录状态检查 -->
        <mxCell id="f1-data-check" parent="1" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;数据体: 登录状态检查&lt;/b&gt;&#xa;localStorage.getItem('userInfo')&#xa;→ {&#xa;    openid: 'oABC123...',&#xa;    nickname: '张三',&#xa;    hasLogin: true&#xa;  }" vertex="1">
          <mxGeometry x="220" y="780" width="180" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="f1-getprofile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户点击授权&lt;/b&gt;&#xa;wx.getUserProfile()&#xa;获取头像昵称" vertex="1">
          <mxGeometry x="60" y="880" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- 数据体: 用户授权信息 -->
        <mxCell id="f1-data-profile" parent="1" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;数据体: 用户授权信息&lt;/b&gt;&#xa;wx.getUserProfile() 返回&#xa;→ {&#xa;    userInfo: {&#xa;      nickName: '张三',&#xa;      avatarUrl: 'https://...',&#xa;      gender: 1&#xa;    }&#xa;  }" vertex="1">
          <mxGeometry x="220" y="880" width="180" height="90" as="geometry" />
        </mxCell>
        
        <mxCell id="f1-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;云函数: user&lt;/b&gt;&#xa;action: 'login'&#xa;传入: userInfo" vertex="1">
          <mxGeometry x="60" y="970" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- 数据体: 云函数请求 -->
        <mxCell id="f1-data-request" parent="1" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;数据体: 云函数请求&lt;/b&gt;&#xa;cloud.callFunction('user', {&#xa;  action: 'login',&#xa;  data: {&#xa;    nickname: '张三',&#xa;    avatar: 'https://...',&#xa;    gender: 1&#xa;  }&#xa;})" vertex="1">
          <mxGeometry x="220" y="970" width="180" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="f1-getopenid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;获取OPENID&lt;/b&gt;&#xa;cloud.getWXContext()&#xa;自动获取用户标识" vertex="1">
          <mxGeometry x="60" y="1060" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- 数据体: OPENID -->
        <mxCell id="f1-data-openid" parent="1" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;数据体: OPENID获取&lt;/b&gt;&#xa;cloud.getWXContext()&#xa;→ {&#xa;    OPENID: 'oABC123XYZ...',&#xa;    APPID: 'wx1234567890',&#xa;    ENV: 'cloud1-xxx'&#xa;  }" vertex="1">
          <mxGeometry x="220" y="1060" width="180" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="f1-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: users&lt;/b&gt;&#xa;查询/创建用户" vertex="1">
          <mxGeometry x="70" y="1150" width="120" height="50" as="geometry" />
        </mxCell>
        
        <!-- 数据体: 数据库操作 -->
        <mxCell id="f1-data-db" parent="1" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;数据体: 数据库操作&lt;/b&gt;&#xa;db.collection('users')&#xa;  .where({openid})&#xa;  .get()&#xa;&#xa;若不存在则创建:&#xa;{&#xa;  openid: 'oABC123...',&#xa;  age: 25, // 默认值&#xa;  height: 170,&#xa;  weight: 65,&#xa;  activityLevel: 3,&#xa;  goal: 'maintain'&#xa;}" vertex="1">
          <mxGeometry x="220" y="1150" width="180" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="f1-return" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;返回用户数据&lt;/b&gt;&#xa;{openid, userData,&#xa; isNewUser}" vertex="1">
          <mxGeometry x="60" y="1230" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- 数据体: 返回数据 -->
