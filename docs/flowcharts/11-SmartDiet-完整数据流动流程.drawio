        <!-- 数据体: 记录数据 -->
        <mxCell id="f3-data-collect" parent="1" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;数据体: 记录数据收集&lt;/b&gt;&#xa;{&#xa;  date: '2026-04-26',&#xa;  mealType: 'lunch',&#xa;  rating: 4,&#xa;  foods: [&#xa;    {id: 'f1', name: '米饭',&#xa;     totalCalories: 200},&#xa;    {id: 'f2', name: '红烧肉',&#xa;     totalCalories: 350}&#xa;  ],&#xa;  totalCalories: 650,&#xa;  imageUrl: 'https://xxx...',&#xa;  cloudFileId: 'cloud://xxx...',&#xa;  mealOverview: {...}&#xa;}" vertex="1">
          <mxGeometry x="1000" y="690" width="180" height="170" as="geometry" />
        </mxCell>
        
        <mxCell id="f3-api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;api.food.addRecord()&lt;/b&gt;&#xa;调用添加记录API" vertex="1">
