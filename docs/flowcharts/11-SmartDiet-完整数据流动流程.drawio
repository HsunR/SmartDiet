        <mxCell id="f3-collect" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;收集记录数据&lt;/b&gt;&#xa;整合所有字段" vertex="1">
