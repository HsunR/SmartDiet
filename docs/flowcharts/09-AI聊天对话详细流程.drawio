<mxfile host="app.diagrams.net" agent="SmartDiet">
  <diagram id="AIChatFlow" name="AI聊天对话详细流程">
    <mxGraphModel dx="2400" dy="2800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4500" pageHeight="3500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 图例 -->
        <mxCell id="legend-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#FFFFFF" value="图例说明" vertex="1">
          <mxGeometry height="30" width="140" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0" value="开始/结束" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-process" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="处理过程" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="135" as="geometry" />
        </mxCell>
        <mxCell id="legend-data" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="数据/输入" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="185" as="geometry" />
        </mxCell>
        <mxCell id="legend-decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="条件判断" vertex="1">
          <mxGeometry height="45" width="100" x="40" y="235" as="geometry" />
        </mxCell>
        <mxCell id="legend-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;fontColor=#6A1B9A" value="数据库" vertex="1">
          <mxGeometry height="40" width="100" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="legend-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="云函数/API" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="legend-ai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="AI处理" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="415" as="geometry" />
        </mxCell>
        
        <!-- 流程标题 -->
        <mxCell id="flow-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#1976D2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1;fontColor=#FFFFFF" value="AI聊天对话详细流程" vertex="1">
          <mxGeometry height="50" width="400" x="400" y="40" as="geometry" />
        </mxCell>
        
        <!-- 数据结构定义 -->
        <mxCell id="data-def-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#2E7D32" value="【关键数据结构定义】" vertex="1">
          <mxGeometry height="30" width="500" x="950" y="40" as="geometry" />
        </mxCell>
        
        <mxCell id="data-message" parent="1" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E7D32;spacingLeft=10;spacingTop=5" value="&lt;b&gt;Message 消息结构&lt;/b&gt;&#xa;{&#xa;  id: string,              // 消息唯一ID&#xa;  role: string,            // 角色: 'user' | 'assistant'&#xa;  type: string,            // 类型: 'text' | 'image' | ...&#xa;  content: string,         // 文本内容&#xa;  data: object,            // 附加数据&#xa;  timestamp: number        // 时间戳&#xa;}&#xa;&#xa;&lt;b&gt;ConversationContext 对话上下文&lt;/b&gt;&#xa;{&#xa;  messages: Message[],     // 历史消息列表&#xa;  maxHistory: number       // 最大历史条数 (默认10)&#xa;}" vertex="1">
          <mxGeometry height="180" width="260" x="950" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-chat" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=10;spacingTop=5" value="&lt;b&gt;ChatRequest 聊天请求&lt;/b&gt;&#xa;{&#xa;  message: string,         // 用户消息&#xa;  context: {               // 上下文&#xa;    messages: Message[]&#xa;  }&#xa;}&#xa;&#xa;&lt;b&gt;ChatResponse 聊天响应&lt;/b&gt;&#xa;{&#xa;  success: boolean,&#xa;  data: {&#xa;    reply: string          // AI回复内容&#xa;  }&#xa;}&#xa;&#xa;&lt;b&gt;RecentDiet 最近饮食&lt;/b&gt;&#xa;{&#xa;  mealCount: number,       // 近3天餐次&#xa;  avgCalories: number,     // 平均卡路里&#xa;  recentFoods: string[]    // 最近食物列表&#xa;}" vertex="1">
          <mxGeometry height="220" width="240" x="1240" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-prompt" parent="1" style="text;html=1;strokeColor=#1976D2;fillColor=#BBDEFB;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1976D2;spacingLeft=10;spacingTop=5" value="&lt;b&gt;ChatPrompt 聊天提示词&lt;/b&gt;&#xa;模板内容:&#xa;---&#xa;你是AI营养师助手。帮助用户&#xa;记录饮食、提供建议、解答问题。&#xa;&#xa;用户信息: {userProfile}&#xa;最近饮食: {recentDiet}&#xa;对话历史: {conversationHistory}&#xa;&#xa;用温暖专业的语气回复，&#xa;简洁明了。直接回复，不需要&#xa;JSON格式。&#xa;---&#xa;&#xa;&lt;b&gt;Prompt变量替换&lt;/b&gt;&#xa;- {userProfile} → JSON.stringify&#xa;- {recentDiet} → JSON.stringify&#xa;- {conversationHistory} → &#xa;  messages.slice(-10)" vertex="1">
          <mxGeometry height="240" width="260" x="950" y="285" as="geometry" />
        </mxCell>
        
        <mxCell id="data-storage" parent="1" style="text;html=1;strokeColor=#6A1B9A;fillColor=#E1BEE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#6A1B9A;spacingLeft=10;spacingTop=5" value="&lt;b&gt;StorageKeys 存储键&lt;/b&gt;&#xa;{&#xa;  CHAT_MESSAGES: 'chat_messages',&#xa;  MAX_MESSAGES: 100,       // 最大保存条数&#xa;  EXPIRE_DAYS: 7           // 过期天数&#xa;}&#xa;&#xa;&lt;b&gt;本地存储结构&lt;/b&gt;&#xa;{&#xa;  messages: Message[],&#xa;  lastUpdate: timestamp,&#xa;  version: string&#xa;}" vertex="1">
          <mxGeometry height="140" width="240" x="1240" y="325" as="geometry" />
        </mxCell>
        
        <!-- 主流程: 发送消息 -->
        <mxCell id="main-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFF3E0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#E65100" value="【主流程: 发送消息】" vertex="1">
          <mxGeometry height="30" width="220" x="280" y="120" as="geometry" />
        </mxCell>
        
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0;fontStyle=1" value="开始&#xa;用户输入消息" vertex="1">
          <mxGeometry height="50" width="120" x="330" y="170" as="geometry" />
        </mxCell>
        
        <mxCell id="step1" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户输入&lt;/b&gt;&#xa;在输入框输入文本&#xa;点击发送按钮" vertex="1">
          <mxGeometry height="60" width="140" x="320" y="250" as="geometry" />
        </mxCell>
        
        <mxCell id="step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onInputChange()&lt;/b&gt;&#xa;实时更新输入值&#xa;inputValue: string" vertex="1">
          <mxGeometry height="55" width="140" x="320" y="340" as="geometry" />
        </mxCell>
        
        <mxCell id="step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;sendMessage()&lt;/b&gt;&#xa;发送消息处理&#xa;1. 验证输入非空&#xa;2. 创建用户消息" vertex="1">
          <mxGeometry height="70" width="150" x="315" y="425" as="geometry" />
        </mxCell>
        
        <mxCell id="step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;createTextMessage()&lt;/b&gt;&#xa;创建用户文本消息&#xa;role: 'user'" vertex="1">
          <mxGeometry height="55" width="150" x="315" y="525" as="geometry" />
        </mxCell>
        
        <mxCell id="step5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;更新消息列表&lt;/b&gt;&#xa;messages.push(userMsg)&#xa;滚动到底部" vertex="1">
          <mxGeometry height="60" width="150" x="315" y="610" as="geometry" />
        </mxCell>
        
        <mxCell id="step6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;显示加载状态&lt;/b&gt;&#xa;isLoading: true&#xa;显示打字指示器" vertex="1">
          <mxGeometry height="60" width="140" x="320" y="700" as="geometry" />
