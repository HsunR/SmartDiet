        </mxCell>
        
        <mxCell id="ai2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;云函数: aiGateway&lt;/b&gt;&#xa;action: 'chat'" vertex="1">
          <mxGeometry height="45" width="150" x="565" y="260" as="geometry" />
        </mxCell>
        
        <mxCell id="ai3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;getUserProfile()&lt;/b&gt;&#xa;查询用户档案" vertex="1">
          <mxGeometry height="45" width="140" x="510" y="340" as="geometry" />
        </mxCell>
        
        <mxCell id="ai3-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: users&lt;/b&gt;&#xa;查询用户信息" vertex="1">
          <mxGeometry height="50" width="120" x="520" y="420" as="geometry" />
