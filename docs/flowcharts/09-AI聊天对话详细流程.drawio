        <mxCell id="ai4-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: food_records&lt;/b&gt;&#xa;查询近3天记录" vertex="1">
