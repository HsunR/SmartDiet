        <!-- AI处理流程 -->
        <mxCell id="ai-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#BBDEFB;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#1976D2" value="【AI处理流程】" vertex="1">
          <mxGeometry height="30" width="180" x="550" y="120" as="geometry" />
        </mxCell>
        
        <mxCell id="ai1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;api.chat.send()&lt;/b&gt;&#xa;调用聊天API&#xa;传入: message + context" vertex="1">
