        <mxCell id="d2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;createTextMessage()&lt;/b&gt;&#xa;创建AI回复消息&#xa;role: 'assistant'" vertex="1">
