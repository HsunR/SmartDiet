        <!-- 异常处理说明 -->
        <mxCell id="exception-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFEBEE;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#C62828" value="【异常处理路径】" vertex="1">
          <mxGeometry height="25" width="150" x="1650" y="120" as="geometry" />
        </mxCell>
        
        <mxCell id="exception1" parent="1" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#C62828;spacingLeft=5;spacingTop=3" value="&lt;b&gt;1. AI服务超时&lt;/b&gt;&#xa;   - 超时时间: 30s&#xa;   - 隐藏加载状态&#xa;   - 提示: '回复生成超时，请重试'&#xa;   - 保留用户消息，可重新发送&#xa;&#xa;&lt;b&gt;2. AI服务异常&lt;/b&gt;&#xa;   - 返回错误信息&#xa;   - 显示友好提示:&#xa;     '暂时无法回复，请稍后再试'&#xa;   - 记录错误日志&#xa;&#xa;&lt;b&gt;3. 网络中断&lt;/b&gt;&#xa;   - 检测网络状态&#xa;   - 提示检查网络&#xa;   - 提供重试机制&#xa;&#xa;&lt;b&gt;4. 消息过长&lt;/b&gt;&#xa;   - 限制输入长度 (500字)&#xa;   - 超出提示截断&#xa;   - 历史消息只保留最近10条" vertex="1">
          <mxGeometry height="240" width="200" x="1650" y="160" as="geometry" />
        </mxCell>
        
        <!-- 接口定义 -->
        <mxCell id="api-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#1565C0" value="【接口定义】" vertex="1">
          <mxGeometry height="25" width="100" x="1650" y="420" as="geometry" />
        </mxCell>
        
        <mxCell id="api-def" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;云函数: aiGateway&lt;/b&gt;&#xa;├── action: 'chat'&#xa;│   └── 输入: {message, context}&#xa;│   └── 输出: {success, data: {reply}}&#xa;└── action: 'foodRecognition'&#xa;    └── 输入: {imageUrl, userFeedback?}&#xa;&#xa;&lt;b&gt;云函数: foodRecord&lt;/b&gt;&#xa;├── action: 'getByDate'&#xa;│   └── 输入: {date}&#xa;│   └── 输出: {success, data: records[]}&#xa;└── action: 'getHistory'&#xa;    └── 输入: {startDate, endDate}&#xa;&#xa;&lt;b&gt;Service: chat-service.js&lt;/b&gt;&#xa;├── loadMessages()&#xa;├── saveMessages(messages)&#xa;├── initChat()&#xa;└── clearMessages()&#xa;&#xa;&lt;b&gt;Factory: message-factory.js&lt;/b&gt;&#xa;├── createTextMessage(role, content)&#xa;├── createImageMessage(role, imageUrl)&#xa;├── createQuickActionsMessage()&#xa;└── createFoodCardMessage(...)" vertex="1">
          <mxGeometry height="300" width="280" x="1650" y="460" as="geometry" />
        </mxCell>
        
        <!-- 常量定义 -->
        <mxCell id="const-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFF3E0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#E65100" value="【常量定义】" vertex="1">
          <mxGeometry height="25" width="100" x="1650" y="780" as="geometry" />
        </mxCell>
        
        <mxCell id="const-def" parent="1" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#E65100;spacingLeft=5;spacingTop=3" value="&lt;b&gt;MESSAGE_TYPES 消息类型&lt;/b&gt;&#xa;{&#xa;  TEXT: 'text',&#xa;  IMAGE: 'image',&#xa;  FOOD_CARD: 'food_card',&#xa;  QUICK_ACTIONS: 'quick_actions',&#xa;  DATE_SELECT: 'date_select',&#xa;  MEAL_TYPE_SELECT: 'meal_type_select',&#xa;  RATING_SELECT: 'rating_select',&#xa;  FEEDBACK_INPUT: 'feedback_input',&#xa;  USER_INFO_FORM: 'user_info_form'&#xa;}&#xa;&#xa;&lt;b&gt;MESSAGE_ROLES 消息角色&lt;/b&gt;&#xa;{&#xa;  USER: 'user',&#xa;  ASSISTANT: 'assistant'&#xa;}&#xa;&#xa;&lt;b&gt;CHAT_CONFIG 聊天配置&lt;/b&gt;&#xa;{&#xa;  MAX_INPUT_LENGTH: 500,&#xa;  MAX_HISTORY: 10,&#xa;  MAX_STORAGE: 100,&#xa;  STORAGE_EXPIRE_DAYS: 7,&#xa;  AI_TIMEOUT: 30000&#xa;}&#xa;&#xa;&lt;b&gt;QUICK_ACTIONS 快捷操作&lt;/b&gt;&#xa;[&#xa;  {id: 'photo', label: '拍照识别', icon: '📷'},&#xa;  {id: 'report', label: '今日报告', icon: '📊'},&#xa;  {id: 'recommend', label: '饮食建议', icon: '💡'}&#xa;]" vertex="1">
          <mxGeometry height="280" width="280" x="1650" y="820" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
