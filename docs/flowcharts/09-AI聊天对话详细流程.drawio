        <mxCell id="d3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;更新消息列表&lt;/b&gt;&#xa;messages.push(aiMsg)&#xa;滚动到底部" vertex="1">
