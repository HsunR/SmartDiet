        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;wx.setStorageSync()&lt;/b&gt;&#xa;key: 'chat_messages'&#xa;value: messages" vertex="1">
