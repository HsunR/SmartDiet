        <mxCell id="ai9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;返回ChatResponse&lt;/b&gt;&#xa;{success, data: {reply}}" vertex="1">
