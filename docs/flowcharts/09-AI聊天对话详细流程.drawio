        <mxCell id="ai5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="&lt;b&gt;构建Chat Prompt&lt;/b&gt;&#xa;整合:&#xa;- 提示词模板&#xa;- 用户档案&#xa;- 最近饮食&#xa;- 对话历史" vertex="1">
