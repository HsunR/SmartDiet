        <mxCell id="ai8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="&lt;b&gt;extractContent()&lt;/b&gt;&#xa;提取AI回复文本" vertex="1">
