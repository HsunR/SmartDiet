        <mxCell id="ai4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;getRecentDiet()&lt;/b&gt;&#xa;查询最近3天饮食" vertex="1">
