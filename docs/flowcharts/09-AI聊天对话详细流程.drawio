        <mxCell id="ai6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="&lt;b&gt;callAIWithSystem()&lt;/b&gt;&#xa;调用AI服务&#xa;system: prompt&#xa;user: message" vertex="1">
