        <mxCell id="ai7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize="11;fontColor=#1976D2" value="&lt;b&gt;AI Provider&lt;/b&gt;&#xa;- DashScope&#xa;- Qwen-Max&#xa;- 智谱AI&#xa;生成回复" vertex="1">
