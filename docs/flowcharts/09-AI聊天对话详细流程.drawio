        <!-- 连接线 - 主流程 -->
        <mxCell id="em1" edge="1" parent="1" source="start" target="step1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
