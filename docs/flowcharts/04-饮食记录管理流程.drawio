        </mxCell>
        
        <!-- API接口 -->
        <mxCell id="apiTitle" value="API接口定义" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="930" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="apiBox" value="&lt;b&gt;添加记录&lt;/b&gt;&lt;br/&gt;api.food.addRecord(record)&lt;br/&gt;→ cloud.callFunction('foodRecord', {action: 'add', data: record})&lt;br/&gt;&lt;br/&gt;&lt;b&gt;按日期查询&lt;/b&gt;&lt;br/&gt;api.food.getRecords(date)&lt;br/&gt;→ cloud.callFunction('foodRecord', {action: 'getByDate', data: {date}})&lt;br/&gt;&lt;br/&gt;&lt;b&gt;按范围查询&lt;/b&gt;&lt;br/&gt;api.food.getHistory(startDate, endDate)&lt;br/&gt;→ cloud.callFunction('foodRecord', {action: 'getHistory', data: {startDate, endDate}})&lt;br/&gt;&lt;br/&gt;&lt;b&gt;更新记录&lt;/b&gt;&lt;br/&gt;api.food.updateRecord(recordId, data)&lt;br/&gt;→ cloud.callFunction('foodRecord', {action: 'update', data: {recordId, ...}})&lt;br/&gt;&lt;br/&gt;&lt;b&gt;删除记录&lt;/b&gt;&lt;br/&gt;api.food.deleteRecord(recordId)&lt;br/&gt;→ cloud.callFunction('foodRecord', {action: 'delete', data: {recordId}})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="970" width="450" height="220" as="geometry" />
        </mxCell>
        
        <!-- 示例数据交互 -->
        <mxCell id="exampleTitle" value="示例数据交互" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="1210" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="exampleBox" value="&lt;b&gt;【场景】保存午餐识别结果到饮食记录&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. 准备记录数据（来自识别结果）&lt;/b&gt;&lt;br/&gt;{&lt;br/&gt;  date: '2026-04-27',&lt;br/&gt;  mealType: 'lunch',&lt;br/&gt;  rating: 4,&lt;br/&gt;  foods: [&lt;br/&gt;    {id:'f1', name:'红烧鸡腿', category:'肉类', totalCalories:320, estimatedWeight:150, imageUrl:'cloud://.../img_abc123.jpg'},&lt;br/&gt;    {id:'f2', name:'炒青菜', category:'蔬菜', totalCalories:80, estimatedWeight:200},&lt;br/&gt;    {id:'f3', name:'米饭', category:'主食', totalCalories:280, estimatedWeight:250}&lt;br/&gt;  ],&lt;br/&gt;  totalCalories: 680,&lt;br/&gt;  imageUrl: 'cloud://.../img_abc123.jpg',&lt;br/&gt;  mealOverview: {&lt;br/&gt;    totalCalories: 680,&lt;br/&gt;    overallHealthScore: 78,&lt;br/&gt;    healthTags: {positive:['蔬菜丰富'], warning:['油脂偏高','主食过量']}&lt;br/&gt;  }&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. 调用添加API&lt;/b&gt;&lt;br/&gt;cloud.callFunction('foodRecord', {&lt;br/&gt;  action: 'add',&lt;br/&gt;  data: record&lt;br/&gt;})&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. 云函数处理&lt;/b&gt;&lt;br/&gt;• 验证用户登录状态（获取openid）&lt;br/&gt;• 插入 food_records 集合&lt;br/&gt;• 生成记录ID: record_xyz789&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4. 云函数响应&lt;/b&gt;&lt;br/&gt;{success: true, recordId: 'record_xyz789'}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;5. 前端处理结果&lt;/b&gt;&lt;br/&gt;• 食物卡片标记为'已保存'&lt;br/&gt;• 显示Toast: '保存成功'&lt;br/&gt;• 更新今日热量进度: 680/2069 kcal&lt;br/&gt;&lt;br/&gt;&lt;b&gt;【场景】查询今日饮食记录&lt;/b&gt;&lt;br/&gt;请求: cloud.callFunction('foodRecord', {action:'getByDate', data:{date:'2026-04-27'}})&lt;br/&gt;响应: {records: [record1, record2], totalCalories: 1250}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4f8;strokeColor=#4a90e2;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="1250" width="480" height="480" as="geometry" />
        </mxCell>
        
        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="start" target="operationType">
