        <mxCell id="dbTable" value="&lt;table&gt;&lt;tr&gt;&lt;td&gt;字段名&lt;/td&gt;&lt;td&gt;类型&lt;/td&gt;&lt;td&gt;说明&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;_id&lt;/td&gt;&lt;td&gt;String&lt;/td&gt;&lt;td&gt;记录唯一ID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;_openid&lt;/td&gt;&lt;td&gt;String&lt;/td&gt;&lt;td&gt;用户OPENID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;date&lt;/td&gt;&lt;td&gt;String&lt;/td&gt;&lt;td&gt;日期 YYYY-MM-DD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mealType&lt;/td&gt;&lt;td&gt;String&lt;/td&gt;&lt;td&gt;餐次类型&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rating&lt;/td&gt;&lt;td&gt;Number&lt;/td&gt;&lt;td&gt;用户评分(0-5)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;foods&lt;/td&gt;&lt;td&gt;Array&lt;/td&gt;&lt;td&gt;食物列表&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;totalCalories&lt;/td&gt;&lt;td&gt;Number&lt;/td&gt;&lt;td&gt;总热量(kcal)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;imageUrl&lt;/td&gt;&lt;td&gt;String&lt;/td&gt;&lt;td&gt;图片云存储ID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mealOverview&lt;/td&gt;&lt;td&gt;Object&lt;/td&gt;&lt;td&gt;餐食概览&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;createdAt&lt;/td&gt;&lt;td&gt;Date&lt;/td&gt;&lt;td&gt;创建时间&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;updatedAt&lt;/td&gt;&lt;td&gt;Date&lt;/td&gt;&lt;td&gt;更新时间&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
