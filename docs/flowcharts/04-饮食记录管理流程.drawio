          <mxGeometry x="50" y="720" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="overviewBox" value="{&lt;br/&gt;  totalCalories: Number,&lt;br/&gt;  overallHealthScore: Number,&lt;br/&gt;  healthTags: {&lt;br/&gt;    positive: [],&lt;br/&gt;    warning: []&lt;br/&gt;  },&lt;br/&gt;  tagReasons: Object,&lt;br/&gt;  summary: String&lt;br/&gt;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
