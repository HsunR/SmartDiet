        <mxCell id="success2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;返回识别结果&lt;/b&gt;&#xa;{success, foods,&#xa;mealOverview, advice}" vertex="1">
