        <mxCell id="ai5" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: users&lt;/b&gt;&#xa;查询用户信息" vertex="1">
