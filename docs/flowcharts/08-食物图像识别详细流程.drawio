        </mxCell>
        
        <!-- 异常处理说明 -->
        <mxCell id="exception-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFEBEE;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#C62828" value="【异常处理路径】" vertex="1">
          <mxGeometry height="25" width="150" x="1650" y="120" as="geometry" />
        </mxCell>
        
        <mxCell id="exception1" parent="1" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#C62828;spacingLeft=5;spacingTop=3" value="&lt;b&gt;1. 图片上传失败&lt;/b&gt;&#xa;   - 检查网络连接&#xa;   - 压缩后重试&#xa;   - 提示用户检查权限&#xa;&#xa;&lt;b&gt;2. AI识别超时&lt;/b&gt;&#xa;   - 超时时间: 30s&#xa;   - 提示: '识别超时，请重试'&#xa;   - 提供重试按钮&#xa;&#xa;&lt;b&gt;3. AI响应解析失败&lt;/b&gt;&#xa;   - 记录原始响应&#xa;   - 返回友好错误提示&#xa;   - 建议用户重新拍照&#xa;&#xa;&lt;b&gt;4. 用户取消操作&lt;/b&gt;&#xa;   - 各步骤可返回/取消&#xa;   - 清理临时数据&#xa;   - 返回聊天界面" vertex="1">
          <mxGeometry height="200" width="200" x="1650" y="160" as="geometry" />
        </mxCell>
        
        <!-- 接口定义 -->
        <mxCell id="api-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#1565C0" value="【接口定义】" vertex="1">
          <mxGeometry height="25" width="100" x="1650" y="380" as="geometry" />
        </mxCell>
        
        <mxCell id="api-def" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;云函数: aiGateway&lt;/b&gt;&#xa;├── action: 'foodRecognition'&#xa;│   └── 输入: {imageUrl, userFeedback?}&#xa;│   └── 输出: {success, foods[], mealOverview, advice}&#xa;└── action: 'chat'&#xa;    └── 输入: {message, context}&#xa;    └── 输出: {success, reply}&#xa;&#xa;&lt;b&gt;云函数: foodRecord&lt;/b&gt;&#xa;├── action: 'add'&#xa;│   └── 输入: {date, mealType, foods[], rating, imageUrl}&#xa;├── action: 'getByDate'&#xa;│   └── 输入: {date}&#xa;├── action: 'getHistory'&#xa;│   └── 输入: {startDate, endDate}&#xa;├── action: 'update'&#xa;│   └── 输入: {recordId, ...updates}&#xa;└── action: 'delete'&#xa;    └── 输入: {recordId}&#xa;&#xa;&lt;b&gt;小程序API&lt;/b&gt;&#xa;├── wx.chooseMedia()&#xa;├── wx.cloud.uploadFile()&#xa;├── wx.cloud.getTempFileURL()&#xa;└── wx.cloud.callFunction()" vertex="1">
          <mxGeometry height="280" width="280" x="1650" y="420" as="geometry" />
        </mxCell>
        
        <!-- 常量定义 -->
        <mxCell id="const-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFF3E0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#E65100" value="【常量定义】" vertex="1">
          <mxGeometry height="25" width="100" x="1650" y="720" as="geometry" />
        </mxCell>
        
        <mxCell id="const-def" parent="1" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#E65100;spacingLeft=5;spacingTop=3" value="&lt;b&gt;MEAL_TYPES 餐次类型&lt;/b&gt;&#xa;{&#xa;  BREAKFAST: 'breakfast',&#xa;  LUNCH: 'lunch',&#xa;  DINNER: 'dinner',&#xa;  OTHER: 'other'&#xa;}&#xa;&#xa;&lt;b&gt;MESSAGE_TYPES 消息类型&lt;/b&gt;&#xa;{&#xa;  TEXT: 'text',&#xa;  IMAGE: 'image',&#xa;  FOOD_CARD: 'food_card',&#xa;  DATE_SELECT: 'date_select',&#xa;  MEAL_TYPE_SELECT: 'meal_type_select',&#xa;  RATING_SELECT: 'rating_select',&#xa;  FEEDBACK_INPUT: 'feedback_input'&#xa;}&#xa;&#xa;&lt;b&gt;图片配置&lt;/b&gt;&#xa;{&#xa;  maxWidth: 1280,&#xa;  maxHeight: 1280,&#xa;  quality: 0.8,&#xa;  timeout: 30000&#xa;}" vertex="1">
          <mxGeometry height="220" width="220" x="1650" y="760" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
