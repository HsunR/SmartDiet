          <mxGeometry height="25" width="120" x="820" y="120" as="geometry" />
        </mxCell>
        
        <mxCell id="r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;createRatingSelectMessage()&lt;/b&gt;&#xa;创建评分选择消息" vertex="1">
