        <mxCell id="ai1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;startRecognition()&lt;/b&gt;&#xa;启动食物识别&#xa;显示加载状态" vertex="1">
