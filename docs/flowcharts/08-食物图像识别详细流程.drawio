        <mxCell id="step14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onMealTypeSelect()&lt;/b&gt;&#xa;确认餐次选择&#xa;触发食物识别" vertex="1">
