        </mxCell>
        
        <mxCell id="step3" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户选择&lt;/b&gt;&#xa;拍照 或 从相册选择" vertex="1">
