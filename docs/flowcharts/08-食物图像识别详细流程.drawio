<mxfile host="app.diagrams.net" agent="SmartDiet">
  <diagram id="FoodRecognitionFlow" name="食物图像识别详细流程">
    <mxGraphModel dx="2400" dy="2800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4500" pageHeight="3500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 图例 -->
        <mxCell id="legend-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#FFFFFF" value="图例说明" vertex="1">
          <mxGeometry height="30" width="140" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0" value="开始/结束" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-process" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="处理过程" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="135" as="geometry" />
        </mxCell>
        <mxCell id="legend-data" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="数据/输入" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="185" as="geometry" />
        </mxCell>
        <mxCell id="legend-decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="条件判断" vertex="1">
          <mxGeometry height="45" width="100" x="40" y="235" as="geometry" />
        </mxCell>
        <mxCell id="legend-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;fontColor=#6A1B9A" value="数据库" vertex="1">
          <mxGeometry height="40" width="100" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="legend-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="云函数/API" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="legend-ai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="AI处理" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="415" as="geometry" />
        </mxCell>
        
        <!-- 流程标题 -->
        <mxCell id="flow-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#1976D2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1;fontColor=#FFFFFF" value="食物图像识别详细流程" vertex="1">
          <mxGeometry height="50" width="450" x="400" y="40" as="geometry" />
        </mxCell>
        
        <!-- 数据结构定义 -->
        <mxCell id="data-def-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#2E7D32" value="【关键数据结构定义】" vertex="1">
          <mxGeometry height="30" width="500" x="950" y="40" as="geometry" />
        </mxCell>
        
        <mxCell id="data-food" parent="1" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E7D32;spacingLeft=10;spacingTop=5" value="&lt;b&gt;Food 食物数据结构&lt;/b&gt;&#xa;{&#xa;  id: string,                    // 唯一标识&#xa;  name: string,                  // 食物名称&#xa;  category: string,              // 分类 (主食/蔬菜/肉类等)&#xa;  totalCalories: number,         // 总卡路里&#xa;  estimatedWeight: number,       // 估计重量(g)&#xa;  confidence: number (0-1),      // 置信度&#xa;  portionEstimation: {           // 份量估计&#xa;    estimatedWeight: number,&#xa;    confidence: number&#xa;  },&#xa;  tags: {                        // 标签&#xa;    positive: string[],          // 正面标签 (高蛋白/高纤维等)&#xa;    warning: string[]            // 警告标签 (高钠/高糖等)&#xa;  },&#xa;  tagReasons: object,            // 标签原因说明&#xa;  advice: string                 // 饮食建议&#xa;}" vertex="1">
          <mxGeometry height="260" width="260" x="950" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-meal" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=10;spacingTop=5" value="&lt;b&gt;MealOverview 餐食概览&lt;/b&gt;&#xa;{&#xa;  totalCalories: number,         // 总卡路里&#xa;  overallHealthScore: number,    // 健康评分 (0-100)&#xa;  healthTags: {&#xa;    positive: string[],&#xa;    warning: string[]&#xa;  },&#xa;  tagReasons: object,&#xa;  summary: string                // 摘要描述&#xa;}&#xa;&#xa;&lt;b&gt;RecognitionResult 识别结果&lt;/b&gt;&#xa;{&#xa;  success: boolean,&#xa;  foods: Food[],                 // 食物列表&#xa;  mealOverview: MealOverview,   // 餐食概览&#xa;  dietaryAdvice: string,        // 饮食建议&#xa;  rawResponse: object           // AI原始响应&#xa;}" vertex="1">
          <mxGeometry height="220" width="260" x="1240" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-ai" parent="1" style="text;html=1;strokeColor=#1976D2;fillColor=#BBDEFB;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1976D2;spacingLeft=10;spacingTop=5" value="&lt;b&gt;AIResponse AI响应结构&lt;/b&gt;&#xa;{&#xa;  success: boolean,&#xa;  summary: {&#xa;    calories: number,&#xa;    score: number,&#xa;    tags: { good: [], warn: [] },&#xa;    tagReasons: {}&#xa;  },&#xa;  items: [{                      // 食物项列表&#xa;    id: string,&#xa;    name: string,&#xa;    category: string,&#xa;    calories: number,&#xa;    weight: {&#xa;      val: number,               // 估计重量&#xa;      conf: number              // 置信度&#xa;    },&#xa;    tags: { good: [], warn: [] },&#xa;    tagReasons: {},&#xa;    advice: string&#xa;  }]&#xa;}&#xa;&#xa;&lt;b&gt;PromptTemplate 提示词模板&lt;/b&gt;&#xa;包含:&#xa;- 角色定义 (AI营养师)&#xa;- 用户信息占位符&#xa;- 反馈信息占位符&#xa;- JSON结构要求&#xa;- 输出格式规范" vertex="1">
          <mxGeometry height="280" width="260" x="950" y="365" as="geometry" />
        </mxCell>
        
        <mxCell id="data-record" parent="1" style="text;html=1;strokeColor=#6A1B9A;fillColor=#E1BEE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#6A1B9A;spacingLeft=10;spacingTop=5" value="&lt;b&gt;FoodRecord 食物记录&lt;/b&gt;&#xa;{&#xa;  _id: string,&#xa;  _openid: string,              // 用户ID&#xa;  date: string (YYYY-MM-DD),    // 日期&#xa;  mealType: string,             // 餐次类型&#xa;    ├─ 'breakfast' 早餐&#xa;    ├─ 'lunch' 午餐&#xa;    ├─ 'dinner' 晚餐&#xa;    └─ 'other' 其他&#xa;  foods: Food[],                 // 食物列表&#xa;  totalCalories: number,        // 总卡路里&#xa;  rating: number (1-5),         // 评分&#xa;  imageUrl: string,             // 图片URL&#xa;  cloudFileId: string,          // 云文件ID&#xa;  createdAt: timestamp,&#xa;  updatedAt: timestamp&#xa;}" vertex="1">
          <mxGeometry height="240" width="240" x="1240" y="325" as="geometry" />
        </mxCell>
        
        <!-- 主流程: 图像识别 -->
        <mxCell id="main-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFF3E0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#E65100" value="【主流程: 食物图像识别】" vertex="1">
          <mxGeometry height="30" width="280" x="250" y="120" as="geometry" />
        </mxCell>
        
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0;fontStyle=1" value="开始&#xa;用户点击拍照/相册" vertex="1">
          <mxGeometry height="50" width="120" x="330" y="170" as="geometry" />
        </mxCell>
        
        <mxCell id="step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onQuickAction('photo')&lt;/b&gt;&#xa;触发拍照流程" vertex="1">
          <mxGeometry height="50" width="160" x="310" y="250" as="geometry" />
        </mxCell>
        
        <mxCell id="step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;chooseImage()&lt;/b&gt;&#xa;显示ActionSheet&#xa;选择拍照或相册" vertex="1">
