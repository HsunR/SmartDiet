        <mxCell id="step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;wx.chooseMedia()&lt;/b&gt;&#xa;调用系统相机/相册&#xa;获取图片临时路径" vertex="1">
          <mxGeometry height="60" width="150" x="315" y="500" as="geometry" />
        </mxCell>
        
        <mxCell id="step5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;pickImage()&lt;/b&gt;&#xa;处理选中图片&#xa;压缩图片尺寸" vertex="1">
          <mxGeometry height="60" width="150" x="315" y="590" as="geometry" />
        </mxCell>
        
        <mxCell id="step6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;uploadAndGetUrl()&lt;/b&gt;&#xa;上传图片到云存储" vertex="1">
          <mxGeometry height="50" width="150" x="315" y="680" as="geometry" />
        </mxCell>
        
        <mxCell id="step7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;wx.cloud.uploadFile()&lt;/b&gt;&#xa;上传至云存储&#xa;获取cloudFileId" vertex="1">
          <mxGeometry height="60" width="150" x="315" y="760" as="geometry" />
        </mxCell>
        
        <mxCell id="step8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;wx.cloud.getTempFileURL()&lt;/b&gt;&#xa;获取图片临时访问URL" vertex="1">
          <mxGeometry height="50" width="160" x="310" y="850" as="geometry" />
        </mxCell>
        
        <!-- 创建交互消息 -->
        <mxCell id="step9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;createDateSelectMessage()&lt;/b&gt;&#xa;创建日期选择消息" vertex="1">
