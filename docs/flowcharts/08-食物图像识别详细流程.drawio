        <mxCell id="r2" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户交互&lt;/b&gt;&#xa;选择评分&#xa;1-5星" vertex="1">
