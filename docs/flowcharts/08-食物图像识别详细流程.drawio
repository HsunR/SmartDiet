        <mxCell id="step12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;createMealTypeSelectMessage()&lt;/b&gt;&#xa;创建餐次选择消息" vertex="1">
