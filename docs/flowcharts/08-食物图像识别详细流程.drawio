        <mxCell id="r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onRatingSelect()&lt;/b&gt;&#xa;确认评分&#xa;rating: 1-5" vertex="1">
          <mxGeometry height="55" width="120" x="820" y="335" as="geometry" />
        </mxCell>
        
        <mxCell id="r4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;checkAndShowResult()&lt;/b&gt;&#xa;检查任务完成&#xa;显示食物卡片" vertex="1">
          <mxGeometry height="55" width="140" x="810" y="420" as="geometry" />
