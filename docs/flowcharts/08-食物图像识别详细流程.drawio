        </mxCell>
        
        <mxCell id="ai6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="&lt;b&gt;构建Prompt&lt;/b&gt;&#xa;整合:&#xa;- 提示词模板&#xa;- 用户信息&#xa;- 用户反馈(如有)" vertex="1">
