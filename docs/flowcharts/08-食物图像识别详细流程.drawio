        </mxCell>
        
        <mxCell id="ai2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;api.food.recognize()&lt;/b&gt;&#xa;调用识别API&#xa;imageUrl: 图片URL" vertex="1">
