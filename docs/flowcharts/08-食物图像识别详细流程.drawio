          <mxGeometry height="60" width="150" x="575" y="710" as="geometry" />
        </mxCell>
        
        <mxCell id="ai8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="&lt;b&gt;AI Provider&lt;/b&gt;&#xa;- DashScope&#xa;- Qwen-VL&#xa;- 智谱AI&#xa;多模态图像识别" vertex="1">
          <mxGeometry height="80" width="130" x="585" y="800" as="geometry" />
        </mxCell>
        
        <mxCell id="ai9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="&lt;b&gt;extractContent()&lt;/b&gt;&#xa;提取AI响应内容" vertex="1">
          <mxGeometry height="45" width="140" x="580" y="910" as="geometry" />
        </mxCell>
        
        <mxCell id="ai10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontColor=#1976D2" value="&lt;b&gt;parseJsonResponse()&lt;/b&gt;&#xa;解析JSON响应&#xa;处理格式异常" vertex="1">
