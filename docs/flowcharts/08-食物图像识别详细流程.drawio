        <mxCell id="e-card-feedback" edge="1" parent="1" source="c3" target="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9800;strokeWidth=2;fontColor=#FF9800" value="反馈">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1090" y="407" />
              <mxPoint x="1300" y="407" />
              <mxPoint x="1300" y="225" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 结束连接 -->
        <mxCell id="e-end1" edge="1" parent="1" source="s7" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1490" y="730" />
