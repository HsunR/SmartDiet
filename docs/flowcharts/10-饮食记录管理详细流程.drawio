        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onFoodCardConfirm()&lt;/b&gt;&#xa;收集记录数据&#xa;date/mealType/foods/rating" vertex="1">
