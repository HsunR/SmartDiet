        <mxCell id="a4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;云函数: foodRecord&lt;/b&gt;&#xa;action: 'add'&#xa;数据验证" vertex="1">
