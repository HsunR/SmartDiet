<mxfile host="app.diagrams.net" agent="SmartDiet">
  <diagram id="FoodRecordFlow" name="饮食记录管理详细流程">
    <mxGraphModel dx="2400" dy="2800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4500" pageHeight="3500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 图例 -->
        <mxCell id="legend-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#FFFFFF" value="图例说明" vertex="1">
          <mxGeometry height="30" width="140" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0" value="开始/结束" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-process" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="处理过程" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="135" as="geometry" />
        </mxCell>
        <mxCell id="legend-data" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="数据/输入" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="185" as="geometry" />
        </mxCell>
        <mxCell id="legend-decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="条件判断" vertex="1">
          <mxGeometry height="45" width="100" x="40" y="235" as="geometry" />
        </mxCell>
        <mxCell id="legend-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;fontColor=#6A1B9A" value="数据库" vertex="1">
          <mxGeometry height="40" width="100" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="legend-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="云函数/API" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="360" as="geometry" />
        </mxCell>
        
        <!-- 流程标题 -->
        <mxCell id="flow-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#1976D2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1;fontColor=#FFFFFF" value="饮食记录管理详细流程" vertex="1">
          <mxGeometry height="50" width="400" x="400" y="40" as="geometry" />
        </mxCell>
        
        <!-- 数据结构定义 -->
        <mxCell id="data-def-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#2E7D32" value="【关键数据结构定义】" vertex="1">
          <mxGeometry height="30" width="500" x="950" y="40" as="geometry" />
        </mxCell>
        
        <mxCell id="data-record" parent="1" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E7D32;spacingLeft=10;spacingTop=5" value="&lt;b&gt;FoodRecord 饮食记录结构&lt;/b&gt;&#xa;{&#xa;  _id: string,              // 记录唯一ID&#xa;  _openid: string,          // 用户OpenID&#xa;  date: string,             // 日期 YYYY-MM-DD&#xa;  mealType: string,         // 餐次类型&#xa;    ├─ 'breakfast' 早餐&#xa;    ├─ 'lunch' 午餐&#xa;    ├─ 'dinner' 晚餐&#xa;    └─ 'other' 其他&#xa;  foods: Food[],            // 食物列表&#xa;  totalCalories: number,    // 总卡路里&#xa;  rating: number (1-5),     // 评分&#xa;  imageUrl: string,         // 图片URL&#xa;  cloudFileId: string,      // 云文件ID&#xa;  createdAt: timestamp,     // 创建时间&#xa;  updatedAt: timestamp      // 更新时间&#xa;}" vertex="1">
          <mxGeometry height="260" width="260" x="950" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-food" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=10;spacingTop=5" value="&lt;b&gt;Food 食物结构&lt;/b&gt;&#xa;{&#xa;  id: string,&#xa;  name: string,             // 食物名称&#xa;  category: string,         // 分类&#xa;  totalCalories: number,    // 卡路里&#xa;  estimatedWeight: number,  // 估计重量(g)&#xa;  confidence: number,       // 置信度&#xa;  tags: {&#xa;    positive: string[],&#xa;    warning: string[]&#xa;  },&#xa;  tagReasons: object,&#xa;  advice: string&#xa;}&#xa;&#xa;&lt;b&gt;RecordQuery 查询参数&lt;/b&gt;&#xa;{&#xa;  date?: string,            // 指定日期&#xa;  startDate?: string,       // 开始日期&#xa;  endDate?: string,         // 结束日期&#xa;  mealType?: string,        // 餐次筛选&#xa;  limit?: number,           // 限制条数&#xa;  offset?: number           // 偏移量&#xa;}" vertex="1">
          <mxGeometry height="240" width="240" x="1240" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-cache" parent="1" style="text;html=1;strokeColor=#6A1B9A;fillColor=#E1BEE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#6A1B9A;spacingLeft=10;spacingTop=5" value="&lt;b&gt;RecordCache 记录缓存&lt;/b&gt;&#xa;{&#xa;  key: string,              // 缓存键&#xa;    ├─ 'daily_{date}'      // 每日记录&#xa;    ├─ 'weekly_{week}'     // 每周记录&#xa;    └─ 'history_{range}'   // 历史记录&#xa;  data: FoodRecord[],       // 记录数据&#xa;  timestamp: number,        // 缓存时间&#xa;  expireTime: number        // 过期时间&#xa;}&#xa;&#xa;&lt;b&gt;StorageKeys&lt;/b&gt;&#xa;{&#xa;  REPORT_CACHE: 'report_cache',&#xa;  HISTORY_CACHE: 'history_cache',&#xa;  CACHE_EXPIRE_DAYS: 1&#xa;}" vertex="1">
          <mxGeometry height="180" width="240" x="950" y="365" as="geometry" />
        </mxCell>
        
        <!-- 流程A: 添加记录 -->
        <mxCell id="add-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFF3E0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#E65100" value="【流程A: 添加饮食记录】" vertex="1">
          <mxGeometry height="30" width="220" x="250" y="120" as="geometry" />
        </mxCell>
        
