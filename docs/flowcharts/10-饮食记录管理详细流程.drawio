        <!-- 接口定义 -->
        <mxCell id="api-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#1565C0" value="【接口定义】" vertex="1">
          <mxGeometry height="25" width="100" x="1500" y="120" as="geometry" />
        </mxCell>
        
        <mxCell id="api-def" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=5;spacingTop=3" value="&lt;b&gt;云函数: foodRecord&lt;/b&gt;&#xa;├── action: 'add'&#xa;│   └── 输入: {date, mealType, foods[], rating, imageUrl}&#xa;│   └── 输出: {success, data: {_id, ...}}&#xa;├── action: 'getByDate'&#xa;│   └── 输入: {date}&#xa;│   └── 输出: {success, data: records[]}&#xa;├── action: 'getHistory'&#xa;│   └── 输入: {startDate, endDate}&#xa;│   └── 输出: {success, data: records[]}&#xa;├── action: 'update'&#xa;│   └── 输入: {recordId, ...updates}&#xa;│   └── 输出: {success, message}&#xa;└── action: 'delete'&#xa;    └── 输入: {recordId}&#xa;    └── 输出: {success, message}&#xa;&#xa;&lt;b&gt;API封装 (utils/api.js)&lt;/b&gt;&#xa;├── api.food.addRecord(record)&#xa;├── api.food.getRecords(date)&#xa;├── api.food.getHistory(startDate, endDate)&#xa;├── api.food.updateRecord(recordId, data)&#xa;└── api.food.deleteRecord(recordId)&#xa;&#xa;&lt;b&gt;工具函数&lt;/b&gt;&#xa;├── calculateTotalCalories(foods[])&#xa;├── groupByDate(records[])&#xa;└── filterByMealType(records[], mealType)" vertex="1">
          <mxGeometry height="320" width="320" x="1500" y="160" as="geometry" />
        </mxCell>
        
        <!-- 常量定义 -->
        <mxCell id="const-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFF3E0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#E65100" value="【常量定义】" vertex="1">
          <mxGeometry height="25" width="100" x="1500" y="500" as="geometry" />
        </mxCell>
        
        <mxCell id="const-def" parent="1" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#E65100;spacingLeft=5;spacingTop=3" value="&lt;b&gt;MEAL_TYPES 餐次类型&lt;/b&gt;&#xa;{&#xa;  BREAKFAST: 'breakfast',&#xa;  LUNCH: 'lunch',&#xa;  DINNER: 'dinner',&#xa;  OTHER: 'other'&#xa;}&#xa;&#xa;&lt;b&gt;VALIDATION_RULES 验证规则&lt;/b&gt;&#xa;{&#xa;  date: {required: true},&#xa;  mealType: {required: true},&#xa;  foods: {required: true, type: 'array'},&#xa;  rating: {min: 1, max: 5}&#xa;}&#xa;&#xa;&lt;b&gt;CACHE_CONFIG 缓存配置&lt;/b&gt;&#xa;{&#xa;  REPORT_CACHE_KEY: 'report_cache',&#xa;  HISTORY_CACHE_KEY: 'history_cache',&#xa;  CACHE_EXPIRE_MS: 86400000,  // 1天&#xa;  MAX_HISTORY_DAYS: 30&#xa;}&#xa;&#xa;&lt;b&gt;QUERY_LIMITS 查询限制&lt;/b&gt;&#xa;{&#xa;  DEFAULT_LIMIT: 20,&#xa;  MAX_LIMIT: 100,&#xa;  HISTORY_MAX_LIMIT: 100&#xa;}" vertex="1">
          <mxGeometry height="240" width="280" x="1500" y="540" as="geometry" />
        </mxCell>
        
        <!-- 异常处理 -->
        <mxCell id="exception-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFEBEE;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#C62828" value="【异常处理】" vertex="1">
          <mxGeometry height="25" width="100" x="1500" y="800" as="geometry" />
        </mxCell>
        
        <mxCell id="exception-def" parent="1" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#C62828;spacingLeft=5;spacingTop=3" value="&lt;b&gt;1. 数据验证失败&lt;/b&gt;&#xa;   - 返回具体错误字段&#xa;   - 提示用户补充信息&#xa;&#xa;&lt;b&gt;2. 数据库操作失败&lt;/b&gt;&#xa;   - 记录错误日志&#xa;   - 返回友好错误提示&#xa;   - 建议重试&#xa;&#xa;&lt;b&gt;3. 权限验证失败&lt;/b&gt;&#xa;   - 验证_openid匹配&#xa;   - 无权操作返回403&#xa;&#xa;&lt;b&gt;4. 缓存操作异常&lt;/b&gt;&#xa;   - 缓存失败不影响主流程&#xa;   - 降级直接查询数据库" vertex="1">
          <mxGeometry height="180" width="220" x="1500" y="840" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
