          <mxGeometry x="820" y="250" width="160" height="70" as="geometry" />
        </mxCell>
        
        <!-- 判断是否有历史 -->
        <mxCell id="hasHistory" value="有历史消息?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="840" y="350" width="120" height="80" as="geometry" />
        </mxCell>
        
        <!-- 显示欢迎消息 -->
        <mxCell id="welcomeMsg" value="显示欢迎消息&lt;br/&gt;+ 快捷操作按钮&lt;br/&gt;createTextMessage()&lt;br/&gt;createQuickActionsMessage()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="600" y="360" width="160" height="90" as="geometry" />
        </mxCell>
        
        <!-- 显示历史消息 -->
        <mxCell id="showHistory" value="显示历史消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1040" y="360" width="120" height="60" as="geometry" />
        </mxCell>
        
        <!-- 用户输入 -->
        <mxCell id="userInput" value="用户输入消息&lt;br/&gt;onInputChange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="820" y="480" width="160" height="50" as="geometry" />
        </mxCell>
        
        <!-- 发送消息 -->
        <mxCell id="sendMsg" value="发送消息&lt;br/&gt;sendMessage()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="820" y="560" width="160" height="50" as="geometry" />
        </mxCell>
        
        <!-- 创建用户消息 -->
        <mxCell id="createUserMsg" value="创建用户消息&lt;br/&gt;createTextMessage(USER, content)&lt;br/&gt;添加到消息列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="640" width="160" height="70" as="geometry" />
        </mxCell>
        
        <!-- 调用AI聊天API -->
        <mxCell id="callAI" value="调用AI聊天API&lt;br/&gt;api.chat.send(message, context)&lt;br/&gt;action: 'chat'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="740" width="160" height="70" as="geometry" />
        </mxCell>
        
        <!-- AI网关处理 -->
        <mxCell id="aiGateway" value="AI网关处理&lt;br/&gt;aiGateway/index.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="550" y="745" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- 获取上下文 -->
        <mxCell id="getContext" value="获取对话上下文&lt;br/&gt;• 用户档案&lt;br/&gt;• 最近饮食记录&lt;br/&gt;• 历史消息(最近10条)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="350" y="650" width="140" height="90" as="geometry" />
        </mxCell>
        
        <!-- 构建聊天提示词 -->
        <mxCell id="buildPrompt" value="构建聊天提示词&lt;br/&gt;PROMPT_TEMPLATES.chat&lt;br/&gt;替换上下文变量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="550" width="140" height="70" as="geometry" />
        </mxCell>
        
        <!-- 调用AI服务 -->
        <mxCell id="callAIService" value="调用AI服务&lt;br/&gt;callAIWithSystem()&lt;br/&gt;智谱AI/通义千问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="450" width="140" height="70" as="geometry" />
        </mxCell>
        
        <!-- 提取AI回复 -->
        <mxCell id="extractReply" value="提取AI回复&lt;br/&gt;extractContent()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="350" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- 返回AI回复 -->
        <mxCell id="returnReply" value="返回AI回复&lt;br/&gt;{reply: content}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="550" y="355" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- 创建AI消息 -->
        <mxCell id="createAIMsg" value="创建AI消息&lt;br/&gt;createTextMessage(ASSISTANT, reply)&lt;br/&gt;添加到消息列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="850" width="160" height="70" as="geometry" />
        </mxCell>
        
        <!-- 保存消息 -->
        <mxCell id="saveMsg" value="保存消息到本地&lt;br/&gt;chatService.saveMessages()&lt;br/&gt;Storage: chat_messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="950" width="160" height="70" as="geometry" />
        </mxCell>
        
        <!-- 滚动到底部 -->
        <mxCell id="scrollBottom" value="滚动到底部&lt;br/&gt;scrollToBottom()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="820" y="1050" width="160" height="50" as="geometry" />
        </mxCell>
        
        <!-- 结束节点 -->
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="860" y="1140" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- 数据结构：Message -->
        <mxCell id="msgTitle" value="Message 消息结构" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="msgBox" value="{&lt;br/&gt;  id: String (唯一标识),&lt;br/&gt;  role: String ('user'|'assistant'),&lt;br/&gt;  type: String (消息类型),&lt;br/&gt;  content: String (文本内容),&lt;br/&gt;  data: Object (附加数据),&lt;br/&gt;  timestamp: Number (时间戳)&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;消息类型 (MESSAGE_TYPES)&lt;/b&gt;&lt;br/&gt;• TEXT - 文本消息&lt;br/&gt;• IMAGE - 图片消息&lt;br/&gt;• FOOD_CARD - 食物卡片&lt;br/&gt;• USER_INFO_FORM - 用户信息表单&lt;br/&gt;• FEEDBACK_INPUT - 反馈输入&lt;br/&gt;• QUICK_ACTIONS - 快捷操作&lt;br/&gt;• MEAL_TYPE_SELECT - 餐次选择&lt;br/&gt;• RATING_SELECT - 评分选择&lt;br/&gt;• DATE_SELECT - 日期选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="320" height="380" as="geometry" />
        </mxCell>
        
        <!-- 提示词模板 -->
        <mxCell id="promptTitle" value="AI聊天提示词模板" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="promptBox" value="角色: AI营养师助手&lt;br/&gt;任务: 帮助用户记录饮食、提供建议、解答问题&lt;br/&gt;&lt;br/&gt;上下文变量:&lt;br/&gt;• {userProfile} - 用户档案(年龄/性别/体重/目标等)&lt;br/&gt;• {recentDiet} - 最近3天饮食记录&lt;br/&gt;• {conversationHistory} - 最近10条对话历史&lt;br/&gt;&lt;br/&gt;回复要求:&lt;br/&gt;• 温暖专业的语气&lt;br/&gt;• 简洁明了的回复&lt;br/&gt;• 直接回复，无需JSON格式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="560" width="320" height="220" as="geometry" />
        </mxCell>
        
        <!-- 上下文数据获取 -->
        <mxCell id="contextTitle" value="上下文数据获取" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="800" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="contextBox" value="&lt;b&gt;getUserProfile()&lt;/b&gt;&lt;br/&gt;db.collection('users').where({openid}).get()&lt;br/&gt;&lt;br/&gt;&lt;b&gt;getRecentDiet()&lt;/b&gt;&lt;br/&gt;db.collection('food_records')&lt;br/&gt;  .where({openid, date: &gt;= 3天前})&lt;br/&gt;  .orderBy('date', 'desc')&lt;br/&gt;  .limit(10)&lt;br/&gt;  .field({totalCalories, foods})&lt;br/&gt;  .get()&lt;br/&gt;&lt;br/&gt;计算:&lt;br/&gt;• mealCount - 用餐次数&lt;br/&gt;• avgCalories - 平均热量&lt;br/&gt;• recentFoods - 最近食物(去重)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="840" width="320" height="240" as="geometry" />
        </mxCell>
        
        <!-- API接口 -->
        <mxCell id="apiTitle" value="API接口定义" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1100" y="80" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="apiBox" value="&lt;b&gt;发送聊天消息&lt;/b&gt;&lt;br/&gt;api.chat.send(message, context)&lt;br/&gt;→ cloud.callFunction('aiGateway', {&lt;br/&gt;    action: 'chat',&lt;br/&gt;    data: {message, context}&lt;br/&gt;  })&lt;br/&gt;&lt;br/&gt;&lt;b&gt;返回格式&lt;/b&gt;&lt;br/&gt;{&lt;br/&gt;  success: Boolean,&lt;br/&gt;  data: {&lt;br/&gt;    reply: String&lt;br/&gt;  }&lt;br/&gt;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1100" y="120" width="280" height="180" as="geometry" />
        </mxCell>
        
        <!-- 异常处理 -->
        <mxCell id="errorTitle" value="异常处理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1100" y="320" width="100" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="errorBox" value="1. 网络超时&lt;br/&gt;   → 显示'网络异常，请稍后再试'&lt;br/&gt;&lt;br/&gt;2. AI服务异常&lt;br/&gt;   → 显示'AI回复失败，请稍后重试'&lt;br/&gt;&lt;br/&gt;3. 空消息处理&lt;br/&gt;   → 不发送空消息&lt;br/&gt;&lt;br/&gt;4. 消息加载失败&lt;br/&gt;   → 初始化新的欢迎消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1100" y="360" width="280" height="180" as="geometry" />
        </mxCell>
        
        <!-- 示例数据交互 -->
        <mxCell id="exampleTitle" value="示例数据交互" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1100" y="560" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="exampleBox" value="&lt;b&gt;【场景】用户咨询今日饮食建议&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. 用户发送消息&lt;/b&gt;&lt;br/&gt;内容: '我今天午餐吃了680千卡，晚上该吃什么？'&lt;br/&gt;消息对象: {id:'msg_001', role:'user', type:'TEXT', content:'...', timestamp:1714204800}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. 调用AI聊天API&lt;/b&gt;&lt;br/&gt;cloud.callFunction('aiGateway', {&lt;br/&gt;  action: 'chat',&lt;br/&gt;  data: {&lt;br/&gt;    message: '我今天午餐吃了680千卡，晚上该吃什么？',&lt;br/&gt;    context: {&lt;br/&gt;      userProfile: {age:28, gender:1, weight:70, goal:'lose_weight', targetCalories:2069},&lt;br/&gt;      recentDiet: {&lt;br/&gt;        mealCount: 2,&lt;br/&gt;        totalCalories: 1250,&lt;br/&gt;        remainingCalories: 819&lt;br/&gt;      },&lt;br/&gt;      history: [msg_001]&lt;br/&gt;    }&lt;br/&gt;  }&lt;br/&gt;})&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. AI网关构建提示词&lt;/b&gt;&lt;br/&gt;系统提示: '你是AI营养师助手，用户档案：28岁男性...今日已摄入1250千卡，剩余819千卡...'&lt;br/&gt;用户消息: '我今天午餐吃了680千卡，晚上该吃什么？'&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4. AI服务返回&lt;/b&gt;&lt;br/&gt;回复内容: '根据您今天的摄入情况，建议您晚餐控制在500-600千卡左右。推荐搭配：清蒸鱼（150g，约180千卡）+ 蒜蓉西兰花（200g，约100千卡）+ 杂粮饭（150g，约200千卡），这样既能保证营养均衡，又不会超标哦！'&lt;br/&gt;&lt;br/&gt;&lt;b&gt;5. 前端处理结果&lt;/b&gt;&lt;br/&gt;• 创建AI消息: {id:'msg_002', role:'assistant', type:'TEXT', content:'...', timestamp:1714204815}&lt;br/&gt;• 保存到本地存储: chat_messages&lt;br/&gt;• 滚动到底部显示新消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4f8;strokeColor=#4a90e2;fontSize=10;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1100" y="600" width="480" height="460" as="geometry" />
        </mxCell>
        
        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="start" target="initChat">
