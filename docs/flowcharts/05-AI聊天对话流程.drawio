          <mxGeometry x="860" y="80" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- 初始化聊天 -->
        <mxCell id="initChat" value="初始化聊天&lt;br/&gt;initChat()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="160" height="60" as="geometry" />
