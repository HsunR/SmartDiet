        </mxCell>
        
        <mxCell id="calc-target" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;calculateTargets()&lt;/b&gt;&#xa;计算营养目标&#xa;BMR → TDEE → 目标卡路里" vertex="1">
          <mxGeometry height="70" width="140" x="330" y="1100" as="geometry" />
        </mxCell>
        
        <mxCell id="update-api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;api.user.updateProfile()&lt;/b&gt;&#xa;提交档案数据" vertex="1">
          <mxGeometry height="50" width="150" x="325" y="1200" as="geometry" />
        </mxCell>
        
        <mxCell id="update-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: users&lt;/b&gt;&#xa;更新用户档案&#xa;set: profile + updatedAt" vertex="1">
          <mxGeometry height="60" width="130" x="335" y="1280" as="geometry" />
        </mxCell>
        
        <mxCell id="save-local" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;wx.setStorageSync()&lt;/b&gt;&#xa;保存本地缓存&#xa;hasCompletedOnboarding: true" vertex="1">
          <mxGeometry height="60" width="150" x="325" y="1380" as="geometry" />
        </mxCell>
        
        <mxCell id="goto-chat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="&lt;b&gt;页面跳转&lt;/b&gt;&#xa;wx.switchTab()&#xa;/pages/chat/index" vertex="1">
          <mxGeometry height="60" width="150" x="325" y="1470" as="geometry" />
        </mxCell>
        
        <mxCell id="a-end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0;fontStyle=1" value="结束&#xa;进入主界面" vertex="1">
          <mxGeometry height="45" width="100" x="350" y="1570" as="geometry" />
        </mxCell>
        
        <!-- 流程B: 个人中心档案管理 -->
        <mxCell id="profile-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#2E7D32" value="【流程B: 个人中心档案管理】" vertex="1">
          <mxGeometry height="30" width="280" x="1050" y="650" as="geometry" />
        </mxCell>
        
        <mxCell id="b-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0;fontStyle=1" value="开始&#xa;进入个人中心" vertex="1">
          <mxGeometry height="45" width="100" x="1140" y="700" as="geometry" />
        </mxCell>
        
        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;profile.onLoad()&lt;/b&gt;&#xa;页面初始化" vertex="1">
          <mxGeometry height="50" width="140" x="1120" y="780" as="geometry" />
        </mxCell>
        
        <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;profile.onShow()&lt;/b&gt;&#xa;加载用户档案和统计" vertex="1">
          <mxGeometry height="50" width="140" x="1120" y="860" as="geometry" />
        </mxCell>
        
        <mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;loadUserProfile()&lt;/b&gt;&#xa;加载用户档案" vertex="1">
          <mxGeometry height="50" width="140" x="1120" y="940" as="geometry" />
        </mxCell>
        
        <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;api.user.getProfile()&lt;/b&gt;&#xa;获取档案数据" vertex="1">
          <mxGeometry height="50" width="140" x="1120" y="1020" as="geometry" />
        </mxCell>
        
        <mxCell id="b5" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: users&lt;/b&gt;&#xa;查询用户档案" vertex="1">
          <mxGeometry height="50" width="120" x="1130" y="1100" as="geometry" />
        </mxCell>
        
        <mxCell id="b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;updateSelections()&lt;/b&gt;&#xa;更新选择器索引&#xa;计算营养目标显示" vertex="1">
          <mxGeometry height="60" width="140" x="1120" y="1180" as="geometry" />
        </mxCell>
        
        <mxCell id="b7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;loadUserStats()&lt;/b&gt;&#xa;加载用户统计数据" vertex="1">
          <mxGeometry height="50" width="140" x="1120" y="1270" as="geometry" />
        </mxCell>
        
        <mxCell id="b8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;api.food.getHistory()&lt;/b&gt;&#xa;获取30天历史记录" vertex="1">
          <mxGeometry height="50" width="140" x="1120" y="1350" as="geometry" />
        </mxCell>
        
        <mxCell id="b9" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: food_records&lt;/b&gt;&#xa;查询历史记录" vertex="1">
          <mxGeometry height="50" width="120" x="1130" y="1430" as="geometry" />
