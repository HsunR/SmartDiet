<mxfile host="app.diagrams.net" agent="SmartDiet">
  <diagram id="UserProfileFlow" name="用户档案管理详细流程">
    <mxGraphModel dx="2200" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 图例 -->
        <mxCell id="legend-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#FFFFFF" value="图例说明" vertex="1">
          <mxGeometry height="30" width="140" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0" value="开始/结束" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-process" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="处理过程" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="135" as="geometry" />
        </mxCell>
        <mxCell id="legend-data" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="数据/输入" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="185" as="geometry" />
        </mxCell>
        <mxCell id="legend-decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="条件判断" vertex="1">
          <mxGeometry height="45" width="100" x="40" y="235" as="geometry" />
        </mxCell>
        <mxCell id="legend-db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;fontColor=#6A1B9A" value="数据库" vertex="1">
          <mxGeometry height="40" width="100" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="legend-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="云函数/API" vertex="1">
          <mxGeometry height="35" width="100" x="40" y="360" as="geometry" />
        </mxCell>
        
        <!-- 流程标题 -->
        <mxCell id="flow-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#1976D2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1;fontColor=#FFFFFF" value="用户档案管理详细流程" vertex="1">
          <mxGeometry height="50" width="400" x="400" y="40" as="geometry" />
        </mxCell>
        
        <!-- 数据结构定义 -->
        <mxCell id="data-def-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#2E7D32" value="【关键数据结构定义】" vertex="1">
          <mxGeometry height="30" width="500" x="900" y="40" as="geometry" />
        </mxCell>
        
        <mxCell id="data-profile" parent="1" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E7D32;spacingLeft=10;spacingTop=5" value="&lt;b&gt;Profile 用户档案数据结构&lt;/b&gt;&#xa;{&#xa;  nickname: string,           // 昵称&#xa;  avatar: string,             // 头像URL&#xa;  gender: number (0/1/2),     // 性别&#xa;  age: number (10-100),       // 年龄&#xa;  height: number (100-250),   // 身高cm&#xa;  weight: number (30-200),    // 体重kg&#xa;  activityLevel: number,      // 活动水平 1-5&#xa;    ├─ 1: 久坐 (1.2)&#xa;    ├─ 2: 轻度活动 (1.375)&#xa;    ├─ 3: 中度活动 (1.55)&#xa;    ├─ 4: 高度活动 (1.725)&#xa;    └─ 5: 极高活动 (1.9)&#xa;  goal: string,               // 健康目标&#xa;    ├─ 'lose_weight'  减脂&#xa;    ├─ 'maintain'     维持&#xa;    ├─ 'gain_muscle'  增肌&#xa;    ├─ 'control_sugar' 控糖&#xa;    └─ 'control_bp'   控血压&#xa;  preferences: string[],      // 饮食偏好[]&#xa;  allergies: string[]         // 过敏食物[]&#xa;}" vertex="1">
          <mxGeometry height="340" width="280" x="900" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-targets" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1565C0;spacingLeft=10;spacingTop=5" value="&lt;b&gt;NutritionTargets 营养目标&lt;/b&gt;&#xa;{&#xa;  calories: number,      // 目标卡路里&#xa;  protein: number,       // 蛋白质(g)&#xa;  fat: number,           // 脂肪(g)&#xa;  carbohydrate: number   // 碳水(g)&#xa;}&#xa;&#xa;&lt;b&gt;计算公式&lt;/b&gt;&#xa;BMR (基础代谢):&#xa;  男: 10×weight + 6.25×height&#xa;      - 5×age + 5&#xa;  女: 10×weight + 6.25×height&#xa;      - 5×age - 161&#xa;&#xa;TDEE (每日消耗):&#xa;  BMR × activityLevel&#xa;&#xa;目标卡路里:&#xa;  lose_weight: TDEE × 0.8&#xa;  gain_muscle: TDEE × 1.15&#xa;  maintain: TDEE" vertex="1">
          <mxGeometry height="280" width="260" x="1210" y="85" as="geometry" />
        </mxCell>
        
        <mxCell id="data-stats" parent="1" style="text;html=1;strokeColor=#6A1B9A;fillColor=#E1BEE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#6A1B9A;spacingLeft=10;spacingTop=5" value="&lt;b&gt;UserStats 用户统计数据&lt;/b&gt;&#xa;{&#xa;  streakDays: number,        // 连续记录天数&#xa;  totalRecords: number,      // 总记录数&#xa;  avgCalories: number,       // 平均卡路里&#xa;  weeklyData: array          // 本周数据&#xa;}&#xa;&#xa;&lt;b&gt;连续天数计算逻辑&lt;/b&gt;&#xa;1. 获取最近30天记录&#xa;2. 按日期去重&#xa;3. 从昨天开始倒序检查&#xa;4. 统计连续有记录的日期&#xa;5. 今天有记录则+1" vertex="1">
          <mxGeometry height="180" width="240" x="900" y="445" as="geometry" />
        </mxCell>
        
        <!-- 主流程: Onboarding引导流程 -->
        <mxCell id="onboarding-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFF3E0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#E65100" value="【流程A: 新用户引导 (Onboarding)】" vertex="1">
          <mxGeometry height="30" width="300" x="250" y="120" as="geometry" />
        </mxCell>
        
        <mxCell id="a-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#1565C0;fontStyle=1" value="开始&#xa;跳转至引导页" vertex="1">
          <mxGeometry height="45" width="100" x="350" y="170" as="geometry" />
        </mxCell>
        
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onboarding.onLoad()&lt;/b&gt;&#xa;初始化页面数据&#xa;currentStep: 0" vertex="1">
          <mxGeometry height="60" width="150" x="325" y="250" as="geometry" />
        </mxCell>
        
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;api.user.getProfile()&lt;/b&gt;&#xa;获取已有档案数据" vertex="1">
          <mxGeometry height="50" width="150" x="325" y="340" as="geometry" />
        </mxCell>
        
        <mxCell id="a3" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#6A1B9A" value="&lt;b&gt;数据库: users&lt;/b&gt;&#xa;查询用户档案" vertex="1">
          <mxGeometry height="50" width="120" x="340" y="420" as="geometry" />
        </mxCell>
        
        <mxCell id="a4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;初始化表单数据&lt;/b&gt;&#xa;合并已有数据与默认值&#xa;渲染第一步: 性别选择" vertex="1">
          <mxGeometry height="60" width="150" x="325" y="500" as="geometry" />
        </mxCell>
        
        <!-- 步骤1: 性别选择 -->
        <mxCell id="step1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#1565C0" value="步骤1: 性别选择" vertex="1">
          <mxGeometry height="25" width="130" x="200" y="590" as="geometry" />
        </mxCell>
        
        <mxCell id="s1-1" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户交互&lt;/b&gt;&#xa;点击性别选项&#xa;男 / 女" vertex="1">
          <mxGeometry height="55" width="120" x="205" y="630" as="geometry" />
        </mxCell>
        
        <mxCell id="s1-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onGenderSelect()&lt;/b&gt;&#xa;gender: 1(男) / 2(女)&#xa;更新表单状态" vertex="1">
          <mxGeometry height="60" width="130" x="200" y="710" as="geometry" />
        </mxCell>
        
        <!-- 步骤2: 基础信息 -->
        <mxCell id="step2-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#1565C0" value="步骤2: 基础信息" vertex="1">
          <mxGeometry height="25" width="130" x="380" y="590" as="geometry" />
        </mxCell>
        
        <mxCell id="s2-1" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户交互&lt;/b&gt;&#xa;滑动滑块调整&#xa;年龄 / 身高 / 体重" vertex="1">
          <mxGeometry height="55" width="120" x="385" y="630" as="geometry" />
        </mxCell>
        
        <mxCell id="s2-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onSliderChange()&lt;/b&gt;&#xa;实时更新数值&#xa;age: 10-100&#xa;height: 100-250cm&#xa;weight: 30-200kg" vertex="1">
          <mxGeometry height="80" width="130" x="380" y="710" as="geometry" />
        </mxCell>
        
        <!-- 步骤3: 活动水平 -->
        <mxCell id="step3-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#1565C0" value="步骤3: 活动水平" vertex="1">
          <mxGeometry height="25" width="130" x="560" y="590" as="geometry" />
        </mxCell>
        
        <mxCell id="s3-1" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户交互&lt;/b&gt;&#xa;选择活动水平&#xa;1-5级选项" vertex="1">
          <mxGeometry height="55" width="120" x="565" y="630" as="geometry" />
        </mxCell>
        
        <mxCell id="s3-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onActivitySelect()&lt;/b&gt;&#xa;activityLevel: 1-5&#xa;影响TDEE计算系数" vertex="1">
          <mxGeometry height="60" width="130" x="560" y="710" as="geometry" />
        </mxCell>
        
        <!-- 步骤4: 健康目标 -->
        <mxCell id="step4-title" parent="1" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#1565C0" value="步骤4: 健康目标" vertex="1">
          <mxGeometry height="25" width="130" x="740" y="590" as="geometry" />
        </mxCell>
        
        <mxCell id="s4-1" parent="1" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32" value="&lt;b&gt;用户交互&lt;/b&gt;&#xa;选择健康目标&#xa;减脂/维持/增肌/控糖" vertex="1">
          <mxGeometry height="55" width="120" x="745" y="630" as="geometry" />
        </mxCell>
        
        <mxCell id="s4-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onGoalSelect()&lt;/b&gt;&#xa;goal: string&#xa;影响目标卡路里计算" vertex="1">
          <mxGeometry height="60" width="130" x="740" y="710" as="geometry" />
        </mxCell>
        
        <!-- 步骤控制 -->
        <mxCell id="step-ctrl" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#D84315;fontSize=11;fontColor=#D84315" value="是否&#xa;最后一步?" vertex="1">
          <mxGeometry height="60" width="100" x="350" y="830" as="geometry" />
        </mxCell>
        
        <mxCell id="next-step" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onNextStep()&lt;/b&gt;&#xa;currentStep++&#xa;显示下一步" vertex="1">
          <mxGeometry height="60" width="120" x="200" y="920" as="geometry" />
        </mxCell>
        
        <mxCell id="prev-step" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;onPrevStep()&lt;/b&gt;&#xa;currentStep--&#xa;返回上一步" vertex="1">
          <mxGeometry height="60" width="120" x="500" y="920" as="geometry" />
        </mxCell>
        
        <!-- 保存档案 -->
        <mxCell id="save-profile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontColor=#F57F17" value="&lt;b&gt;saveProfile()&lt;/b&gt;&#xa;收集所有表单数据" vertex="1">
