.history-container {
  min-height: 100vh;
  background-color: #FAFAFA;
}

.filter-bar {
  padding: 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.filter-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 32rpx;
  background-color: #F5F5F5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #212121;
}

.filter-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #757575;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E8F5E9;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 32rpx;
  border: none;
}

.records-list {
  height: calc(100vh - 120rpx);
}

.date-group {
  margin-bottom: 24rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
}

.group-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
}

.group-calories {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
}

.record-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #F5F5F5;
}

.record-placeholder {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #E8F5E9;
  border-radius: 12rpx;
  margin-right: 24rpx;
  font-size: 40rpx;
}

.record-content {
  flex: 1;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-meal {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

.record-time {
  font-size: 22rpx;
  color: #BDBDBD;
}

.record-foods {
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-nutrients {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.nutrient-tag {
  font-size: 22rpx;
  color: #757575;
  padding: 4rpx 12rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
}

.record-arrow {
  font-size: 32rpx;
  color: #BDBDBD;
  margin-left: 16rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #757575;
}

.loading-spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #E8F5E9;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #BDBDBD;
}

.date-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.date-picker-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  z-index: 101;
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #757575;
}

.popup-content {
  padding: 24rpx;
}

.date-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.field-label {
  font-size: 28rpx;
  color: #212121;
}

.field-value {
  font-size: 28rpx;
  color: #4CAF50;
  padding: 8rpx 24rpx;
  background-color: #E8F5E9;
  border-radius: 16rpx;
}

.popup-footer {
  display: flex;
  padding: 24rpx;
  border-top: 1rpx solid #EEEEEE;
}

.popup-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  margin: 0 8rpx;
  border: none;
}

.popup-btn.cancel {
  background-color: #F5F5F5;
  color: #757575;
}

.popup-btn.confirm {
  background-color: #4CAF50;
  color: #FFFFFF;
}
