<view class="settings-container">
  <view class="user-section" wx:if="{{hasLogin && userInfo}}">
    <view class="user-card">
      <image 
        wx:if="{{userInfo.avatarUrl}}"
        src="{{userInfo.avatarUrl}}" 
        class="user-avatar"
        mode="aspectFill"
      ></image>
      <view class="user-avatar-placeholder" wx:else>
        <text>👤</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '用户'}}</text>
        <text class="user-id">已登录</text>
      </view>
    </view>
  </view>
  
  <view class="settings-section">
    <view class="section-header">
      <text class="section-title">🔔 通知设置</text>
    </view>
    
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">🔔</text>
        <view class="setting-content">
          <text class="setting-label">消息通知</text>
          <text class="setting-desc">接收饮食提醒和健康建议</text>
        </view>
      </view>
      <switch 
        checked="{{settings.notification}}" 
        color="#4CAF50"
        bindchange="onNotificationChange"
      />
    </view>
    
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">⏰</text>
        <view class="setting-content">
          <text class="setting-label">每日提醒</text>
          <text class="setting-desc">定时提醒记录饮食</text>
        </view>
      </view>
      <switch 
        checked="{{settings.reminder}}" 
        color="#4CAF50"
        bindchange="onReminderChange"
      />
    </view>
    
    <view class="setting-item" wx:if="{{settings.reminder}}">
      <view class="setting-left">
        <text class="setting-icon">🕐</text>
        <view class="setting-content">
          <text class="setting-label">提醒时间</text>
        </view>
      </view>
      <picker mode="time" value="{{settings.reminderTime}}" bindchange="onReminderTimeChange">
        <view class="setting-value">
          <text>{{reminderTimeDisplay}}</text>
          <text class="value-arrow">›</text>
        </view>
      </picker>
    </view>
    
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">🔊</text>
        <view class="setting-content">
          <text class="setting-label">声音提示</text>
          <text class="setting-desc">操作时播放提示音</text>
        </view>
      </view>
      <switch 
        checked="{{settings.soundEnabled}}" 
        color="#4CAF50"
        bindchange="onSoundChange"
      />
    </view>
    
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">📳</text>
        <view class="setting-content">
          <text class="setting-label">震动反馈</text>
          <text class="setting-desc">操作时震动提示</text>
        </view>
      </view>
      <switch 
        checked="{{settings.vibrationEnabled}}" 
        color="#4CAF50"
        bindchange="onVibrationChange"
      />
    </view>
  </view>
  
  <view class="settings-section">
    <view class="section-header">
      <text class="section-title">💾 数据管理</text>
    </view>
    
    <view class="setting-item" bindtap="clearCache">
      <view class="setting-left">
        <text class="setting-icon">🗑️</text>
        <view class="setting-content">
          <text class="setting-label">清除缓存</text>
          <text class="setting-desc">当前缓存：{{cacheSize}}</text>
        </view>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    
    <view class="setting-item" bindtap="exportData">
      <view class="setting-left">
        <text class="setting-icon">📤</text>
        <view class="setting-content">
          <text class="setting-label">导出数据</text>
          <text class="setting-desc">导出您的饮食记录</text>
        </view>
      </view>
      <text class="setting-arrow">›</text>
    </view>
  </view>
  
  <view class="settings-section">
    <view class="section-header">
      <text class="section-title">ℹ️ 其他</text>
    </view>
    
    <view class="setting-item" bindtap="showFeedback">
      <view class="setting-left">
        <text class="setting-icon">💬</text>
        <view class="setting-content">
          <text class="setting-label">意见反馈</text>
          <text class="setting-desc">帮助我们改进产品</text>
        </view>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    
    <view class="setting-item" bindtap="showAbout">
      <view class="setting-left">
        <text class="setting-icon">ℹ️</text>
        <view class="setting-content">
          <text class="setting-label">关于我们</text>
          <text class="setting-desc">版本 {{version}}</text>
        </view>
      </view>
      <text class="setting-arrow">›</text>
    </view>
  </view>
  
  <view class="logout-section" wx:if="{{hasLogin}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
