.settings-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.settings-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.section-header {
  padding: 24rpx 32rpx 16rpx;
}

.section-title {
  font-size: 26rpx;
  color: #757575;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 4rpx;
}

.setting-desc {
  display: block;
  font-size: 24rpx;
  color: #BDBDBD;
}

.setting-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #212121;
}

.arrow {
  margin-left: 8rpx;
  color: #BDBDBD;
  font-size: 32rpx;
}

.logout-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background-color: #FFFFFF;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #FFFFFF;
  color: #F44336;
  font-size: 32rpx;
  border: 2rpx solid #F44336;
  border-radius: 44rpx;
}
