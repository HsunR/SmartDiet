/* 设置页面样式表 */

/**
 * 设置容器
 * 使用浅灰色背景，底部预留空间防止被底部按钮遮挡
 */
.settings-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/**
 * 用户信息区域
 */
.user-section {
  margin-bottom: 24rpx;
}

/**
 * 用户信息卡片
 * 白色背景，圆角设计，带轻微阴影
 */
.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/**
 * 用户头像
 * 圆形图片，浅绿色背景
 */
.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #E8F5E9;
}

/**
 * 用户头像占位符
 * 当用户未上传头像时显示的默认图标容器
 */
.user-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #E8F5E9;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
}

/**
 * 用户信息文本区域
 * 垂直排列用户名和用户状态
 */
.user-info {
  display: flex;
  flex-direction: column;
}

/**
 * 用户名称
 * 加粗显示，深色字体
 */
.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
  margin-bottom: 8rpx;
}

/**
 * 用户 ID/状态
 * 较小字体，灰色显示
 */
.user-id {
  font-size: 24rpx;
  color: #757575;
}

/**
 * 设置项分组
 * 白色卡片式设计，圆角带阴影
 */
.settings-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/**
 * 区域标题栏
 */
.section-header {
  padding: 24rpx 32rpx 16rpx;
}

/**
 * 区域标题文本
 * 较小字体，灰色显示
 */
.section-title {
  font-size: 26rpx;
  color: #757575;
  font-weight: 500;
}

/**
 * 单个设置项
 * 弹性布局，底部边框分隔
 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

/**
 * 最后一个设置项去除底部边框
 */
.setting-item:last-child {
  border-bottom: none;
}

/**
 * 设置项左侧区域（图标 + 文本）
 */
.setting-left {
  display: flex;
  align-items: center;
  flex: 1;
}

/**
 * 设置项图标
 */
.setting-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

/**
 * 设置项文本内容区域
 * 垂直排列标签和描述
 */
.setting-content {
  display: flex;
  flex-direction: column;
}

/**
 * 设置项标签
 * 主要文本，深色显示
 */
.setting-label {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 4rpx;
}

/**
 * 设置项描述
 * 辅助说明文本，浅灰色
 */
.setting-desc {
  display: block;
  font-size: 24rpx;
  color: #BDBDBD;
}

/**
 * 设置项值显示区域
 * 用于显示时间等可选项
 */
.setting-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #616161;
}

/**
 * 值箭头图标
 */
.value-arrow {
  margin-left: 8rpx;
  color: #BDBDBD;
  font-size: 32rpx;
}

/**
 * 设置项右侧箭头
 */
.setting-arrow {
  color: #BDBDBD;
  font-size: 32rpx;
}

/**
 * 退出登录区域
 * 固定在页面底部，白色背景带阴影
 */
.logout-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/**
 * 退出登录按钮
 * 红色边框和文字，圆角设计
 */
.logout-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #FFFFFF;
  color: #F44336;
  font-size: 32rpx;
  border: 2rpx solid #F44336;
  border-radius: 44rpx;
}

/**
 * 移除按钮默认边框
 */
.logout-btn::after {
  border: none;
}
