<!-- 
  ================================================================
  饮食报告页面 - 展示本周饮食统计和趋势分析
  功能模块：
    1. 日期导航（切换周次）
    2. 日历视图（餐次 × 日期网格）
    3. 热量趋势图表
    4. 详情弹窗（查看/编辑记录）
  ================================================================ 
-->
<wxs src="../../utils/utils.wxs" module="utils" />

<!-- 饮食报告页面 - 展示本周饮食统计和趋势分析 -->
<view class="report-container">
  <!-- 顶部日期导航栏 -->
  <view class="date-header">
    <!-- 上一周按钮 -->
    <view class="date-nav" bindtap="onPrevWeek">
      <text>‹</text>
    </view>
    <!-- 当前周日期范围选择器 -->
    <picker mode="date" value="{{currentDate}}" bindchange="onDateChange">
      <view class="date-picker">
        <text class="date-text">{{weekRange}}</text>
        <text class="date-arrow">▼</text>
      </view>
    </picker>
    <!-- 下一周按钮 -->
    <view class="date-nav" bindtap="onNextWeek">
      <text>›</text>
    </view>
  </view>
  
  <!-- 加载状态提示 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
  
  <!-- 日历表格视图 -->
  <view wx:else class="calendar-wrapper">
    <view class="calendar-table">
      <!-- 横向滚动容器 -->
      <scroll-view 
        class="calendar-scroll" 
        scroll-x 
        scroll-left="{{scrollLeft}}"
        enhanced
        show-scrollbar="{{false}}"
        bounces="{{false}}"
      >
        <view class="calendar-content">
          <!-- 日历表头：餐次类型 + 七天日期 -->
          <view class="calendar-header">
            <view class="header-cell meal-type-header">餐次</view>
            <view class="header-days">
              <!-- 遍历星期 -->
              <view class="header-cell day-cell {{item.isToday ? 'today' : ''}}" wx:for="{{weekDays}}" wx:key="date">
                <text class="day-name">{{item.dayName}}</text>
                <text class="day-date">{{item.dayNum}}</text>
              </view>
            </view>
          </view>
          
          <!-- 日历主体：餐次行 × 日期列 -->
          <view class="calendar-body">
            <!-- 遍历餐次类型（早餐、午餐、晚餐、其他） -->
            <view class="calendar-row" wx:for="{{mealTypes}}" wx:key="type">
              <!-- 餐次标签 -->
              <view class="meal-type-cell">
                <text class="meal-icon">{{item.icon}}</text>
                <text class="meal-label">{{item.label}}</text>
              </view>
              
              <!-- 日期单元格行 -->
              <view class="cells-row">
                <!-- 遍历日期 -->
                <view 
                  class="calendar-cell {{day.isToday ? 'today-cell' : ''}}" 
                  wx:for="{{weekDays}}" 
                  wx:for-item="day"
                  wx:key="date"
                  data-date="{{day.date}}"
                  data-meal="{{item.type}}"
                  bindtap="onCellTap"
                >
                  <!-- 有记录时显示内容 -->
                  <view wx:if="{{calendarData[day.date][item.type].length > 0}}" class="cell-content">
                    <!-- 多条记录使用轮播 -->
                    <swiper 
                      wx:if="{{calendarData[day.date][item.type].length > 1}}"
                      class="cell-swiper"
                      autoplay="{{true}}"
                      interval="{{3000}}"
                      duration="{{500}}"
                      circular="{{true}}"
                      indicator-dots="{{false}}"
                    >
                      <swiper-item wx:for="{{calendarData[day.date][item.type]}}" wx:for-item="record" wx:key="_id">
                        <view class="swiper-record">
                          <!-- 食物图片 -->
                          <image 
                            wx:if="{{record.imageUrl}}" 
                            src="{{record.imageUrl}}" 
                            class="cell-image"
                            mode="aspectFill"
                          ></image>
                          <!-- 食物名称列表 -->
                          <view class="cell-foods">
                            <text class="food-name" wx:for="{{record.foods}}" wx:for-item="food" wx:key="name">{{food.name}}</text>
                          </view>
                          <!-- 分数与评分 -->
                          <view class="cell-score-row">
                            <text class="cell-score">{{record.mealOverview.overallHealthScore}}分</text>
                            <text class="rating-stars" wx:if="{{record.rating !== undefined}}">{{utils.getRatingStars(record.rating)}}</text>
                          </view>
                          <!-- 健康标签 -->
                          <view class="cell-tags">
                            <text class="tag-positive" wx:for="{{record.healthTags.positive || []}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                            <text class="tag-warning" wx:for="{{record.healthTags.warning || []}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                          </view>
                        </view>
                      </swiper-item>
                    </swiper>
                    
                    <!-- 单条记录直接显示 -->
                    <view wx:else class="single-record">
                      <image 
                        wx:if="{{calendarData[day.date][item.type][0].imageUrl}}" 
                        src="{{calendarData[day.date][item.type][0].imageUrl}}" 
                        class="cell-image"
                        mode="aspectFill"
                      ></image>
                      <view class="cell-foods">
                        <text class="food-name" wx:for="{{calendarData[day.date][item.type][0].foods}}" wx:for-item="food" wx:key="name">{{food.name}}</text>
                      </view>
                      <!-- 分数与评分 -->
                      <view class="cell-score-row">
                        <text class="cell-score">{{calendarData[day.date][item.type][0].mealOverview.overallHealthScore}}分</text>
                        <text class="rating-stars" wx:if="{{calendarData[day.date][item.type][0].rating !== undefined}}">{{utils.getRatingStars(calendarData[day.date][item.type][0].rating)}}</text>
                      </view>
                      <view class="cell-tags">
                        <text class="tag-positive" wx:for="{{calendarData[day.date][item.type][0].healthTags.positive || []}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                        <text class="tag-warning" wx:for="{{calendarData[day.date][item.type][0].healthTags.warning || []}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                      </view>
                    </view>
                    
                    <!-- 记录数量提示 -->
                    <view wx:if="{{calendarData[day.date][item.type].length > 1}}" class="record-count">
                      <text class="text">{{calendarData[day.date][item.type].length}}条</text>
                    </view>
                  </view>
                  <!-- 无记录显示空状态 -->
                  <view wx:else class="cell-empty">
                    <text class="empty-icon">+</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  
  <!-- 
    ============================================
    本周营养报告区域
    展示本周饮食统计摘要和热量趋势图
    ============================================ 
  -->
  <view class="weekly-report-section">
    <!-- 报告标题 -->
    <view class="report-header">
      <view class="header-content">
        <text class="report-title">📊 本周营养报告</text>
        <text class="report-subtitle">{{weekRange}}</text>
      </view>
    </view>
    
    <!-- 热量趋势图表 -->
      <!-- 
        ============================================
        热量趋势图表
        使用纯 CSS 实现的折线图，展示每日餐均热量变化
        组成：
          - Y 轴：热量刻度标签
          - 图表区：网格线 + 数据点 + 线段
          - X 轴：星期标签
        ============================================ 
      -->
      <view class="report-chart-section">
      <view class="chart-header">
        <text class="chart-title">📈 每周每餐平均分</text>
      </view>
        <!-- 图表容器：Y 轴 + 图表区 -->
        <view class="chart-container">
          <!-- Y 轴标签：显示 100、50、0 分 -->
          <view class="chart-y-axis">
          <text class="y-label">100</text>
          <text class="y-label">50</text>
          <text class="y-label">0</text>
        </view>
        <!-- 图表区域 -->
          <!-- 图表区域：包含网格线、折线图、X 轴标签 -->
          <view class="chart-area">
            <!-- 背景网格线（3 条水平线） -->
            <view class="chart-grid">
              <view class="grid-line"></view>
              <view class="grid-line"></view>
              <view class="grid-line"></view>
            </view>
            <!-- 折线图包装器：数据点 + 线段 -->
            <view class="chart-line-wrapper">
              <!-- 数据点容器 -->
              <view class="chart-line-points">
              <view class="line-point {{item.isToday ? 'today' : ''}} {{item.score > 0 ? 'has-data' : 'no-data'}}" wx:for="{{weekSummary.dailyAvgScore}}" wx:key="date" style="bottom: {{item.score > 0 ? (item.score / 100 * 100) : 0}}%">
                <view class="point-dot" wx:if="{{item.score > 0}}"></view>
                <text class="point-value" wx:if="{{item.score > 0}}">{{item.score}}</text>
              </view>
            </view>
              <!-- 线段容器：通过 CSS 旋转和宽度计算绘制线段 -->
              <view class="chart-line-svg">
                <!-- 遍历数据生成线段（6 条线段连接 7 个点），只连接有数据的点 -->
                <view class="line-segment" wx:for="{{weekSummary.dailyAvgScore}}" wx:key="date" wx:if="{{index < 6 && item.score > 0 && weekSummary.dailyAvgScore[index + 1].score > 0}}" style="transform: rotate({{calculateLineAngle(index, weekSummary.dailyAvgScore, 100)}}deg); width: {{calculateLineWidth(index, weekSummary.dailyAvgScore, 100)}}rpx;"></view>
              </view>
            </view>
            <!-- X 轴标签：显示星期 -->
            <view class="chart-x-labels">
            <text class="x-label {{item.isToday ? 'today' : ''}}" wx:for="{{weekSummary.dailyAvgScore}}" wx:key="date">{{item.dayName}}</text>
          </view>
        </view>
      </view>
          <!-- 统计摘要：显示平均分和用餐次数 -->
          <view class="chart-summary">
        <view class="summary-item">
          <text class="summary-label">本周平均分</text>
          <text class="summary-value">{{weekSummary.avgScore}} 分</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">用餐次数</text>
          <text class="summary-value">{{weekSummary.mealCount}} 次</text>
        </view>
      </view>
    </view>
    
    <!-- 空状态提示 -->
    <view class="report-empty" wx:if="{{weekSummary.mealCount === 0}}">
      <view class="empty-icon">
        <text>📝</text>
      </view>
      <text class="empty-title">暂无数据</text>
      <text class="empty-desc">本周还没有记录饮食，快去记录吧~</text>
      <button class="empty-btn" bindtap="navigateToChat">
        <text>开始记录</text>
      </button>
    </view>
  </view>
</view>

<!-- 餐食详情弹窗 -->
<view class="meal-detail-modal {{showDetailModal ? 'show' : ''}}" wx:if="{{showDetailModal}}">
  <!-- 弹窗背景遮罩 -->
  <view class="modal-backdrop" bindtap="closeDetailModal"></view>
  
  <!-- 弹窗容器 -->
  <view class="modal-container">
    <!-- 弹窗头部 -->
    <view class="modal-header">
      <view class="header-left">
        <text class="modal-title">{{detailMealType}}</text>
        <text class="modal-date">{{detailDate}}</text>
      </view>
      <view class="header-right">
        <!-- 删除按钮 -->
        <view class="delete-btn" bindtap="onDeleteRecord">
          <text class="text">删除</text>
        </view>
        <!-- 关闭按钮 -->
        <view class="close-btn" bindtap="closeDetailModal">
          <text>✕</text>
        </view>
      </view>
    </view>
    
    <!-- 记录分页导航（多条记录时显示） -->
    <view class="modal-pagination" wx:if="{{totalRecords > 1 && !isEditing}}">
      <view class="pagination-btn {{currentRecordIndex === 0 ? 'disabled' : ''}}" bindtap="onPrevRecord">
        <text>‹</text>
      </view>
      <text class="pagination-text">{{currentRecordIndex + 1}} / {{totalRecords}}</text>
      <view class="pagination-btn {{currentRecordIndex === totalRecords - 1 ? 'disabled' : ''}}" bindtap="onNextRecord">
        <text>›</text>
      </view>
    </view>
    
    <!-- 内容区域 - 使用 food-card 组件 -->
    <view class="modal-content-wrapper" wx:if="{{!isEditing && currentRecords.length > 0}}">
      <scroll-view scroll-y class="modal-body">
        <view class="detail-content">
          <!-- 当前记录数据 - 使用 food-card 组件 -->
          <block wx:if="{{currentRecords[currentRecordIndex]}}">
            <!-- 食物图片 -->
            <view class="detail-image-section" wx:if="{{currentRecords[currentRecordIndex].imageUrl}}">
              <image src="{{currentRecords[currentRecordIndex].imageUrl}}" class="detail-image" mode="aspectFill"></image>
            </view>
            <food-card
              foods="{{currentRecords[currentRecordIndex].foods}}"
              meal-overview="{{currentRecords[currentRecordIndex].mealOverview}}"
              dietary-advice="{{currentRecords[currentRecordIndex].dietaryAdvice}}"
              rating="{{currentRecords[currentRecordIndex].rating}}"
              record-saved="true"
            />
          </block>
        </view>
      </scroll-view>
    </view>
    
    <!-- 编辑模式 -->
    <view class="modal-content-wrapper edit-wrapper" wx:if="{{isEditing}}">
      <scroll-view scroll-y class="modal-body edit-body">
        <view class="detail-content edit-mode">
          <view class="edit-header">
            <text class="edit-title">编辑食物信息</text>
          </view>
          
          <!-- 编辑食物列表 -->
          <view class="edit-foods-list">
            <view class="edit-food-item" wx:for="{{editFoods}}" wx:key="index">
              <!-- 食物名称 -->
              <view class="edit-food-row">
                <text class="edit-label">名称</text>
                <input 
                  class="edit-input" 
                  value="{{item.name}}" 
                  data-index="{{index}}"
                  bindinput="onEditFoodName"
                />
              </view>
              <!-- 评分 -->
              <view class="edit-food-row">
                <text class="edit-label">评分</text>
                <input 
                  class="edit-input" 
                  type="number"
                  value="{{item.score}}" 
                  data-index="{{index}}"
                  bindinput="onEditFoodScore"
                />
                <text class="edit-unit">分</text>
              </view>
              <!-- 重量 -->
              <view class="edit-food-row">
                <text class="edit-label">重量</text>
                <input 
                  class="edit-input" 
                  type="number"
                  value="{{item.weight}}" 
                  data-index="{{index}}"
                  bindinput="onEditFoodWeight"
                />
                <text class="edit-unit">g</text>
              </view>
            </view>
          </view>
          
          <!-- 保存修改按钮 -->
          <button class="save-edit-btn" bindtap="saveEdit">保存修改</button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
