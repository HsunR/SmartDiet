.report-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: 40rpx;
}

.date-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  background-color: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
}

.date-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  color: #4CAF50;
}

.date-picker {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
  background-color: #E8F5E9;
  border-radius: 32rpx;
}

.date-text {
  font-size: 28rpx;
  color: #212121;
  font-weight: 500;
}

.date-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #757575;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E8F5E9;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.calendar-wrapper {
  margin: 24rpx;
}

.calendar-table {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.calendar-header {
  display: flex;
  background-color: #E8F5E9;
  border-bottom: 2rpx solid #C8E6C9;
  position: relative;
}

.header-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 8rpx;
  min-height: 80rpx;
}

.meal-type-header {
  position: sticky;
  left: 0;
  z-index: 20;
  flex-shrink: 0;
  width: 100rpx;
  background-color: #C8E6C9;
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: 600;
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.1);
}

.header-scroll {
  flex: 1;
  white-space: nowrap;
}

.header-days {
  display: inline-flex;
}

.day-cell {
  width: 120rpx;
  flex-shrink: 0;
}

.day-cell.today {
  background-color: #C8E6C9;
}

.day-name {
  font-size: 22rpx;
  color: #757575;
}

.day-date {
  font-size: 28rpx;
  color: #212121;
  font-weight: 600;
  margin-top: 4rpx;
}

.calendar-body {

}

.calendar-row {
  display: flex;
  border-bottom: 1rpx solid #EEEEEE;
  position: relative;
}

.calendar-row:last-child {
  border-bottom: none;
}

.meal-type-cell {
  position: sticky;
  left: 0;
  z-index: 15;
  flex-shrink: 0;
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
  border-right: 1rpx solid #EEEEEE;
  padding: 16rpx 8rpx;
  min-height: 160rpx;
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.05);
}

.meal-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.meal-label {
  font-size: 22rpx;
  color: #616161;
}

.cells-scroll {
  flex: 1;
  white-space: nowrap;
}

.cells-row {
  display: inline-flex;
}

.calendar-cell {
  width: 120rpx;
  flex-shrink: 0;
  min-height: 160rpx;
  padding: 12rpx;
  border-right: 1rpx solid #EEEEEE;
  display: inline-flex;
  flex-direction: column;
  box-sizing: border-box;
  vertical-align: top;
}

.calendar-cell.today-cell {
  background-color: #F1F8E9;
}

.cell-content {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.cell-image {
  width: 100%;
  height: 80rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  background-color: #F5F5F5;
}

.cell-foods {
  flex: 1;
  overflow: hidden;
}

.food-name {
  display: block;
  font-size: 20rpx;
  color: #212121;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 2rpx;
}

.cell-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-top: 4rpx;
}

.tag-positive {
  font-size: 18rpx;
  color: #2E7D32;
  background-color: #E8F5E9;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.tag-warning {
  font-size: 18rpx;
  color: #E65100;
  background-color: #FFF3E0;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.cell-calories {
  font-size: 20rpx;
  color: #4CAF50;
  font-weight: 500;
  margin-top: 4rpx;
}

.cell-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
  border-radius: 8rpx;
  border: 1rpx dashed #E0E0E0;
}

.empty-icon {
  font-size: 32rpx;
  color: #BDBDBD;
}

.summary-section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.summary-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
  margin-bottom: 20rpx;
}

.summary-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #4CAF50;
}

.stat-label {
  font-size: 22rpx;
  color: #757575;
  margin-top: 4rpx;
}
