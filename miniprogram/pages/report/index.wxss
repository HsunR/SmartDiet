/* ============================================
   饮食报告页面样式表
   功能：展示本周饮食统计和趋势分析的视觉效果
   ============================================ */

/* 页面容器 - 最小高度全屏，浅灰背景 */
.report-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));  /* 适配 iPhone 底部安全区 */
}

/* ============================================
   顶部日期导航栏样式
   ============================================ */

/* 日期导航栏 - Flex 布局，白色背景，固定在顶部 */
.date-header {
  display: flex;
  justify-content: center;  /* 水平居中 */
  align-items: center;      /* 垂直居中 */
  padding: 24rpx;
  background-color: #FFFFFF;
  position: sticky;  /* 粘性定位 */
  top: 0;
  z-index: 10;       /* 层级高于内容区 */
}

/* 导航按钮（上一周/下一周） */
.date-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  color: #4CAF50;  /* 绿色主题色 */
}

/* 日期选择器 - 圆角胶囊样式 */
.date-picker {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
  background-color: #E8F5E9;  /* 浅绿背景 */
  border-radius: 32rpx;
}

/* 日期文本 */
.date-text {
  font-size: 28rpx;
  color: #212121;
  font-weight: 500;
}

/* 日期下拉箭头 */
.date-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #757575;
}

/* ============================================
   加载状态样式
   ============================================ */
/* 加载容器 - 居中显示 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
}

/* 加载旋转动画 */
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E8F5E9;  /* 浅绿底色 */
  border-top-color: #4CAF50;    /* 绿色顶部 */
  border-radius: 50%;
  animation: spin 0.8s linear infinite;  /* 旋转动画 */
  margin-bottom: 24rpx;
}

/* 定义旋转关键帧动画 */
@keyframes spin {
  to { transform: rotate(360deg); }
}

.calendar-wrapper {
  margin: 24rpx;
}

.calendar-table {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.calendar-scroll {
  width: 100%;
  white-space: nowrap;
}

.calendar-content {
  display: inline-block;
}

.calendar-header {
  display: flex;
  background-color: #E8F5E9;
  border-bottom: 2rpx solid #C8E6C9;
  position: sticky;
  top: 0;
  z-index: 25;
}

.header-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 8rpx;
  min-height: 80rpx;
  box-sizing: border-box;
}

.meal-type-header {
  position: sticky;
  left: 0;
  z-index: 30;
  flex-shrink: 0;
  width: 137rpx;
  background-color: #C8E6C9;
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: 600;
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.1);
}

.header-days {
  display: inline-flex;
}

.day-cell {
  width: 200rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.day-cell.today {
  background-color: #C8E6C9;
}

.day-name {
  font-size: 22rpx;
  color: #757575;
}

.day-date {
  font-size: 28rpx;
  color: #212121;
  font-weight: 600;
  margin-top: 4rpx;
}

.calendar-row {
  display: flex;
  border-bottom: 1rpx solid #EEEEEE;
}

.calendar-row:last-child {
  border-bottom: none;
}

.meal-type-cell {
  position: sticky;
  left: 0;
  z-index: 20;
  flex-shrink: 0;
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
  border-right: 1rpx solid #EEEEEE;
  padding: 16rpx 8rpx;
  min-height: 220rpx;
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.05);
}

.meal-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.meal-label {
  font-size: 22rpx;
  color: #616161;
}

.cells-row {
  display: inline-flex;
}

.calendar-cell {
  width: 200rpx;
  flex-shrink: 0;
  min-height: 220rpx;
  padding: 12rpx;
  border-right: 1rpx solid #EEEEEE;
  display: inline-flex;
  flex-direction: column;
  box-sizing: border-box;
  vertical-align: top;
}

.calendar-cell.today-cell {
  background-color: #F1F8E9;
}

.cell-content {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.cell-swiper {
  width: 100%;
  height: 100%;
  flex: 1;
}

.swiper-record {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.single-record {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.cell-image {
  width: 100%;
  height: 100rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  background-color: #F5F5F5;
}

.cell-foods {
  flex: 1;
  overflow: hidden;
}

.food-name {
  display: block;
  font-size: 20rpx;
  color: #212121;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 2rpx;
}

.cell-rating {
  margin-top: 6rpx;
  padding: 4rpx 0;
}

.rating-stars {
  font-size: 18rpx;
}

.cell-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-top: 4rpx;
}

.tag-positive {
  font-size: 18rpx;
  color: #2E7D32;
  background-color: #E8F5E9;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.tag-warning {
  font-size: 18rpx;
  color: #E65100;
  background-color: #FFF3E0;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.cell-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
  border-radius: 8rpx;
  border: 1rpx dashed #E0E0E0;
}

.empty-icon {
  font-size: 32rpx;
  color: #BDBDBD;
}

.record-count {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background-color: rgba(76, 175, 80, 0.9);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.record-count .text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.weekly-report-section {
  margin: 24rpx;
  margin-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.report-header {
  margin-bottom: 20rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.report-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.report-subtitle {
  font-size: 24rpx;
  color: #757575;
  margin-top: 4rpx;
}

.report-chart-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.chart-header {
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
}

.chart-container {
  display: flex;
  height: 300rpx;
  margin-bottom: 20rpx;
}

.chart-y-axis {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 10rpx 0;
}

.y-label {
  font-size: 20rpx;
  color: #BDBDBD;
  text-align: right;
}

.chart-area {
  flex: 1;
  position: relative;
}

.chart-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.grid-line {
  height: 1rpx;
  background-color: #F0F0F0;
}

.chart-line-wrapper {
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  bottom: 30rpx;
}

.chart-line-points {
  position: relative;
  height: 100%;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
}

.line-point {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 60rpx;
}

.point-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

.line-point.today .point-dot {
  background-color: #2E7D32;
  width: 20rpx;
  height: 20rpx;
  border-width: 6rpx;
}

.point-value {
  position: absolute;
  bottom: 100%;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  color: #4CAF50;
  font-weight: 600;
  background-color: #FFFFFF;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.line-point.today .point-value {
  color: #2E7D32;
}

.chart-line-svg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.line-segment {
  position: absolute;
  height: 3rpx;
  background-color: #4CAF50;
  transform-origin: left center;
  opacity: 0.6;
}

.chart-x-labels {
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
}

.x-label {
  font-size: 20rpx;
  color: #757575;
}

.x-label.today {
  color: #4CAF50;
  font-weight: 600;
}

.chart-summary {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEEEEE;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-label {
  font-size: 22rpx;
  color: #757575;
  margin-bottom: 4rpx;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2196F3;
}

.report-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #757575;
  margin-bottom: 32rpx;
  text-align: center;
}

.empty-btn {
  width: 240rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

/* ============================================
   餐食详情弹窗样式 - 重写版本
   ============================================ */

.meal-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-container {
  position: relative;
  max-height: 85vh;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
  overflow: hidden;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.modal-content-wrapper.edit-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #EEEEEE;
  flex-shrink: 0;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.modal-date {
  font-size: 24rpx;
  color: #757575;
  margin-top: 4rpx;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.edit-btn {
  padding: 8rpx 20rpx;
  background-color: #E8F5E9;
  border-radius: 20rpx;
}

.edit-btn .text {
  font-size: 24rpx;
  color: #4CAF50;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #9E9E9E;
}

.modal-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 32rpx;
  background-color: #F5F5F5;
  gap: 24rpx;
  flex-shrink: 0;
}

.pagination-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 32rpx;
}

.pagination-btn.disabled {
  background-color: #E0E0E0;
  color: #9E9E9E;
}

.pagination-text {
  font-size: 26rpx;
  color: #616161;
  font-weight: 500;
}

.modal-body {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.modal-body.edit-body {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.detail-content {
  padding: 24rpx;
}

.detail-image-section {
  margin-bottom: 20rpx;
}

.detail-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  object-fit: cover;
}

.detail-score-section {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #FAFAFA;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.score-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.score-inner {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.score-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #212121;
}

.score-label {
  font-size: 18rpx;
  color: #757575;
}

.score-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 24rpx;
  color: #757575;
}

.info-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #212121;
}

.score-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.score-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.score-tag.tag-positive {
  color: #2E7D32;
  background-color: #E8F5E9;
}

.score-tag.tag-warning {
  color: #E65100;
  background-color: #FFF3E0;
}

.detail-foods-section,
.detail-tags-section,
.detail-advice-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #EEEEEE;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.header-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
  flex: 1;
}

.header-count {
  font-size: 22rpx;
  color: #757575;
  background-color: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.foods-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.food-item {
  padding: 16rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
}

.food-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.food-info {
  flex: 1;
}

.food-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #212121;
  margin-bottom: 6rpx;
}

.food-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.food-tag {
  font-size: 18rpx;
  color: #4CAF50;
  background-color: #E8F5E9;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.food-calories {
  font-size: 24rpx;
  color: #4CAF50;
  font-weight: 600;
}

.food-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.food-weight,
.food-category {
  font-size: 22rpx;
  color: #757575;
}

.food-advice {
  font-size: 22rpx;
  color: #616161;
  line-height: 1.5;
  padding: 8rpx 12rpx;
  background-color: #FFF8E1;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.tag-item.tag-positive {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.tag-item.tag-warning {
  background-color: #FFF3E0;
  color: #E65100;
}

.tag-icon {
  margin-right: 6rpx;
}

.tag-text {
  font-size: 24rpx;
}

.advice-card {
  padding: 16rpx;
  background-color: #FFF8E1;
  border-radius: 12rpx;
}

.advice-text {
  font-size: 24rpx;
  color: #616161;
  line-height: 1.6;
}

.edit-mode {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.edit-header {
  margin-bottom: 24rpx;
}

.edit-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
}

.edit-foods-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.edit-food-item {
  padding: 16rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
}

.edit-food-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.edit-food-row:last-child {
  margin-bottom: 0;
}

.edit-label {
  width: 80rpx;
  font-size: 24rpx;
  color: #757575;
}

.edit-input {
  flex: 1;
  height: 56rpx;
  padding: 0 16rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.edit-unit {
  width: 60rpx;
  font-size: 22rpx;
  color: #757575;
  text-align: right;
}

.save-edit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.save-edit-btn::after {
  border: none;
}
