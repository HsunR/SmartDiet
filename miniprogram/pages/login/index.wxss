.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(180deg, #E8F5E9 0%, #FFFFFF 100%);
  padding: 48rpx;
}

.login-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 48rpx;
}

.logo-placeholder {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 120rpx;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.2);
}

.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #212121;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #757575;
}

.features {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 80rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 48rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.feature-text {
  font-size: 24rpx;
  color: #757575;
}

.login-actions {
  width: 100%;
  margin-bottom: 48rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  margin-bottom: 24rpx;
}

.login-btn::after {
  border: none;
}

.btn-icon {
  margin-right: 16rpx;
}

.agreement {
  font-size: 24rpx;
  color: #BDBDBD;
  text-align: center;
}

.link {
  color: #4CAF50;
}
