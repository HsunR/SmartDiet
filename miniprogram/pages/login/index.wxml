<view class="login-container">
  <view class="login-content">
    <image src="/assets/icons/logo.png" class="logo" mode="aspectFit"></image>
    
    <view class="title-section">
      <text class="title">AI营养师</text>
      <text class="subtitle">智能饮食管理，健康生活每一天</text>
    </view>
    
    <view class="features">
      <view class="feature-item">
        <view class="feature-icon">📷</view>
        <text class="feature-text">拍照识别食物</text>
      </view>
      <view class="feature-item">
        <view class="feature-icon">📊</view>
        <text class="feature-text">营养分析报告</text>
      </view>
      <view class="feature-item">
        <view class="feature-icon">💡</view>
        <text class="feature-text">智能饮食建议</text>
      </view>
    </view>
    
    <view class="login-actions">
      <button class="login-btn" bindtap="onGetUserProfile">
        <text class="btn-icon">👤</text>
        <text>微信登录</text>
      </button>
      
      <view class="skip-btn" bindtap="onSkip">
        <text>稍后登录</text>
      </view>
    </view>
    
    <view class="agreement">
      <text>登录即表示同意</text>
      <text class="link">《用户协议》</text>
      <text>和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>
</view>
