.profile-container {
  min-height: 100vh;
  background-color: #FAFAFA;
}

.login-section {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 48rpx;
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 64rpx 48rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #212121;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #757575;
  margin-bottom: 48rpx;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

.profile-content {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.user-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #E8F5E9;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #BDBDBD;
}

.edit-btn {
  padding: 12rpx 24rpx;
  background-color: #E8F5E9;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #4CAF50;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 32rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #4CAF50;
}

.stat-label {
  font-size: 24rpx;
  color: #757575;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #EEEEEE;
}

.profile-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
}

.card-subtitle {
  font-size: 22rpx;
  color: #BDBDBD;
  margin-left: 16rpx;
}

.profile-form {
  
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #212121;
}

.form-input {
  flex: 1;
  height: 56rpx;
  padding: 0 16rpx;
  background-color: #FAFAFA;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: right;
}

.form-unit {
  width: 60rpx;
  font-size: 26rpx;
  color: #757575;
  text-align: right;
}

.form-value {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 28rpx;
  color: #212121;
}

.arrow {
  margin-left: 8rpx;
  color: #BDBDBD;
  font-size: 32rpx;
}

.targets-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.targets-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.target-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background-color: #FAFAFA;
  border-radius: 16rpx;
}

.target-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #4CAF50;
}

.target-unit {
  font-size: 22rpx;
  color: #757575;
  margin-top: 4rpx;
}

.target-label {
  font-size: 24rpx;
  color: #757575;
  margin-top: 8rpx;
}

.menu-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
  font-size: 36rpx;
  color: #4CAF50;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  color: #212121;
}

.menu-arrow {
  font-size: 32rpx;
  color: #BDBDBD;
}

.save-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}
