/* ========== 页面容器 ========== */
.history-container {
  min-height: 100vh;
  background-color: #FAFAFA;
}

/* ========== 筛选栏样式 ========== */
.filter-bar {
  padding: 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.filter-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 32rpx;
  background-color: #F5F5F5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #212121;
}

.filter-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #757575;
}

/* ========== 加载状态样式 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
}

/* 加载旋转动画 */
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E8F5E9;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

/* 旋转动画关键帧 */
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 空状态样式 ========== */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 32rpx;
  border: none;
}

/* ========== 记录列表样式 ========== */
.records-list {
  height: calc(100vh - 120rpx);
}

/* 日期分组容器 */
.date-group {
  margin-bottom: 24rpx;
}

/* 分组头部：显示日期和总热量 */
.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
}

.group-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
}

.group-calories {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

/* ========== 记录项样式 ========== */
.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
}

/* 记录图片 */
.record-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #F5F5F5;
}

/* 图片占位符 */
.record-placeholder {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #E8F5E9;
  border-radius: 12rpx;
  margin-right: 24rpx;
  font-size: 40rpx;
}

/* 记录内容区域 */
.record-content {
  flex: 1;
}

/* 记录头部：餐别和时间 */
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-meal {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

.record-time {
  font-size: 22rpx;
  color: #BDBDBD;
}

/* 食物名称：单行省略 */
.record-foods {
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 营养标签容器 */
.record-nutrients {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.nutrient-tag {
  font-size: 22rpx;
  color: #757575;
  padding: 4rpx 12rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
}

/* 右侧箭头 */
.record-arrow {
  font-size: 32rpx;
  color: #BDBDBD;
  margin-left: 16rpx;
}

/* ========== 加载更多样式 ========== */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #757575;
}

/* 小号加载动画 */
.loading-spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #E8F5E9;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

/* 没有更多数据提示 */
.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #BDBDBD;
}

/* ========== 日期选择器样式 ========== */
/* 遮罩层 */
.date-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

/* 弹窗容器 */
.date-picker-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  z-index: 101;
  overflow: hidden;
}

/* 弹窗头部 */
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #757575;
}

/* 弹窗内容 */
.popup-content {
  padding: 24rpx;
}

/* 日期字段 */
.date-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.field-label {
  font-size: 28rpx;
  color: #212121;
}

.field-value {
  font-size: 28rpx;
  color: #4CAF50;
  padding: 8rpx 24rpx;
  background-color: #E8F5E9;
  border-radius: 16rpx;
}

/* 弹窗底部按钮 */
.popup-footer {
  display: flex;
  padding: 24rpx;
  border-top: 1rpx solid #EEEEEE;
}

.popup-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  margin: 0 8rpx;
  border: none;
}

/* 取消按钮 */
.popup-btn.cancel {
  background-color: #F5F5F5;
  color: #757575;
}

/* 确认按钮 */
.popup-btn.confirm {
  background-color: #4CAF50;
  color: #FFFFFF;
}
