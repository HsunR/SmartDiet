<!-- 历史记录页面容器 -->
<view class="history-container">
  <!-- 日期筛选栏 -->
  <view class="filter-bar">
    <view class="filter-btn" bindtap="onDateFilter">
      <text>{{startDate}} 至 {{endDate}}</text>
      <text class="filter-arrow">▼</text>
    </view>
  </view>
  
  <!-- 加载状态提示 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
  
  <!-- 空状态提示 -->
  <view wx:elif="{{records.length === 0}}" class="empty-container">
    <view class="empty-icon">📋</view>
    <text class="empty-text">暂无记录</text>
    <button class="empty-btn" bindtap="onAddFood">添加记录</button>
  </view>
  
  <!-- 记录列表滚动区域 -->
  <scroll-view wx:else class="records-list" scroll-y enable-back-to-top>
    <!-- 按日期分组的记录列表 -->
    <view class="date-group" wx:for="{{records}}" wx:key="date">
      <!-- 日期组头部：显示日期 -->
      <view class="group-header">
        <text class="group-date">{{item.displayDate}}</text>
      </view>
      
      <!-- 单条记录项 -->
      <view 
        class="record-item" 
        wx:for="{{item.records}}" 
        wx:for-item="record"
        wx:key="_id"
        data-record="{{record}}"
        bindtap="onRecordTap"
      >
        <!-- 记录图片：有图片时显示 -->
        <image 
          wx:if="{{record.imageUrl}}" 
          src="{{record.imageUrl}}" 
          class="record-image"
          mode="aspectFill"
        ></image>
        <!-- 占位符：无图片时显示 -->
        <view class="record-placeholder" wx:else>
          <text>🍽️</text>
        </view>
        
        <!-- 记录内容区域 -->
        <view class="record-content">
          <!-- 记录头部：餐别类型和时间 -->
          <view class="record-header">
            <text class="record-meal">{{record.mealType === 'breakfast' ? '早餐' : record.mealType === 'lunch' ? '午餐' : record.mealType === 'dinner' ? '晚餐' : '加餐'}}</text>
            <text class="record-time">{{record.displayTime}}</text>
          </view>
          <!-- 食物名称列表 -->
          <text class="record-foods">{{record.foodsNames}}</text>
          <!-- 营养信息标签 -->
          <view class="record-nutrients">
            <text class="nutrient-tag">{{(record.mealOverview && record.mealOverview.overallHealthScore) ? record.mealOverview.overallHealthScore : 60}} 分</text>
          </view>
        </view>
        
        <!-- 右侧箭头图标 -->
        <text class="record-arrow">›</text>
      </view>
    </view>
    
    <!-- 加载更多提示 -->
    <view wx:if="{{loadingMore}}" class="loading-more">
      <view class="loading-spinner-small"></view>
      <text>加载更多...</text>
    </view>
    
    <!-- 没有更多数据提示 -->
    <view wx:if="{{!hasMore && records.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </scroll-view>
  
  <!-- 日期选择器遮罩层 -->
  <view class="date-picker-mask" wx:if="{{showDatePicker}}" bindtap="cancelDateFilter"></view>
  <!-- 日期选择器弹窗 -->
  <view class="date-picker-popup" wx:if="{{showDatePicker}}">
    <!-- 弹窗头部 -->
    <view class="popup-header">
      <text class="popup-title">选择日期范围</text>
      <view class="popup-close" bindtap="cancelDateFilter">×</view>
    </view>
    <!-- 弹窗内容：日期选择字段 -->
    <view class="popup-content">
      <view class="date-field">
        <text class="field-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="picker-value">{{startDate}}</view>
        </picker>
      </view>
      <view class="date-field">
        <text class="field-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
          <view class="picker-value">{{endDate}}</view>
        </picker>
      </view>
    </view>
    <!-- 弹窗底部操作按钮 -->
    <view class="popup-actions">
      <button class="popup-btn cancel" bindtap="cancelDateFilter">取消</button>
      <button class="popup-btn confirm" bindtap="applyDateFilter">确定</button>
    </view>
  </view>
</view>
