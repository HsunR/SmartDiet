.recognize-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: 120rpx;
}

.image-section {
  padding: 48rpx 24rpx;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background-color: #FFFFFF;
  border: 4rpx dashed #C8E6C9;
  border-radius: 24rpx;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #E8F5E9;
  border-radius: 50%;
  margin-bottom: 24rpx;
}

.upload-icon text {
  font-size: 56rpx;
  color: #4CAF50;
}

.upload-text {
  font-size: 32rpx;
  color: #212121;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #757575;
}

.image-preview {
  position: relative;
  padding: 24rpx;
}

.preview-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background-color: #FFFFFF;
}

.change-image {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  padding: 12rpx 24rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}

.recognizing {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E8F5E9;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.food-section {
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.meal-type-picker {
  padding: 12rpx 24rpx;
  background-color: #E8F5E9;
  border-radius: 24rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4CAF50;
}

.picker-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

.food-list {
  margin-bottom: 24rpx;
}

.food-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.food-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.food-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.food-category {
  font-size: 24rpx;
  color: #757575;
  padding: 4rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 12rpx;
}

.food-portion {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.portion-label {
  font-size: 26rpx;
  color: #757575;
  margin-right: 16rpx;
}

.portion-input {
  width: 120rpx;
  height: 56rpx;
  padding: 0 16rpx;
  background-color: #FAFAFA;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
}

.portion-unit {
  font-size: 26rpx;
  color: #757575;
  margin-left: 8rpx;
}

.food-nutrients {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #EEEEEE;
  border-bottom: 1rpx solid #EEEEEE;
}

.nutrient-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nutrient-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #4CAF50;
}

.nutrient-unit {
  font-size: 22rpx;
  color: #757575;
  margin-top: 4rpx;
}

.food-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.action-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #4CAF50;
  margin-left: 16rpx;
}

.action-btn-danger {
  color: #F44336;
}

.add-food-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 88rpx;
  background-color: #FFFFFF;
  border: 2rpx dashed #4CAF50;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #4CAF50;
  margin-bottom: 24rpx;
}

.total-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.total-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
  margin-bottom: 16rpx;
}

.total-nutrients {
  display: flex;
  justify-content: space-around;
}

.total-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #4CAF50;
}

.total-unit {
  font-size: 24rpx;
  color: #757575;
  margin-top: 4rpx;
}

.save-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.save-btn-loading {
  background-color: #C8E6C9;
}

.food-editor-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.food-editor {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  z-index: 101;
  overflow: hidden;
}

.editor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.editor-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.editor-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #757575;
}

.editor-content {
  padding: 24rpx;
}

.editor-field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #757575;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.editor-footer {
  display: flex;
  padding: 24rpx;
  border-top: 1rpx solid #EEEEEE;
}

.editor-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  margin: 0 8rpx;
}

.editor-btn-cancel {
  background-color: #F5F5F5;
  color: #757575;
}

.editor-btn-confirm {
  background-color: #4CAF50;
  color: #FFFFFF;
}
