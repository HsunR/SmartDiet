<wxs src="../../utils/utils.wxs" module="utils" />
<view class="chat-container">
  <scroll-view 
    class="message-list" 
    scroll-y 
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
  >
    <view 
      wx:for="{{messages}}" 
      wx:key="id" 
      id="msg-{{item.id}}"
      wx:if="{{!(item.type === 'feedback_input' && item.data.completed)}}"
      class="message-item {{item.role === 'user' ? 'message-user' : 'message-ai'}}"
    >
      <view class="message-avatar" wx:if="{{item.role === 'assistant'}}">
        <view class="avatar-placeholder avatar-ai">🤖</view>
      </view>
      
      <view class="message-content {{item.role === 'user' ? 'message-content-user' : ''}}">
        <view class="message-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
          <text wx:if="{{item.type === 'text'}}" class="message-text">{{item.content}}</text>
          
          <image 
            wx:elif="{{item.type === 'image'}}" 
            src="{{item.data.imageUrl}}" 
            mode="widthFix" 
            class="message-image"
            bindtap="previewImage"
            data-url="{{item.data.imageUrl}}"
          ></image>
          
          <food-card 
            wx:elif="{{item.type === 'food_card'}}" 
            foods="{{item.data.foods}}"
            meal-overview="{{item.data.mealOverview}}"
            dietary-advice="{{item.data.dietaryAdvice}}"
            record-id="{{item.data.recordId}}"
            rating="{{item.data.rating}}"
            action-completed="{{item.data.actionCompleted}}"
            bindconfirm="onFoodCardConfirm"
            bindedit="onFoodCardEdit"
          ></food-card>
          
          <view wx:if="{{item.type === 'meal_type_picker' && !item.data.completed}}" class="meal-type-picker">
            <text class="picker-title">{{item.content}}</text>
            <view class="picker-wheel-container">
              <picker-view 
                class="meal-picker-view"
                value="{{[pickerIndex]}}"
                bindchange="onMealPickerChange"
              >
                <picker-view-column>
                  <view class="picker-item" wx:for="{{item.data.mealTypes}}" wx:key="value">
                    <text class="picker-icon">{{item.icon}}</text>
                    <text class="picker-label">{{item.label}}</text>
                  </view>
                </picker-view-column>
              </picker-view>
            </view>
            <button class="picker-confirm-btn" bindtap="onMealTypeConfirm" data-msg-id="{{item.id}}">
              <text>确认</text>
            </button>
          </view>
          
          <view wx:if="{{item.type === 'meal_type_select' && !item.data.collapsed}}" class="meal-type-select-container message-animate-in">
            <text class="select-title">{{item.content}}</text>
            <view class="meal-type-grid">
              <view 
                wx:for="{{item.data.mealTypes}}" 
                wx:for-item="mealType"
                wx:key="value"
                class="meal-type-option {{item.data.selectedMealType === mealType.value ? 'meal-type-selected' : ''}}"
                bindtap="onMealTypeSelect"
                data-value="{{mealType.value}}"
                data-msg-id="{{item.id}}"
              >
                <text class="meal-type-icon">{{mealType.icon}}</text>
                <text class="meal-type-text">{{mealType.label}}</text>
              </view>
            </view>
          </view>
          
          <view wx:if="{{item.type === 'date_select' && !item.data.collapsed}}" class="date-select-container message-animate-in">
            <text class="select-title">{{item.content}}</text>
            <view class="date-picker-wrapper">
              <picker 
                mode="date" 
                value="{{item.data.selectedDate}}" 
                bindchange="onDateSelect"
                data-msg-id="{{item.id}}"
                class="date-picker"
              >
                <view class="date-picker-display">
                  <text class="date-picker-icon">📅</text>
                  <text class="date-picker-value">{{item.data.selectedDate}}</text>
                  <text class="date-picker-arrow">▼</text>
                </view>
              </picker>
            </view>
            <view wx:if="{{item.data.selectedMealType}}" class="date-meal-type-hint">
              <text>餐次：{{item.data.selectedMealType === 'breakfast' ? '🌅 早餐' : item.data.selectedMealType === 'lunch' ? '☀️ 午餐' : item.data.selectedMealType === 'dinner' ? '🌙 晚餐' : '🍎 其他'}}</text>
            </view>
            <button class="date-confirm-btn" bindtap="onDateConfirm" data-msg-id="{{item.id}}">
              <text>确认</text>
            </button>
          </view>
          
          <view wx:if="{{item.type === 'date_select' && item.data.collapsed}}" class="date-collapsed message-animate-out">
            <text class="collapsed-text">日期：{{item.data.selectedDate}}{{item.data.selectedMealType ? ' | ' + (item.data.selectedMealType === 'breakfast' ? '🌅 早餐' : item.data.selectedMealType === 'lunch' ? '☀️ 午餐' : item.data.selectedMealType === 'dinner' ? '🌙 晚餐' : '🍎 其他') : ''}}</text>
          </view>
          
          <view wx:if="{{item.type === 'meal_type_select' && item.data.collapsed}}" class="meal-type-collapsed message-animate-out">
            <text class="collapsed-text">已选择：{{item.data.selectedMealType === 'breakfast' ? '🌅 早餐' : item.data.selectedMealType === 'lunch' ? '☀️ 午餐' : item.data.selectedMealType === 'dinner' ? '🌙 晚餐' : '🍎 其他'}}</text>
          </view>
          
          <view wx:if="{{item.type === 'rating_select' && !item.data.collapsed}}" class="rating-select-container message-animate-in">
            <text class="select-title">{{item.content}}</text>
            <view class="rating-grid">
              <view 
                wx:for="{{item.data.ratings}}" 
                wx:for-item="rating"
                wx:key="value"
                class="rating-option {{item.data.selectedRating === rating.value ? 'rating-selected' : ''}}"
                bindtap="onRatingSelect"
                data-value="{{rating.value}}"
                data-msg-id="{{item.id}}"
              >
                <text class="rating-icon">{{rating.icon}}</text>
                <text class="rating-text">{{rating.label}}</text>
              </view>
            </view>
          </view>
          
          <view wx:if="{{item.type === 'rating_select' && item.data.collapsed}}" class="rating-collapsed message-animate-out">
            <text class="collapsed-text">评分：{{item.data.selectedRating === 0 ? '❓ 待定' : item.data.selectedRating + '星'}}</text>
          </view>
          
          <view wx:if="{{item.type === 'feedback_input' && !item.data.completed}}" class="feedback-input">
            <text class="feedback-title">{{item.content}}</text>
            <textarea 
              class="feedback-textarea" 
              placeholder="例如：分量估算不对、漏识别了食物、烹饪方式判断错误..."
              bindinput="onFeedbackInput"
              data-msg-id="{{item.id}}"
              value="{{feedbackValues[item.id] || ''}}"
            ></textarea>
            <button class="feedback-submit-btn" bindtap="onFeedbackSubmitBtn" data-msg-id="{{item.id}}">
              <text>重新识别</text>
            </button>
          </view>
          
          <view wx:if="{{item.type === 'user_info_form' && !item.data.completed}}" class="user-info-form">
            <text class="form-title">{{item.content}}</text>
            <view class="form-fields">
              <view class="form-field" wx:for="{{item.data.fields}}" wx:for-item="field" wx:key="key">
                <text class="field-label">{{field.label}}</text>
                <input 
                  wx:if="{{field.type === 'number'}}"
                  class="field-input"
                  type="number"
                  placeholder="{{field.placeholder}}"
                  data-field="{{field.key}}"
                  data-msg-id="{{item.id}}"
                  bindinput="onFormFieldInput"
                />
                <picker 
                  wx:elif="{{field.type === 'picker'}}"
                  class="field-picker"
                  range="{{field.options}}"
                  data-field="{{field.key}}"
                  data-msg-id="{{item.id}}"
                  bindchange="onFormFieldPicker"
                >
                  <view class="picker-display">
                    <text>{{formValues[field.key] || '请选择'}}</text>
                    <text class="picker-arrow">▼</text>
                  </view>
                </picker>
                <view 
                  wx:elif="{{field.type === 'multiPicker'}}"
                  class="field-multi-picker"
                >
                  <view 
                    class="multi-option {{formValues[field.key] && formValues[field.key].indexOf(opt.value) >= 0 ? 'multi-selected' : ''}}"
                    wx:for="{{field.options}}"
                    wx:for-item="opt"
                    wx:key="value"
                    data-field="{{field.key}}"
                    data-value="{{opt.value}}"
                    data-msg-id="{{item.id}}"
                    bindtap="onMultiPickerToggle"
                  >
                    <text>{{opt.label}}</text>
                  </view>
                </view>
              </view>
            </view>
            <button class="form-submit-btn" bindtap="onUserInfoFormSubmit" data-msg-id="{{item.id}}">
              <text>保存信息</text>
            </button>
          </view>
          
          <view wx:elif="{{item.type === 'quick_actions'}}" class="quick-actions">
            <text class="quick-actions-title">{{item.content}}</text>
            <view class="quick-actions-list">
              <view 
                wx:for="{{item.data.actions}}" 
                wx:for-item="action"
                wx:key="id"
                class="quick-action-btn"
                bindtap="onQuickAction"
                data-action="{{action.id}}"
              >
                <text>{{action.icon}} {{action.label}}</text>
              </view>
            </view>
          </view>
        </view>
        
        <view class="message-time" wx:if="{{item.timestamp}}">
          <text>{{utils.formatTime(item.timestamp)}}</text>
        </view>
      </view>
      
      <!-- <view class="message-avatar" wx:if="{{item.role === 'user'}}">
        <view class="avatar-placeholder avatar-user">{{userInfo.nickName ? userInfo.nickName[0] : '👤'}}</view>
      </view> -->
    </view>
    
    <view wx:if="{{isLoading}}" class="message-item message-ai">
      <view class="message-avatar">
        <view class="avatar-placeholder avatar-ai">🤖</view>
      </view>
      <view class="message-content">
        <view class="message-bubble bubble-ai">
          <view class="typing-indicator">
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
          </view>
        </view>
      </view>
    </view>
    
    <view class="scroll-bottom-placeholder"></view>
  </scroll-view>
  
  <view class="input-area">
    <view class="input-wrapper">
      <view class="camera-btn" bindtap="chooseImage">
        <view class="camera-icon-svg">
          <view class="camera-body"></view>
          <view class="camera-lens"></view>
        </view>
      </view>
      
      <input 
        class="message-input"
        type="text"
        placeholder="输入消息..."
        value="{{inputValue}}"
        bindinput="onInputChange"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        confirm-type="send"
        bindconfirm="sendMessage"
      />
      
      <view 
        class="send-btn {{inputValue ? 'send-btn-active' : ''}}" 
        bindtap="sendMessage"
      >
        <text>发送</text>
      </view>
    </view>
  </view>
</view>
