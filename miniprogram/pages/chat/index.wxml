<!-- WXS 时间格式化工具 -->
<wxs src="../../utils/utils.wxs" module="utils" />

<!-- ==================== 聊天页面容器 ==================== -->
<view class="chat-container">

  <!-- ================== 消息列表（可滚动） ================== -->
  <scroll-view
    class="message-list"
    scroll-y
    scroll-with-animation
  >

    <!-- 遍历所有消息，跳过已完成的反馈输入 -->
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      wx:if="{{!(item.type === 'feedback_input' && item.data.completed)}}"
      class="message-item {{item.role === 'user' ? 'message-user' : 'message-ai'}}"
    >
      <!-- AI 头像（用户无头像） -->
      <view class="message-avatar" wx:if="{{item.role === 'assistant'}}">
        <view class="avatar-placeholder avatar-ai">🤖</view>
      </view>

      <view class="message-content {{item.role === 'user' ? 'message-content-user' : ''}}">
        <view class="message-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">

          <!-- 纯文本消息（含流式输出支持） -->
          <text-message
            wx:if="{{item.type === 'text'}}"
            content="{{item.content}}"
            role="{{item.role}}"
            timestamp="{{item.timestamp}}"
            is-streaming="{{item.isStreaming}}"
          />

          <!-- AI 识别中（带脉冲动画） -->
          <view wx:elif="{{item.type === 'recognizing'}}" class="recognizing-message">
            <view class="recognizing-icon-wrapper">
              <text class="recognizing-icon">🔍</text>
            </view>
            <text class="recognizing-text">{{item.content}}</text>
          </view>

          <!-- 用户上传的图片 -->
          <image-message
            wx:elif="{{item.type === 'image'}}"
            image-url="{{item.data.imageUrl}}"
            role="{{item.role}}"
            bind:previewImage="onPreviewImage"
            bind:loaded="onImageLoaded"
          />

          <!-- AI 识别结果卡片（食物列表、营养标签、建议） -->
          <food-card
            wx:elif="{{item.type === 'food_card'}}"
            foods="{{item.data.foods}}"
            meal-overview="{{item.data.mealOverview}}"
            dietary-advice="{{item.data.dietaryAdvice}}"
            record-id="{{item.data.recordId}}"
            rating="{{item.data.rating}}"
            action-completed="{{item.data.actionCompleted}}"
            bind:confirm="onFoodCardConfirm"
            bind:edit="onFoodCardEdit"
          />

          <!-- 餐次选择器（Picker 滚轮模式） -->
          <meal-type-picker
            wx:elif="{{item.type === 'meal_type_picker' && !item.data.completed}}"
            content="{{item.content}}"
            meal-types="{{item.data.mealTypes}}"
            msg-id="{{item.id}}"
            bind:confirm="onMealTypePickerConfirm"
          />

          <!-- 餐次选择（按钮网格模式，折叠/展开由组件内部管理） -->
          <meal-type-select
            wx:elif="{{item.type === 'meal_type_select'}}"
            content="{{item.content}}"
            meal-types="{{item.data.mealTypes}}"
            selected-meal-type="{{item.data.selectedMealType}}"
            collapsed="{{item.data.collapsed}}"
            msg-id="{{item.id}}"
            bind:select="onMealTypeSelect"
          />

          <!-- 日期选择器 -->
          <date-select
            wx:elif="{{item.type === 'date_select'}}"
            content="{{item.content}}"
            selected-date="{{item.data.selectedDate}}"
            selected-meal-type="{{item.data.selectedMealType}}"
            collapsed="{{item.data.collapsed}}"
            msg-id="{{item.id}}"
            bind:dateChange="onDateSelect"
            bind:confirm="onDateConfirm"
          />

          <!-- 评分选择器 -->
          <rating-select
            wx:elif="{{item.type === 'rating_select'}}"
            content="{{item.content}}"
            ratings="{{item.data.ratings}}"
            selected-rating="{{item.data.selectedRating}}"
            collapsed="{{item.data.collapsed}}"
            msg-id="{{item.id}}"
            bind:select="onRatingSelect"
          />

          <!-- 反馈输入（用户修正识别结果） -->
          <feedback-input
            wx:elif="{{item.type === 'feedback_input' && !item.data.completed}}"
            content="{{item.content}}"
            placeholder="例如：分量估算不对、漏识别了食物、烹饪方式判断错误..."
            value="{{feedbackValues[item.id] || ''}}"
            msg-id="{{item.id}}"
            bind:input="onFeedbackInput"
            bind:submit="onFeedbackSubmit"
          />

          <!-- 用户信息表单（引导页未完成时的内联表单） -->
          <user-info-form
            wx:elif="{{item.type === 'user_info_form' && !item.data.completed}}"
            content="{{item.content}}"
            fields="{{item.data.fields}}"
            values="{{formValues}}"
            msg-id="{{item.id}}"
            bind:submit="onUserInfoFormSubmit"
          />

          <!-- 快捷操作按钮组（拍照、查看报告、获取建议） -->
          <quick-actions
            wx:elif="{{item.type === 'quick_actions'}}"
            content="{{item.content}}"
            actions="{{item.data.actions}}"
            bind:actionClick="onQuickAction"
          />

        </view>

        <!-- 消息时间戳 -->
        <view class="message-time" wx:if="{{item.timestamp}}">
          <text class="text">{{utils.formatTime(item.timestamp)}}</text>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- ================== 底部输入区域 ================== -->
  <view class="input-area">
    <view class="input-wrapper">
      <!-- 相机按钮（触发拍照/选图） -->
      <view class="camera-btn" bindtap="chooseImage">
        <view class="camera-icon-svg">
          <view class="camera-body"></view>
          <view class="camera-lens"></view>
        </view>
      </view>

      <!-- 文本输入框 -->
      <input
        class="message-input"
        type="text"
        placeholder="输入消息..."
        value="{{inputValue}}"
        bindinput="onInputChange"
        confirm-type="send"
        bindconfirm="sendMessage"
      />

      <!-- 发送按钮（有内容时高亮） -->
      <view
        class="send-btn {{inputValue ? 'send-btn-active' : ''}}"
        bindtap="sendMessage"
      >
        <text>发送</text>
      </view>
    </view>
  </view>
</view>
