.meal-type-select-container {
  padding: 16rpx 0;
}

.select-title {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.meal-type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meal-type-option {
  flex: 1;
  min-width: calc(50% - 6rpx);
  padding: 20rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  border: 2rpx solid #EEEEEE;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s ease;
}

.meal-type-selected {
  background-color: #E8F5E9;
  border-color: #4CAF50;
}

.meal-type-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.meal-type-text {
  font-size: 26rpx;
  color: #616161;
}

.meal-type-selected .meal-type-text {
  color: #4CAF50;
  font-weight: 500;
}

.meal-type-collapsed {
  padding: 12rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.collapsed-text {
  font-size: 24rpx;
  color: #757575;
}

.message-animate-out {
  animation: slideOutUp 0.3s ease-in;
}

@keyframes slideOutUp {
  from {
    opacity: 1;
    transform: translateY(0);
    max-height: 500rpx;
  }
  to {
    opacity: 0;
    transform: translateY(-20rpx);
    max-height: 0;
    padding: 0;
    margin: 0;
  }
}
