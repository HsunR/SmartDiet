<view class="meal-type-select-container {{collapsed ? 'meal-type-collapsed' : ''}}">
  <view wx:if="{{!collapsed}}">
    <text class="select-title">{{content}}</text>
    <view class="meal-type-grid">
      <view 
        wx:for="{{mealTypes}}" 
        wx:key="value"
        class="meal-type-option {{selectedMealType === item.value ? 'meal-type-selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="onSelect"
      >
        <text class="meal-type-icon">{{item.icon}}</text>
        <text class="meal-type-text">{{item.label}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="collapsed-text">
    <text>已选择：{{selectedMealLabel}}</text>
  </view>
</view>
