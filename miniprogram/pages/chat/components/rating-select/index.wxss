.rating-select-container {
  padding: 16rpx 0;
}

.select-title {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.rating-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rating-option {
  flex: 1;
  min-width: calc(33.33% - 8rpx);
  padding: 16rpx 12rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  border: 2rpx solid #EEEEEE;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s ease;
}

.rating-selected {
  background-color: #FFF9C4;
  border-color: #FFC107;
}

.rating-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #616161;
}

.rating-selected .rating-text {
  color: #F57C00;
  font-weight: 500;
}

.rating-collapsed {
  padding: 12rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.collapsed-text {
  font-size: 24rpx;
  color: #757575;
}
