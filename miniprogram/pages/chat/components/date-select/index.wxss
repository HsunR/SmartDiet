.date-select-container {
  padding: 16rpx 0;
}

.select-title {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.date-picker-wrapper {
  margin-bottom: 16rpx;
}

.date-picker {
  width: 100%;
}

.date-picker-display {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  background-color: #E8F5E9;
  border-radius: 16rpx;
  border: 2rpx solid #4CAF50;
}

.date-picker-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.date-picker-value {
  font-size: 32rpx;
  color: #212121;
  font-weight: 500;
}

.date-picker-arrow {
  font-size: 20rpx;
  color: #4CAF50;
  margin-left: 12rpx;
}

.date-meal-type-hint {
  padding: 12rpx 16rpx;
  background-color: #FFF8E1;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.date-meal-type-hint .text {
  font-size: 24rpx;
  color: #F57C00;
}

.date-confirm-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.date-confirm-btn::after {
  border: none;
}

.date-collapsed {
  padding: 12rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.collapsed-text {
  font-size: 24rpx;
  color: #757575;
}

.message-animate-out {
  animation: slideOutUp 0.3s ease-in;
}

@keyframes slideOutUp {
  from {
    opacity: 1;
    transform: translateY(0);
    max-height: 500rpx;
  }
  to {
    opacity: 0;
    transform: translateY(-20rpx);
    max-height: 0;
    padding: 0;
    margin: 0;
  }
}
