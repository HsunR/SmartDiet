<view class="date-select-container {{collapsed ? 'date-collapsed message-animate-out' : ''}}">
  <view wx:if="{{!collapsed}}">
    <view class="select-title">{{content}}</view>

    <view class="date-picker-wrapper">
      <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange" class="date-picker">
        <view class="date-picker-display">
          <text class="date-picker-icon">📅</text>
          <text class="date-picker-value">{{selectedDate}}</text>
          <text class="date-picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <button class="date-confirm-btn" bindtap="onConfirm">确认</button>
  </view>

  <view wx:else class="collapsed-text">
    <text>已选择：{{selectedDate}} {{selectedMealType ? '· ' + selectedMealType : ''}}</text>
  </view>
</view>
