<view class="message-text-container">
  <view wx:if="{{isStreaming && !content}}" class="typing-dots">
    <view class="typing-dot"></view>
    <view class="typing-dot"></view>
    <view class="typing-dot"></view>
  </view>
  <block wx:else>
    <rich-text wx:if="{{role === 'assistant'}}" nodes="{{htmlContent}}" class="message-text"></rich-text>
    <text wx:else class="message-text">{{content}}</text>
    <text wx:if="{{isStreaming}}" class="streaming-cursor">|</text>
  </block>
</view>
