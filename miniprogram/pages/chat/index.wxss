/* ==================== 页面容器 ====================
   .chat-container         纵向撑满全屏
   .message-list           可滚动消息区（flex:1 占满剩余高度）
   ================================================== */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #FAFAFA;
}

.message-list {
  flex: 1;
  height: 0;
  padding: 24rpx;
  padding-bottom: 280rpx;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  margin-right: 25rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ==================== 消息元素 ====================
   .message-avatar         AI 机器人圆形头像
   .message-content        气泡容器（用户消息靠右对齐）
   .message-bubble         气泡本体，AI 白色 / 用户绿色
   .message-time           时间戳
   ================================================== */
.message-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin: 0 16rpx;
}

.avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
}

.avatar-ai {
  background-color: #E8F5E9;
}

.avatar-user {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.message-content {
  max-width: calc(100% - 120rpx);
  display: flex;
  flex-direction: column;
  flex: 1;
}

.message-content-user {
  align-items: flex-end;
}

.message-bubble {
  padding: 10rpx;
  border-radius: 16rpx;
  word-wrap: break-word;
  word-break: break-word;
  overflow: visible;
  max-width: 100%;
  box-sizing: border-box;
}

.bubble-ai {
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-top-left-radius: 4rpx;
  overflow: visible;
}

.bubble-user {
  background-color: #4CAF50;
  color: #FFFFFF;
  border-top-right-radius: 4rpx;
}

.message-time {
  margin-top: 4rpx;
  padding: 0 8rpx;
  min-height: 0;
  line-height: 1;
}

.message-time .text {
  font-size: 22rpx;
  color: #BDBDBD;
}

/* ==================== 识别中动画 ====================
   .recognizing-message    扫描动画容器
   .recognizing-icon       脉冲放大图标
   ================================================== */
.recognizing-message {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.recognizing-icon-wrapper {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

.recognizing-icon {
  font-size: 36rpx;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.2); opacity: 0.7; }
}

.recognizing-text {
  font-size: 28rpx;
  color: #757575;
}

/* ==================== 底部输入区域 ====================
   .input-area             固定底部栏
   .camera-btn             相机触发按钮
   .message-input          文本输入框
   .send-btn / .send-btn-active  发送按钮（有内容时高亮）
   ================================================== */
.input-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 100rpx;
  background-color: #FFFFFF;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.input-wrapper {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.camera-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #E8F5E9;
  border-radius: 50%;
  margin-right: 16rpx;
}

.camera-icon-svg {
  width: 40rpx;
  height: 32rpx;
  position: relative;
}

.camera-body {
  width: 40rpx;
  height: 24rpx;
  background-color: #4CAF50;
  border-radius: 6rpx;
  position: absolute;
  bottom: 0;
}

.camera-lens {
  width: 16rpx;
  height: 16rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.message-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #FAFAFA;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background-color: #EEEEEE;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #BDBDBD;
  transition: all 0.2s ease;
}

.send-btn-active {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.send-btn-active:active {
  background-color: #43A047;
}

/* ==================== 回到底部按钮 ==================== */
.scroll-to-bottom-wrapper {
  position: fixed;
  bottom: 300rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 110;
}

.scroll-to-bottom-btn {
  background: #4CAF50;
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  animation: fadeIn 0.2s ease;
}

.scroll-to-bottom-icon {
  font-size: 28rpx;
  font-weight: bold;
}
