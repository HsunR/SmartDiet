.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #FAFAFA;
}

.message-list {
  flex: 1;
  height: 0;
  padding: 24rpx;
  padding-bottom: 280rpx;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  margin-right: 25rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin: 0 16rpx;
}

.avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
}

.avatar-ai {
  background-color: #E8F5E9;
}

.avatar-user {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.message-content {
  max-width: calc(100% - 120rpx);
  display: flex;
  flex-direction: column;
  flex: 1;
}

.message-content-user {
  align-items: flex-end;
}

.message-bubble {
  padding: 10rpx;
  border-radius: 16rpx;
  word-wrap: break-word;
  word-break: break-word;
  overflow: visible;
  max-width: 100%;
  box-sizing: border-box;
}

.bubble-ai {
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-top-left-radius: 4rpx;
  overflow: visible;
}

.bubble-user {
  background-color: #4CAF50;
  color: #FFFFFF;
  border-top-right-radius: 4rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.message-image {
  max-width: 400rpx;
  border-radius: 12rpx;
}

.message-time {
  margin-top: 4rpx;
  padding: 0 8rpx;
  min-height: 0;
  line-height: 1;
}

.message-time text {
  font-size: 22rpx;
  color: #BDBDBD;
}


.typing-indicator {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

.quick-actions {
  padding: 8rpx 0;
}

.quick-actions-title {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 16rpx;
}

.quick-actions-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-action-btn {
  padding: 16rpx 24rpx;
  background-color: #E8F5E9;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4CAF50;
  transition: all 0.2s ease;
}

.quick-action-btn:active {
  background-color: #C8E6C9;
  transform: scale(0.95);
}

.meal-type-picker {
  padding: 16rpx 0;
}

.picker-title {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.picker-wheel-container {
  background-color: #FAFAFA;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.meal-picker-view {
  height: 300rpx;
}

.picker-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.picker-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #212121;
}

.picker-confirm-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.picker-confirm-btn::after {
  border: none;
}

.feedback-input {
  padding: 16rpx 0;
}

.feedback-title {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.feedback-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid #EEEEEE;
  margin-bottom: 16rpx;
}

.feedback-submit-btn {
  width: 100%;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 36rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  border: none;
}

.feedback-submit-btn::after {
  border: none;
}

.user-info-form {
  padding: 16rpx 0;
}

.form-title {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.form-fields {
  margin-bottom: 24rpx;
}

.form-field {
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #616161;
  margin-bottom: 8rpx;
}

.field-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid #EEEEEE;
}

.field-picker {
  width: 100%;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  border: 2rpx solid #EEEEEE;
}

.picker-display text {
  font-size: 28rpx;
  color: #212121;
}

.picker-arrow {
  font-size: 20rpx;
  color: #9E9E9E;
}

.field-multi-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.multi-option {
  padding: 12rpx 24rpx;
  background-color: #FAFAFA;
  border-radius: 24rpx;
  border: 2rpx solid #EEEEEE;
  font-size: 26rpx;
  color: #616161;
  transition: all 0.2s ease;
}

.multi-selected {
  background-color: #E8F5E9;
  border-color: #4CAF50;
  color: #4CAF50;
}

.form-submit-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.form-submit-btn::after {
  border: none;
}

.daily-progress {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 240rpx;
  padding: 20rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #757575;
}

.progress-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #4CAF50;
}

.progress-bar {
  height: 12rpx;
  background-color: #EEEEEE;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-inner {
  height: 100%;
  background-color: #4CAF50;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.input-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 100rpx;
  background-color: #FFFFFF;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.input-wrapper {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.camera-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #E8F5E9;
  border-radius: 50%;
  margin-right: 16rpx;
}

.camera-icon-svg {
  width: 40rpx;
  height: 32rpx;
  position: relative;
}

.camera-body {
  width: 40rpx;
  height: 24rpx;
  background-color: #4CAF50;
  border-radius: 6rpx;
  position: absolute;
  bottom: 0;
}

.camera-lens {
  width: 16rpx;
  height: 16rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.message-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #FAFAFA;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background-color: #EEEEEE;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #BDBDBD;
  transition: all 0.2s ease;
}

.send-btn-active {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.send-btn-active:active {
  background-color: #43A047;
}

.message-animate-in {
  animation: slideInUp 0.4s ease-out;
}

.message-animate-out {
  animation: slideOutUp 0.3s ease-in;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideOutUp {
  from {
    opacity: 1;
    transform: translateY(0);
    max-height: 500rpx;
  }
  to {
    opacity: 0;
    transform: translateY(-20rpx);
    max-height: 0;
    padding: 0;
    margin: 0;
  }
}

.meal-type-select-container {
  padding: 16rpx 0;
}

.rating-select-container {
  padding: 16rpx 0;
}

.select-title {
  display: block;
  font-size: 28rpx;
  color: #212121;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.meal-type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meal-type-option {
  flex: 1;
  min-width: calc(50% - 6rpx);
  padding: 20rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  border: 2rpx solid #EEEEEE;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s ease;
}

.meal-type-selected {
  background-color: #E8F5E9;
  border-color: #4CAF50;
}

.meal-type-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.meal-type-text {
  font-size: 26rpx;
  color: #616161;
}

.meal-type-selected .meal-type-text {
  color: #4CAF50;
  font-weight: 500;
}

.rating-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rating-option {
  flex: 1;
  min-width: calc(33.33% - 8rpx);
  padding: 16rpx 12rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  border: 2rpx solid #EEEEEE;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s ease;
}

.rating-selected {
  background-color: #FFF9C4;
  border-color: #FFC107;
}

.rating-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #616161;
}

.rating-selected .rating-text {
  color: #F57C00;
  font-weight: 500;
}

.meal-type-collapsed,
.rating-collapsed,
.date-collapsed {
  padding: 12rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.collapsed-text {
  font-size: 24rpx;
  color: #757575;
}

.date-select-container {
  padding: 16rpx 0;
}

.date-picker-wrapper {
  margin-bottom: 16rpx;
}

.date-picker {
  width: 100%;
}

.date-picker-display {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  background-color: #E8F5E9;
  border-radius: 16rpx;
  border: 2rpx solid #4CAF50;
}

.date-picker-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.date-picker-value {
  font-size: 32rpx;
  color: #212121;
  font-weight: 500;
}

.date-picker-arrow {
  font-size: 20rpx;
  color: #4CAF50;
  margin-left: 12rpx;
}

.date-meal-type-hint {
  padding: 12rpx 16rpx;
  background-color: #FFF8E1;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.date-meal-type-hint text {
  font-size: 24rpx;
  color: #F57C00;
}

.date-confirm-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.date-confirm-btn::after {
  border: none;
}

.scroll-bottom-placeholder {
  height: 100rpx;
  width: 100%;
}
