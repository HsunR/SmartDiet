.onboarding-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #E8F5E9 0%, #FFFFFF 100%);
  padding: 80rpx 48rpx 48rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background-color: #E8F5E9;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-fill {
  height: 100%;
  background-color: #4CAF50;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.step-indicator {
  text-align: center;
  margin-bottom: 48rpx;
}

.step-text {
  font-size: 28rpx;
  color: #757575;
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #212121;
  margin-bottom: 16rpx;
  text-align: center;
}

.step-subtitle {
  font-size: 28rpx;
  color: #757575;
  text-align: center;
  margin-bottom: 64rpx;
}

.step-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.gender-selector {
  display: flex;
  justify-content: space-around;
  gap: 32rpx;
}

.gender-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 4rpx solid #EEEEEE;
  transition: all 0.3s ease;
}

.gender-selected {
  border-color: #4CAF50;
  background-color: #E8F5E9;
  transform: scale(1.05);
}

.gender-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.gender-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.number-input-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
}

.number-display {
  display: flex;
  align-items: baseline;
  margin-bottom: 64rpx;
}

.number-value {
  font-size: 120rpx;
  font-weight: 700;
  color: #4CAF50;
}

.number-unit {
  font-size: 32rpx;
  color: #757575;
  margin-left: 16rpx;
}

.number-slider {
  width: 100%;
  margin-bottom: 24rpx;
}

.slider-labels {
  width: 100%;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #BDBDBD;
}

.activity-selector,
.goal-selector {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-option,
.goal-option {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  border: 3rpx solid #EEEEEE;
  transition: all 0.3s ease;
}

.activity-selected,
.goal-selected {
  border-color: #4CAF50;
  background-color: #E8F5E9;
}

.activity-icon,
.goal-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.activity-info,
.goal-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.activity-label,
.goal-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #212121;
  margin-bottom: 8rpx;
}

.activity-desc,
.goal-desc {
  font-size: 24rpx;
  color: #757575;
}

.navigation-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.nav-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.nav-btn-secondary {
  background-color: #FFFFFF;
  color: #757575;
  border: 2rpx solid #E0E0E0;
}

.nav-btn-primary {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.nav-btn-full {
  flex: 1;
}

.nav-btn:active {
  transform: scale(0.98);
}
