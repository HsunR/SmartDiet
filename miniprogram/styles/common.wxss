@import './variables.wxss';

.btn {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-xl);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  transition: all 0.2s ease;
}

.btn-primary {
  background-color: var(--primary-color);
  color: var(--bg-card);
}

.btn-primary:active {
  background-color: var(--primary-dark);
}

.btn-secondary {
  background-color: var(--primary-bg-light);
  color: var(--primary-color);
}

.btn-secondary:active {
  background-color: var(--primary-bg-medium);
}

.btn-outline {
  background-color: transparent;
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
}

.btn-outline:active {
  background-color: var(--primary-bg-light);
}

.btn-disabled {
  background-color: var(--bg-divider);
  color: var(--text-disabled);
}

.btn-sm {
  padding: var(--spacing-sm) var(--spacing-lg);
  font-size: var(--font-size-base);
}

.btn-lg {
  padding: var(--spacing-lg) 64rpx;
  font-size: var(--font-size-lg);
}

.btn-block {
  width: 100%;
}

.card {
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-md);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--bg-divider);
  margin-bottom: var(--spacing-sm);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}

.card-body {
  padding: var(--spacing-sm) 0;
}

.card-footer {
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--bg-divider);
  margin-top: var(--spacing-sm);
}

.input {
  width: 100%;
  padding: var(--spacing-md);
  background-color: var(--bg-page);
  border-radius: 12rpx;
  font-size: var(--font-size-base);
  color: var(--text-primary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.input:focus {
  background-color: var(--bg-card);
  border-color: var(--primary-color);
}

.input-placeholder {
  color: var(--text-disabled);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
}

.tag-primary {
  background-color: var(--primary-bg-light);
  color: var(--primary-color);
}

.tag-warning {
  background-color: #FFF3E0;
  color: var(--warning-color);
}

.tag-error {
  background-color: #FFEBEE;
  color: var(--error-color);
}

.tag-success {
  background-color: var(--primary-bg-light);
  color: var(--success-color);
}

.badge {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 var(--spacing-xs);
  border-radius: var(--radius-full);
  background-color: var(--error-color);
  color: var(--bg-card);
  font-size: var(--font-size-xs);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar .avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-sm {
  width: 48rpx;
  height: 48rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
}

.divider {
  height: 1rpx;
  background-color: var(--bg-divider);
  margin: var(--spacing-md) 0;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-xl) var(--spacing-md);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--primary-bg-light);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx var(--spacing-xl);
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  text-align: center;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: var(--bg-divider);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.progress-bar-inner {
  height: 100%;
  border-radius: var(--radius-sm);
  transition: width 0.3s ease;
}

.progress-bar-primary .progress-bar-inner {
  background-color: var(--primary-color);
}

.progress-bar-warning .progress-bar-inner {
  background-color: var(--warning-color);
}

.progress-bar-error .progress-bar-inner {
  background-color: var(--error-color);
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  z-index: 1001;
  overflow: hidden;
}

.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: var(--spacing-md) var(--spacing-xl);
  background-color: rgba(0, 0, 0, 0.8);
  color: var(--bg-card);
  border-radius: 12rpx;
  font-size: var(--font-size-base);
  z-index: 2000;
}

.flex { display: flex; }
.flex-column { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.gap-sm { gap: var(--spacing-sm); }
.gap-md { gap: var(--spacing-md); }
.gap-lg { gap: var(--spacing-lg); }

.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-disabled { color: var(--text-disabled); }

.w-full { width: 100%; }
.h-full { height: 100%; }

.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
