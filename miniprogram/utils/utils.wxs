/**
 * WXS 工具模块 - 用于 WXML 模板中的数据处理
 * 注意：WXS 语法与普通 JS 不同，只能使用 WXS 支持的 API
 * @module utils/wxs
 * @version 1.0.0
 */

/**
 * 格式化时间戳为 HH:MM 格式
 * @param {number} timestamp - 时间戳（毫秒）
 * @returns {string} 格式化后的时间字符串
 */
var formatTime = function(timestamp) {
  if (!timestamp) {
    return ''
  }
  
  var date = getDate(timestamp)
  var hour = date.getHours()
  var minute = date.getMinutes()
  
  var hourStr = hour < 10 ? '0' + hour : hour
  var minuteStr = minute < 10 ? '0' + minute : minute
  
  return hourStr + ':' + minuteStr
}

/**
 * 重复字符串指定次数
 * @param {string} str - 要重复的字符串
 * @param {number} count - 重复次数
 * @returns {string} 重复后的字符串
 */
var repeat = function(str, count) {
  if (!str || count <= 0) {
    return ''
  }
  var result = ''
  for (var i = 0; i < count; i++) {
    result += str
  }
  return result
}

/**
 * 获取评分对应的星号字符串
 * @param {number} rating - 评分（0-5）
 * @returns {string} 星号字符串
 */
var getRatingStars = function(rating) {
  if (rating === 0) {
    return '❓'
  }
  return repeat('⭐', rating)
}

module.exports = {
  formatTime: formatTime,
  repeat: repeat,
  getRatingStars: getRatingStars
}
