<view class="nutrient-progress {{size}}">
  <view class="progress-header" wx:if="{{label}}">
    <text class="progress-label">{{label}}</text>
    <text class="progress-value" wx:if="{{showValue}}">{{current}}/{{target}}{{unit}}</text>
  </view>
  
  <view class="progress-bar">
    <view 
      class="progress-fill {{status}}" 
      style="width: {{percent}}%"
    ></view>
  </view>
  
  <view class="progress-percent" wx:if="{{showValue}}">
    <text>{{percent}}%</text>
  </view>
</view>
