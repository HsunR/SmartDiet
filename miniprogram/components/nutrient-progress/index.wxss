.nutrient-progress {
  width: 100%;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #757575;
}

.progress-value {
  font-size: 24rpx;
  color: #212121;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #EEEEEE;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-fill.success {
  background-color: #4CAF50;
}

.progress-fill.warning {
  background-color: #FF9800;
}

.progress-fill.error {
  background-color: #F44336;
}

.progress-fill.normal {
  background-color: #4CAF50;
}

.progress-percent {
  text-align: right;
  margin-top: 4rpx;
}

.progress-percent text {
  font-size: 22rpx;
  color: #757575;
}

.nutrient-progress.small .progress-bar {
  height: 8rpx;
}

.nutrient-progress.large .progress-bar {
  height: 24rpx;
}
