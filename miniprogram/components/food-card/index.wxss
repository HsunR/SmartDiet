.food-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #E8F5E9;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
}

.score-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  background-color: #FF9800;
}

.rating-badge {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  margin-left: 8rpx;
}

.rating-label {
  font-size: 20rpx;
  color: #757575;
}

.rating-value {
  font-size: 20rpx;
  color: #FF9800;
  font-weight: 600;
  margin-left: 4rpx;
}

.meal-overview {
  padding: 24rpx;
  background-color: #FAFAFA;
  border-bottom: 1rpx solid #EEEEEE;
}

.health-score-section {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

/* 圆环进度条容器 */
.score-circle-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 灰色背景圆环 */
.score-circle-bg {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #E8E8E8;
}

/* 橙色进度圆环 */
.score-circle-progress {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

/* 内部白色圆形 */
.score-inner {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 1;
}

.score-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #212121;
}

.score-label {
  font-size: 20rpx;
  color: #757575;
  margin-top: 4rpx;
}

.health-tags-section {
  margin-bottom: 16rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tag {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.tag-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
  font-weight: bold;
}

.tag-positive {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.tag-positive .tag-icon {
  color: #4CAF50;
}

.tag-warning {
  background-color: #FFF3E0;
  color: #E65100;
}

.tag-warning .tag-icon {
  color: #FF9800;
}

.meal-summary {
  font-size: 24rpx;
  color: #616161;
  line-height: 1.6;
  padding: 12rpx 16rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  border-left: 4rpx solid #4CAF50;
}

.food-list {
  padding: 16rpx;
}

.food-item {
  border-bottom: 1rpx solid #F5F5F5;
  transition: all 0.3s ease;
}

.food-item:last-child {
  border-bottom: none;
}

.food-main {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.food-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.food-info {
  flex: 1;
  min-width: 0;
}

.food-name {
  font-size: 28rpx;
  color: #212121;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.food-meta {
  display: flex;
  align-items: center;
}

.food-category {
  font-size: 22rpx;
  color: #757575;
  margin-right: 16rpx;
}

.food-weight {
  font-size: 22rpx;
  color: #BDBDBD;
}

.food-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.food-tag {
  display: flex;
  flex-direction: column;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 4rpx;
}

.food-tag.tag-positive {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.food-tag.tag-warning {
  background-color: #FFF3E0;
  color: #E65100;
}

.tag-label {
  font-weight: 500;
  font-size: 20rpx;
}

.tag-reason-text {
  font-size: 18rpx;
  color: #757575;
  margin-top: 2rpx;
  line-height: 1.4;
}

.tag-reason {
  font-size: 20rpx;
  color: #757575;
  margin-left: 8rpx;
  font-weight: 400;
}

.food-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nutrient-value {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

.food-advice {
  padding: 12rpx 16rpx;
  background-color: #FFF8E1;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx 16rpx;
}

.advice-text {
  font-size: 24rpx;
  color: #F57C00;
  line-height: 1.5;
}

.dietary-advice {
  padding: 20rpx 24rpx;
  background-color: #FFF8E1;
  border-top: 1rpx solid #FFE082;
}

.advice-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.advice-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.advice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #F57C00;
}

.advice-content {
  font-size: 24rpx;
  color: #616161;
  line-height: 1.6;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx 24rpx;
  background-color: #FFFFFF;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.edit-btn {
  background-color: #FFFFFF;
  border: 2rpx solid #4CAF50;
  color: #4CAF50;
}

.edit-btn-hover {
  background-color: #E8F5E9;
}

.confirm-btn {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.confirm-btn-hover {
  background-color: #43A047;
}

/* 骨架屏加载状态 */
.skeleton-overview {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.skeleton-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s infinite;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.skeleton-lines {
  flex: 1;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s infinite;
  margin-bottom: 16rpx;
}

.skeleton-line-long {
  width: 80%;
}

.skeleton-line-short {
  width: 50%;
}

@keyframes skeleton-pulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 食物列表骨架屏 */
.skeleton-food-list {
  padding: 8rpx 0;
}

.skeleton-food-row {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.skeleton-food-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s infinite;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.skeleton-food-info {
  flex: 1;
}

.skeleton-food-info .skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s infinite;
  margin-bottom: 12rpx;
}

.skeleton-food-info .skeleton-line:last-child {
  margin-bottom: 0;
}

.skeleton-food-info .skeleton-line-long {
  width: 70%;
}

.skeleton-food-info .skeleton-line-short {
  width: 45%;
}