.food-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #E8F5E9;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
}

.score-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.card-calories {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 600;
}

.meal-overview {
  padding: 24rpx;
  background-color: #FAFAFA;
  border-bottom: 1rpx solid #EEEEEE;
}

.health-score-section {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.score-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.score-inner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.score-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #212121;
}

.score-label {
  font-size: 20rpx;
  color: #757575;
  margin-top: 4rpx;
}

.health-tags-section {
  margin-bottom: 16rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tag {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.tag-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
  font-weight: bold;
}

.tag-positive {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.tag-positive .tag-icon {
  color: #4CAF50;
}

.tag-warning {
  background-color: #FFF3E0;
  color: #E65100;
}

.tag-warning .tag-icon {
  color: #FF9800;
}

.meal-summary {
  font-size: 24rpx;
  color: #616161;
  line-height: 1.6;
  padding: 12rpx 16rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  border-left: 4rpx solid #4CAF50;
}

.food-list {
  padding: 16rpx;
}

.food-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.food-item:last-child {
  border-bottom: none;
}

.food-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.food-info {
  flex: 1;
}

.food-name {
  font-size: 28rpx;
  color: #212121;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.food-meta {
  display: flex;
  align-items: center;
}

.food-category {
  font-size: 22rpx;
  color: #757575;
  margin-right: 16rpx;
}

.food-weight {
  font-size: 22rpx;
  color: #BDBDBD;
}

.food-nutrients {
  text-align: right;
}

.nutrient-value {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

.dietary-advice {
  padding: 20rpx 24rpx;
  background-color: #FFF8E1;
  border-top: 1rpx solid #FFECB3;
}

.advice-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.advice-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.advice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #F57C00;
}

.advice-content {
  font-size: 24rpx;
  color: #616161;
  line-height: 1.6;
}

.card-actions {
  display: flex;
  padding: 16rpx;
  border-top: 1rpx solid #EEEEEE;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  margin: 0 8rpx;
  padding: 0;
  border: none;
  line-height: 72rpx;
}

.action-btn::after {
  border: none;
}

.edit-btn {
  background-color: #F5F5F5;
  color: #757575;
}

.edit-btn-hover {
  background-color: #EEEEEE;
}

.confirm-btn {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.confirm-btn-hover {
  background-color: #43A047;
}
